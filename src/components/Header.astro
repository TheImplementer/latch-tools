---
import BrandMark from './BrandMark.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  enUrl?: string;
  esUrl?: string;
}
const { enUrl, esUrl } = Astro.props;
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="brand" href="/" aria-label="Latch home">
      <BrandMark />
      <span>Latch</span>
    </a>
    <nav class="nav" aria-label="Primary">
      <a class="nav-link" href="/redact-pdf/">Redact PDF</a>
      <a class="nav-link" href="/redact-image/">Redact image</a>
      <a class="nav-link" href="/#tools">All tools</a>
      {enUrl && esUrl && <LangSwitcher current="en" enUrl={enUrl} esUrl={esUrl} />}
    </nav>
  </div>
</header>
