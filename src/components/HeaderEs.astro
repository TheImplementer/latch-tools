---
import BrandMark from './BrandMark.astro';
import LangSwitcher from './LangSwitcher.astro';

interface Props {
  enUrl?: string;
  esUrl?: string;
}
const { enUrl, esUrl } = Astro.props;
---
<header class="hdr">
  <div class="wrap hdr-in">
    <a class="brand" href="/" aria-label="Latch inicio">
      <BrandMark />
      <span>Latch</span>
    </a>
    <nav class="nav" aria-label="Principal">
      {enUrl && esUrl && <LangSwitcher current="es" enUrl={enUrl} esUrl={esUrl} />}
    </nav>
  </div>
</header>
