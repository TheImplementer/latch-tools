---
// Shared shell for the PDF tools that have no canvas and nothing to draw on:
// drop a document, choose what to do with it, run, download.
//
// RedactWidget is the wrong home for these. Its whole middle is a region
// editor — stage canvas, filmstrip, undo/clear toolbar — and a tool with no
// drawing would ship all of that markup and CSS to render none of it. What the
// no-canvas tools actually share is the chrome *around* the work: intake, the
// password prompt for an encrypted file, a progress meter that can be stopped,
// the download panel and the error panel.
//
// The middle is a named slot rather than a pile of per-tool branches, because
// unlike RedactWidget's two modes (which share ~90% of their UI) these tools
// share none of it: flatten picks a mode, unlock takes a password to remove,
// password-protect sets one, remove-metadata reviews a table.
//
// Slot styling note: slotted nodes are composed at build time and carry the
// scope of the file that *authors* them, not this one. So a rule written here
// will not match them without :global — and a :global rule here would out-
// specify the author's own scoped rule, since Astro compiles scope attributes
// with :where() (zero specificity). Hence FlattenOptions.astro owns both its
// markup and its styles, and this file does not reach into the slot at all.
export interface Props {
  heading: string; // widget-header title
  tool: 'flatten'; // which controller boots this instance
  applyLabel: string; // primary button
  pillTo: string; // right-hand side of the format pill
  dropHint: string; // small print under the browse button
}
const { heading, tool, applyLabel, pillTo, dropHint } = Astro.props;
---

<div class="widget pdf-tool-widget" data-tool={tool} role="region" aria-label={heading}>
  <div class="widget-head">
    <span
      class="wt"
      style="font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:-.01em"
      data-el="widget-title"
    >
      {heading}
    </span>
    <span class="fmt-pill" aria-hidden="true">
      <span class="from">PDF</span>
      <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 5l4 4-4 4"></path></svg>
      <span class="to">{pillTo}</span>
    </span>
  </div>

  <!-- STATE: drop -->
  <div data-panel="drop" class="widget-state">
    <div class="dropzone" data-el="dropzone" role="button" tabindex="0" aria-label="Drop a PDF here or click to browse" aria-describedby="pdftool-dz-hint">
      <div class="dz-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5m0 0L8 9m4-4l4 4"></path><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path></svg>
      </div>
      <p class="dz-title" data-el="dz-title">Drag &amp; drop your PDF</p>
      <p class="dz-or" aria-hidden="true">or</p>
      <button class="btn btn-secondary" type="button" data-el="browse-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"></path></svg>
        Browse for a PDF
      </button>
      <p class="dz-hint" id="pdftool-dz-hint">{dropHint}</p>
    </div>
  </div>

  <!-- STATE: password — an encrypted PDF is an ordinary file, not an error -->
  <div data-panel="password" class="widget-state" hidden>
    <form class="pw" data-el="pw-form">
      <div class="pw-head">
        <span class="pw-badge" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2.2"></rect><path d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"></path></svg>
        </span>
        <div>
          <div class="pw-title">This PDF is locked</div>
          <p class="pw-msg" data-el="pw-message" aria-live="polite"></p>
        </div>
      </div>
      <label class="pw-label" for="pdftool-pw">Password</label>
      <input class="pw-input" id="pdftool-pw" data-el="pw-input" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" />
      <div class="actions">
        <button class="btn btn-ghost" type="button" data-el="pw-cancel">Start over</button>
        <button class="btn btn-primary grow" type="submit">Unlock</button>
      </div>
    </form>
  </div>

  <!-- STATE: options -->
  <div data-panel="options" class="widget-state" hidden>
    <div class="file-card">
      <figure class="file-thumb" data-el="file-thumb"></figure>
      <div class="file-meta">
        <div class="file-name" data-el="file-name"></div>
        <div class="file-sub" data-el="file-sub"></div>
      </div>
    </div>

    <slot name="options" />

    <p class="opt-note" data-el="options-note" aria-live="polite" hidden></p>

    <div class="actions">
      <button class="btn btn-ghost" type="button" data-el="try-another-btn">Start over</button>
      <button class="btn btn-primary grow" type="button" data-el="apply-btn">
        <span data-el="apply-label" data-base={applyLabel}>{applyLabel}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"></path><path d="M5 19h14"></path></svg>
      </button>
    </div>
  </div>

  <!-- STATE: processing -->
  <div data-panel="processing" class="widget-state" hidden>
    <div class="proc">
      <div class="proc-row">
        <div class="spinner" role="status" aria-label="Working"></div>
        <div>
          <div class="pt" data-el="proc-title">Working</div>
          <div class="ps" data-el="proc-sub"></div>
        </div>
      </div>
      <!-- Hidden for the steps that are one indivisible operation rather than a
           page loop — a meter that jumps 0 → 100 tells the user nothing. -->
      <div class="proc-meter" data-el="proc-meter" hidden>
        <div class="bar" aria-hidden="true"><i data-el="proc-fill" style="width:0%"></i></div>
        <div class="proc-pct" aria-live="polite">
          <span data-el="proc-count"></span>
          <span data-el="proc-pct">0%</span>
        </div>
      </div>
      <div class="proc-cancel-row" data-el="cancel-row" hidden>
        <button class="btn btn-ghost" type="button" data-el="cancel">Stop</button>
        <span class="proc-cancel-note">Stops after the current page. Nothing is saved, and your original is untouched.</span>
      </div>
    </div>
  </div>

  <!-- STATE: done -->
  <div data-panel="done" class="widget-state" hidden>
    <div class="result-head">
      <span class="result-badge" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
      </span>
      <div>
        <div class="rt" data-el="done-title">All done</div>
        <div class="rs" data-el="done-sub"></div>
      </div>
    </div>
    <figure class="result-preview" data-el="done-preview"></figure>
    <div class="actions">
      <button class="btn btn-secondary" type="button" data-el="another-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8M20 4v4h-4"></path></svg>
        Do another
      </button>
      <button class="btn btn-primary grow" type="button" data-el="download-btn">
        <span data-el="download-label">Download</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"></path><path d="M5 19h14"></path></svg>
      </button>
    </div>
  </div>

  <!-- STATE: error -->
  <div data-panel="error" class="widget-state" hidden>
    <div class="err-head">
      <span class="err-badge" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"></path><circle cx="12" cy="16.4" r=".4" fill="currentColor"></circle><path d="M10.3 4.2L3.4 16a2 2 0 0 0 1.7 3h13.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"></path></svg>
      </span>
      <div>
        <div class="et" data-el="err-title">Something went wrong</div>
        <div class="es" data-el="err-message"></div>
        <p class="help-text">Your original PDF has not been changed.</p>
      </div>
    </div>
    <div class="actions">
      <button class="btn btn-primary grow" type="button" data-el="try-another-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"></path></svg>
        Try another file
      </button>
    </div>
  </div>

  <input type="file" data-el="file-input" accept="application/pdf,.pdf" hidden aria-hidden="true" />
</div>

<style>
  /* The file we're about to work on: thumbnail, name, and what we found in it. */
  .file-card {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface-2);
  }
  .file-thumb {
    flex: 0 0 auto;
    width: 52px;
    height: 68px;
    margin: 0;
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border-strong);
  }
  /* The <img> is created by the controller, so it needs :global — Astro's
     scoping attribute only lands on server-rendered markup. */
  .file-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .file-meta {
    min-width: 0;
  }
  .file-name {
    font-weight: 600;
    font-size: 14px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .file-sub {
    margin-top: 3px;
    font-size: 12.5px;
    color: var(--text-2);
    font-family: var(--font-mono);
  }

  /* Why the run button is disabled, or why the last run did nothing. */
  .opt-note {
    margin: 14px 4px 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-2);
  }
  /* An explicit display would otherwise beat the UA [hidden] rule. */
  .opt-note[hidden] {
    display: none;
  }
</style>

<script>
  // An explicit switch with a literal specifier, not a template string. A
  // computed `import(\`../lib/${tool}\`)` would trigger Vite's dynamic-import-vars
  // transform, which globs the whole of ../lib/ — emitting a chunk for every
  // module in it (the ONNX detector included) and dragging their preload
  // metadata into this page's eager bundle.
  function boot() {
    document.querySelectorAll<HTMLElement>('.pdf-tool-widget').forEach(async (el) => {
      if (el.dataset.tool === 'flatten') {
        (await import('../lib/flattenPdf')).initFlattenPdfWidget(el);
      }
      // Listeners are attached now (see RedactWidget for why tests wait on it).
      el.dataset.ready = 'true';
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
