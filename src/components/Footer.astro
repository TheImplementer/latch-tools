---
import BrandMark from './BrandMark.astro';
---
<footer class="ftr">
  <div class="wrap ftr-in">
    <div>
      <a class="brand" href="/" style="font-size:17px">
        <BrandMark size={26} />
        <span>Latch</span>
      </a>
      <p>Private, browser-based file tools. Built to run entirely on your device — no uploads, no trackers, no nonsense.</p>
    </div>
    <div class="ftr-cols">
      <div class="ftr-col">
        <h5>Tools</h5>
        <a href="/heic-to-jpg">HEIC to JPG</a>
        <a href="/heic-to-png">HEIC to PNG</a>
        <a href="/png-to-jpg">PNG to JPG</a>
        <a href="/webp-to-png">WebP to PNG</a>
        <a href="/resize-image">Resize photo</a>
        <a href="/remove-exif">Remove metadata</a>
      </div>
      <div class="ftr-col">
        <h5>Latch</h5>
        <a href="/#how">How it works</a>
        <a href="/#privacy">Privacy</a>
        <a href="/about">About</a>
        <a href="/privacy-policy">Privacy policy</a>
      </div>
    </div>
  </div>
</footer>
