---
import BrandMark from './BrandMark.astro';
---
<footer class="ftr">
  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Latch home" style="font-size:17px">
          <BrandMark size={26} />
          <span>Latch</span>
        </a>
        <p>Redaction and file tools that run in your browser. The <a href="https://github.com/TheImplementer/latch-tools" rel="noopener">source code is on GitHub</a>, so you can check what they do.</p>
      </div>

      <div class="footer-column footer-column--tools">
        <h5>Convert</h5>
        <nav aria-label="Image conversion tools">
          <a href="/heic-to-jpg/">HEIC to JPG</a>
          <a href="/heic-to-png/">HEIC to PNG</a>
          <a href="/png-to-jpg/">PNG to JPG</a>
          <a href="/webp-to-png/">WebP to PNG</a>
          <a href="/webp-to-jpg/">WebP to JPG</a>
          <a href="/png-to-webp/">PNG to WebP</a>
          <a href="/jpg-to-webp/">JPG to WebP</a>
          <a href="/avif-to-jpg/">AVIF to JPG</a>
          <a href="/avif-to-png/">AVIF to PNG</a>
          <a href="/png-to-avif/">PNG to AVIF</a>
          <a href="/jpg-to-avif/">JPG to AVIF</a>
          <a href="/avif-to-webp/">AVIF to WebP</a>
          <a href="/webp-to-avif/">WebP to AVIF</a>
          <a href="/jxl-to-jpg/">JXL to JPG</a>
          <a href="/jxl-to-png/">JXL to PNG</a>
          <a href="/png-to-jxl/">PNG to JXL</a>
          <a href="/jpg-to-jxl/">JPG to JXL</a>
          <a href="/jfif-to-jpg/">JFIF to JPG</a>
          <a href="/jfif-to-png/">JFIF to PNG</a>
          <a href="/svg-to-jpg/">SVG to JPG</a>
          <a href="/svg-to-png/">SVG to PNG</a>
        </nav>
      </div>

      <div class="footer-column">
        <h5>Protect &amp; edit</h5>
        <nav aria-label="Privacy and editing tools">
          <a href="/remove-exif/">Remove metadata</a>
          <a href="/blur-image/">Blur image</a>
          <a href="/blur-face/">Blur face</a>
          <a href="/blur-license-plate/">Blur license plate</a>
          <a href="/pixelate-image/">Pixelate image</a>
          <a href="/redact-image/">Redact image</a>
          <a href="/redact-pdf/">Redact PDF</a>
          <a href="/redact-bank-statement/">Redact bank statement</a>
          <a href="/flatten-pdf/">Flatten PDF</a>
          <a href="/resize-image/">Resize photo</a>
          <a href="/image-to-base64/">Image to Base64</a>
          <a href="/base64-to-image/">Base64 to Image</a>
        </nav>
      </div>

      <div class="footer-column">
        <h5>Latch</h5>
        <nav aria-label="About Latch">
          <a href="/#how">How it works</a>
          <a href="/#redact">Redaction tools</a>
          <a href="/jpeg-xl/">JPEG XL</a>
          <a href="/unredact-pdf/">Can redaction be undone?</a>
          <a href="/unblur-license-plate/">Can blur be undone?</a>
          <a href="/about/">About</a>
          <a href="/privacy-policy/">Privacy policy</a>
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© 2026 Latch Tools</span>
      <nav class="footer-nav" aria-label="Legal">
        <a href="/privacy-policy/">Privacy policy</a>
        <a href="/about/">About</a>
      </nav>
    </div>
  </div>
</footer>
