<script>
  // The controller is a dynamic import so a page only downloads what it uses.
  // pdf.js, pdf-lib, the signature maker and the handwriting fonts are further
  // imports still, each behind the first action that needs it.
  function boot() {
    document.querySelectorAll<HTMLElement>('.sign-widget').forEach(async (el) => {
      (await import('../lib/pdfSign')).initPdfSignWidget(el);
      // Listeners are attached now. Tests wait on this: a file set before the
      // lazy import lands would go nowhere.
      el.dataset.ready = 'true';
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
