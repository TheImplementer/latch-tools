---
// The "sign a PDF" widget: drop a PDF, make a signature, drag it onto the pages,
// download the signed copy.
//
// It follows RedactWidget's shape on purpose (the same panels, the same
// `data-el` contract, the same focused-editor layout) so the two PDF editors
// feel like one product. The editing itself is different enough that it has its
// own component: the middle is a placement layer over a page preview
// (src/lib/placement.ts), not a box-drawing canvas, and there is a signature
// dialog. Controller: src/lib/pdfSign.ts, booted lazily by the script below.
export interface Props {
  heading: string; // widget-header title, e.g. "Sign this PDF"
  applyLabel: string; // primary button, e.g. "Sign & download"
}
const { heading, applyLabel } = Astro.props;

// Order matches SIGNATURE_FONTS in src/lib/signatureFonts.ts, which the
// controller loads only when the Type tab opens.
const STYLES = ['Flowing', 'Casual', 'Formal'];
---

<div class="widget sign-widget" role="region" aria-label={heading}>
  <div class="widget-head">
    <span
      class="wt"
      style="font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:-.01em"
      data-el="widget-title"
    >
      {heading}
    </span>
    <span class="fmt-pill" aria-hidden="true">
      <span class="from">PDF</span>
      <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 5l4 4-4 4"></path></svg>
      <span class="to">SIGNED</span>
    </span>
  </div>

  <!-- STATE: drop -->
  <div data-panel="drop" class="widget-state">
    <div class="dropzone" data-el="dropzone" role="button" tabindex="0" aria-label="Drop a PDF here or click to browse" aria-describedby="sign-dz-hint">
      <div class="dz-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5m0 0L8 9m4-4l4 4"></path><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path></svg>
      </div>
      <p class="dz-title" data-el="dz-title">Drag &amp; drop your PDF</p>
      <p class="dz-or" aria-hidden="true">or</p>
      <button class="btn btn-secondary" type="button" data-el="browse-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"></path></svg>
        Browse for a PDF
      </button>
      <p class="dz-hint" id="sign-dz-hint">Accepts PDF · up to 150 pages, 100 MB</p>
    </div>
  </div>

  <!-- STATE: password. Same markup and global styles as the redaction tools. -->
  <div data-panel="password" class="widget-state" hidden>
    <form class="pw" data-el="pw-form">
      <div class="pw-head">
        <span class="pw-badge" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2.2"></rect><path d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"></path></svg>
        </span>
        <div>
          <div class="pw-title">This PDF is locked</div>
          <p class="pw-msg" data-el="pw-message" aria-live="polite"></p>
        </div>
      </div>
      <label class="pw-label" for="sign-pw">Password</label>
      <input class="pw-input" id="sign-pw" data-el="pw-input" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" />
      <div class="actions">
        <button class="btn btn-ghost" type="button" data-el="pw-cancel">Start over</button>
        <button class="btn btn-primary grow" type="submit">Unlock</button>
      </div>
    </form>
  </div>

  <!-- STATE: restricted. The file opened, but its author turned editing off.
       A warning the user has to answer, not a refusal. -->
  <div data-panel="restricted" class="widget-state" hidden>
    <div class="pw">
      <div class="pw-head">
        <span class="pw-badge" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2.2"></rect><path d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"></path></svg>
        </span>
        <div>
          <div class="pw-title" id="sign-restricted-h">Editing is restricted</div>
          <p class="pw-msg" id="sign-restricted-msg" data-el="restricted-message">
            Whoever made this PDF set it so it can't be changed. Signing adds to the page, so your signed copy won't keep that restriction. Only continue if you're allowed to sign this document.
          </p>
        </div>
      </div>
      <div class="actions">
        <button class="btn btn-ghost" type="button" data-el="restricted-cancel">Start over</button>
        <button class="btn btn-primary grow" type="button" data-el="restricted-continue" aria-describedby="sign-restricted-msg">Continue to sign</button>
      </div>
    </div>
  </div>

  <!-- STATE: editor
       Two blocks so the focused layout (see .is-focus below) can put the page
       and the controls side by side; narrow screens stack them. -->
  <div data-panel="editor" class="widget-state" hidden>
    <div class="sign-main">
      <div class="sign-stage-wrap" data-el="stage-wrap">
        <canvas class="sign-stage" data-el="stage" role="img" aria-label="Preview of the page you are signing"></canvas>
        <div class="sign-overlay" data-el="overlay"></div>
      </div>
      <div class="filmstrip" data-el="filmstrip" role="group" aria-label="Pages in this document" hidden></div>
    </div>

    <div class="sign-side">
      <p class="sign-file" data-el="file-meta"></p>
      <p class="sign-hint" data-el="editor-hint" aria-live="polite"></p>
      <p class="sign-warn" data-el="cert-note" hidden>
        This PDF already carries a certificate-based digital signature. Saving a signed copy here rewrites the file, so that original signature won't validate any more.
      </p>

      <section class="sign-block sign-block--sig" aria-labelledby="sign-sig-h">
        <p class="sign-block-title" id="sign-sig-h">Your signature</p>
        <div class="sig-preview" data-el="sig-preview"></div>
        <div class="sig-buttons">
          <button class="btn btn-primary" type="button" data-el="create-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21c3-1 5-1.5 7-3.5L19 8.5a2.1 2.1 0 0 0-3-3L7 14.5C5 16.5 4.500 18.500 3 21z"></path><path d="M14 7l3 3"></path></svg>
            <span data-el="create-label">Create signature</span>
          </button>
          <button class="btn btn-secondary" type="button" data-el="add-sig-btn" disabled hidden>Add to page</button>
        </div>
      </section>

      <section class="sign-block sign-block--text" aria-labelledby="sign-text-h">
        <p class="sign-block-title" id="sign-text-h">Add text</p>
        <label class="sr-only" for="sign-text">Text to place on the page</label>
        <input class="pw-input sign-text" id="sign-text" data-el="text-input" type="text" maxlength="60" autocomplete="off" spellcheck="false" placeholder="Printed name, a note…" />
        <div class="sign-text-row">
          <button class="btn-icon-text" type="button" data-el="add-text-btn" disabled>Add text</button>
          <button class="btn-icon-text" type="button" data-el="date-btn">Add today's date</button>
        </div>
      </section>

      <div class="sign-toolbar">
        <button class="btn-icon-text" type="button" data-el="copy-all-btn" disabled hidden>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M4 16V6a2 2 0 0 1 2-2h10"></path></svg>
          Copy to all pages
        </button>
        <button class="btn-icon-text" type="button" data-el="remove-btn" disabled>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"></path></svg>
          Remove
        </button>
        <button class="btn-icon-text" type="button" data-el="clear-btn" disabled>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
          Clear page
        </button>
      </div>

      <div class="actions sign-actions">
        <button class="btn btn-ghost" type="button" data-el="try-another-btn">Start over</button>
        <button class="btn btn-primary grow" type="button" data-el="apply-btn" disabled>
          <span data-el="apply-label" data-base={applyLabel}>{applyLabel}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"></path><path d="M5 19h14"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- STATE: processing -->
  <div data-panel="processing" class="widget-state" hidden>
    <div class="proc">
      <div class="proc-row">
        <div class="spinner" role="status" aria-label="Working"></div>
        <div>
          <div class="pt" data-el="proc-title">Opening your PDF</div>
          <div class="ps" data-el="proc-sub">Reading the pages…</div>
        </div>
      </div>
    </div>
  </div>

  <!-- STATE: done -->
  <div data-panel="done" class="widget-state" hidden>
    <div class="result-head">
      <span class="result-badge" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
      </span>
      <div>
        <div class="rt" data-el="done-title">All done</div>
        <div class="rs" data-el="done-sub"></div>
      </div>
    </div>
    <figure class="result-preview" data-el="done-preview"></figure>
    <div class="actions">
      <button class="btn btn-secondary" type="button" data-el="another-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8M20 4v4h-4"></path></svg>
        Sign another
      </button>
      <button class="btn btn-ghost" type="button" data-el="keep-editing-btn">Keep editing</button>
      <button class="btn btn-primary grow" type="button" data-el="download-btn">
        <span data-el="download-label">Download</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"></path><path d="M5 19h14"></path></svg>
      </button>
    </div>
  </div>

  <!-- STATE: error -->
  <div data-panel="error" class="widget-state" hidden>
    <div class="err-head">
      <span class="err-badge" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"></path><circle cx="12" cy="16.4" r=".4" fill="currentColor"></circle><path d="M10.3 4.2L3.4 16a2 2 0 0 0 1.7 3h13.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"></path></svg>
      </span>
      <div>
        <div class="et" data-el="err-title">Something went wrong</div>
        <div class="es" data-el="err-message"></div>
        <p class="help-text">Your original PDF has not been changed.</p>
      </div>
    </div>
    <div class="actions">
      <button class="btn btn-primary grow" type="button" data-el="try-another-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"></path></svg>
        Try another file
      </button>
    </div>
  </div>

  <input type="file" data-el="file-input" accept="application/pdf,.pdf" hidden aria-hidden="true" />

  <!-- Signature maker. A native <dialog>: focus is trapped, Esc closes it and
       focus returns to the button that opened it. -->
  <dialog class="sg-dialog" data-el="sig-dialog" aria-labelledby="sg-dlg-title">
    <div class="sg-head">
      <p class="sg-title" id="sg-dlg-title">Create your signature</p>
      <button class="sg-x" type="button" data-el="sig-close" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>

    <fieldset class="sg-seg">
      <legend class="sr-only">How to make your signature</legend>
      <label class="seg"><input type="radio" name="sg-method" value="draw" checked /><span>Draw</span></label>
      <label class="seg"><input type="radio" name="sg-method" value="type" /><span>Type</span></label>
      <label class="seg"><input type="radio" name="sg-method" value="upload" /><span>Upload</span></label>
    </fieldset>

    <div class="sg-body">
      <div data-sg-panel="draw">
        <div class="sg-pad-wrap" data-el="pad-wrap">
          <canvas class="sg-pad" data-el="pad" role="img" aria-label="Signature drawing area. Draw with a mouse, pen or finger."></canvas>
          <span class="sg-pad-hint" aria-hidden="true">Sign here</span>
          <span class="sg-pad-line" aria-hidden="true"></span>
        </div>
        <div class="sg-pad-tools">
          <button class="btn-icon-text" type="button" data-el="pad-undo" disabled>Undo</button>
          <button class="btn-icon-text" type="button" data-el="pad-clear" disabled>Clear</button>
          <span class="sg-pad-note">Drawing needs a mouse, pen or touch. Choose Type or Upload to use the keyboard.</span>
        </div>
      </div>

      <div data-sg-panel="type" hidden>
        <label class="pw-label" for="sg-type">Your name</label>
        <input class="pw-input sg-type" id="sg-type" data-el="type-input" type="text" maxlength="40" autocomplete="off" spellcheck="false" placeholder="Type your name" />
        <fieldset class="sg-styles">
          <legend class="sr-only">Handwriting style</legend>
          {STYLES.map((label, i) => (
            <label class="sg-style" data-el="type-row">
              <input type="radio" name="sg-font" value={String(i)} checked={i === 0} />
              <span class="sg-style-body">
                <canvas aria-hidden="true" width="1" height="1"></canvas>
                <span class="sg-style-name">{label}</span>
              </span>
            </label>
          ))}
        </fieldset>
        <p class="help-text" data-el="type-note" hidden>The handwriting font couldn't be loaded, so a standard script font is used instead.</p>
      </div>

      <div data-sg-panel="upload" hidden>
        <p class="sg-upload-text">Choose a picture of your signature, ideally dark ink on white paper. PNG or JPG.</p>
        <div class="sg-upload-row">
          <button class="btn btn-secondary" type="button" data-el="upload-browse">Choose a picture</button>
          <label class="sg-check"><input type="checkbox" data-el="upload-bg" checked /> Remove white background</label>
        </div>
        <div class="sg-upload-preview" data-el="upload-preview"></div>
        <p class="help-text" data-el="upload-name"></p>
        <input type="file" data-el="upload-input" accept="image/png,image/jpeg,.png,.jpg,.jpeg" hidden aria-hidden="true" />
      </div>

      <div class="sg-ink" data-el="ink-row">
        <span class="sg-ink-label" id="sg-ink-l">Ink</span>
        <div class="sg-ink-opts" role="radiogroup" aria-labelledby="sg-ink-l">
          <label class="sg-ink-opt"><input type="radio" name="sg-ink" value="black" checked /><span class="dot dot-black"></span>Black</label>
          <label class="sg-ink-opt"><input type="radio" name="sg-ink" value="blue" /><span class="dot dot-blue"></span>Blue</label>
        </div>
      </div>
      <p class="sg-message" data-el="sig-message" role="alert" hidden></p>
    </div>

    <div class="sg-foot">
      <button class="btn btn-ghost" type="button" data-el="sig-cancel">Cancel</button>
      <button class="btn btn-primary" type="button" data-el="sig-use" disabled>Use signature</button>
    </div>
  </dialog>
</div>

<style>
  /* Panel chrome shared with the other PDF widgets (.widget-state[hidden],
     .proc*, .pw-input, .result-*, .err-*, .actions) lives in global.css.
     Everything below mirrors the redaction editor's layout, renamed so the two
     components can't affect each other. */

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---- Page stage ---- */
  .sign-stage-wrap {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface-2);
    padding: 10px;
    display: flex;
    justify-content: center;
    background-image:
      linear-gradient(45deg, var(--surface-3) 25%, transparent 25%),
      linear-gradient(-45deg, var(--surface-3) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--surface-3) 75%),
      linear-gradient(-45deg, transparent 75%, var(--surface-3) 75%);
    background-size: 18px 18px;
    background-position:
      0 0,
      0 9px,
      9px -9px,
      -9px 0;
  }
  /* Sized by its own aspect ratio inside both limits, so the element box is the
     picture. JS still measures the painted area, in case a browser letterboxes. */
  .sign-stage {
    display: block;
    width: auto;
    max-width: 100%;
    min-width: 0;
    height: auto;
    max-height: 460px;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 0 0 1px var(--border-strong);
    background: #fff;
  }
  /* Laid over the painted page by placement.ts. It ignores the pointer except
     on its items, so a finger on empty page still scrolls the screen. */
  .sign-overlay {
    position: absolute;
    pointer-events: none;
  }
  .sign-overlay :global(.sg-item) {
    scroll-margin: 90px 0 110px;
    position: absolute;
    pointer-events: auto;
    touch-action: none;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
    outline: 1px dashed transparent;
    outline-offset: 2px;
  }
  .sign-overlay :global(.sg-item:hover) {
    outline-color: var(--accent);
  }
  .sign-overlay :global(.sg-item.is-selected) {
    outline: 2px solid var(--accent);
    cursor: move;
    z-index: 2;
  }
  .sign-overlay :global(.sg-item:focus-visible) {
    outline: 2px solid var(--accent);
    box-shadow: 0 0 0 5px var(--ring);
  }
  .sign-overlay :global(.sg-item img) {
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    -webkit-user-drag: none;
  }
  .sign-overlay :global(.sg-handle) {
    display: none;
    position: absolute;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid #fff;
    box-sizing: border-box;
  }
  /* The drawn dot is small; the part that takes a pointer is not. */
  .sign-overlay :global(.sg-handle)::before {
    content: '';
    position: absolute;
    inset: -12px;
  }
  .sign-overlay :global(.sg-item.is-selected .sg-handle) {
    display: block;
  }
  .sign-overlay :global(.sg-nw) {
    left: -7px;
    top: -7px;
    cursor: nwse-resize;
  }
  .sign-overlay :global(.sg-ne) {
    right: -7px;
    top: -7px;
    cursor: nesw-resize;
  }
  .sign-overlay :global(.sg-se) {
    right: -7px;
    bottom: -7px;
    cursor: nwse-resize;
  }
  .sign-overlay :global(.sg-sw) {
    left: -7px;
    bottom: -7px;
    cursor: nesw-resize;
  }
  @media (pointer: coarse) {
    .sign-overlay :global(.sg-handle) {
      width: 18px;
      height: 18px;
    }
    .sign-overlay :global(.sg-nw) {
      left: -10px;
      top: -10px;
    }
    .sign-overlay :global(.sg-ne) {
      right: -10px;
      top: -10px;
    }
    .sign-overlay :global(.sg-se) {
      right: -10px;
      bottom: -10px;
    }
    .sign-overlay :global(.sg-sw) {
      left: -10px;
      bottom: -10px;
    }
    .sign-overlay :global(.sg-handle)::before {
      inset: -14px;
    }
  }
  .sign-overlay :global(.sg-del) {
    display: none;
    position: absolute;
    left: 50%;
    top: -40px;
    transform: translateX(-50%);
    width: 28px;
    height: 28px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 2px solid #fff;
    background: var(--danger);
    color: #fff;
    cursor: pointer;
  }
  /* Clear of the item itself, so a press on the picture can never land on it. */
  .sign-overlay :global(.sg-del)::before {
    content: '';
    position: absolute;
    inset: -8px;
  }
  .sign-overlay :global(.sg-item[data-near-top='1'] .sg-del) {
    top: auto;
    bottom: -40px;
  }
  .sign-overlay :global(.sg-item.is-selected .sg-del) {
    display: flex;
  }

  /* ---- Side panel ---- */
  .sign-file {
    margin: 14px 4px 0;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-3);
    overflow-wrap: anywhere;
  }
  .sign-hint {
    font-size: 13px;
    color: var(--text-2);
    margin: 8px 4px 0;
    min-height: 2.6em;
    line-height: 1.45;
  }
  .sign-warn {
    margin: 10px 4px 0;
    padding: 10px 12px;
    border-radius: var(--r-sm);
    background: var(--danger-soft);
    color: var(--text);
    font-size: 13px;
    line-height: 1.45;
  }
  .sign-warn[hidden] {
    display: none;
  }
  .sign-block {
    margin: 14px 4px 0;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .sign-block-title {
    margin: 0 0 10px;
    font-size: 13.5px;
    font-weight: 600;
