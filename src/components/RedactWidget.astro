---
// Shared redaction widget — the interactive drop → draw-regions → download
// experience.
//
// Two modes share this markup because they share the interaction: drop a file,
// drag boxes over what to hide, export with the boxes baked into the pixels.
// `image` runs src/lib/redact.ts over a queue of image files; `pdf` runs
// src/lib/pdfRedact.ts over the pages of one document. Both drive the same
// [data-el] contract and both delegate the drawing to src/lib/regions.ts.
export interface Props {
  heading: string; // widget-header title, e.g. "Blur a face"
  defaultEffect: 'blur' | 'pixelate' | 'blackout';
  applyLabel: string; // primary button, e.g. "Blur & download"
  // Opt a page into on-device auto-detection. Omitted on the generic effect
  // pages: the detector is what makes blur-face and blur-license-plate
  // genuinely different tools rather than the same widget with new copy.
  detect?: 'face' | 'plate' | null;
  // 'pdf' swaps the file queue for a page queue: one document in, one document
  // out, with a page strip, a DPI control and a password prompt.
  mode?: 'image' | 'pdf';
}
const { heading, defaultEffect, applyLabel, detect = null, mode = 'image' } = Astro.props;
const isPdf = mode === 'pdf';
const detectLabel = detect === 'plate' ? 'Find plates' : 'Find faces';
const detectNoun = detect === 'plate' ? 'plates' : 'faces';
const PILL: Record<string, string> = { blur: 'BLURRED', pixelate: 'PIXELATED', blackout: 'REDACTED' };
const pillTo = PILL[defaultEffect] ?? 'BLURRED';

// This tool does one effect; link to the other two canonical effect tools.
const EFFECT_TOOLS = {
  blur: { label: 'Blur', href: '/blur-image/' },
  pixelate: { label: 'Pixelate', href: '/pixelate-image/' },
  blackout: { label: 'Black out', href: '/redact-image/' },
} as const;
const otherEffects = (['blur', 'pixelate', 'blackout'] as const).filter((e) => e !== defaultEffect).map((e) => EFFECT_TOOLS[e]);
// Strength is meaningless for a solid bar, so that slot carries output DPI on
// the PDF tool and nothing at all on /redact-image/.
const showStrength = !isPdf && defaultEffect !== 'blackout';
const noun = isPdf ? 'PDF' : 'images';
---

<div class="widget redact-widget" data-mode={mode} data-default-effect={defaultEffect} data-detect={detect ?? undefined} data-detect-noun={detect ? detectNoun : undefined} role="region" aria-label={heading}>
  <div class="widget-head">
    <span
      class="wt"
      style="font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:-.01em"
      data-el="widget-title"
    >
      {heading}
    </span>
    <span class="fmt-pill" aria-hidden="true">
      <span class="from">{isPdf ? 'PDF' : 'IMG'}</span>
      <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 5l4 4-4 4"></path></svg>
      <span class="to" data-el="pill-to">{pillTo}</span>
    </span>
  </div>

  <!-- STATE: drop -->
  <div data-panel="drop" class="widget-state">
    <div class="dropzone" data-el="dropzone" role="button" tabindex="0" aria-label={isPdf ? 'Drop a PDF here or click to browse' : 'Drop images here or click to browse'} aria-describedby="redact-dz-hint">
      <div class="dz-icon" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5m0 0L8 9m4-4l4 4"></path><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"></path></svg>
      </div>
      <p class="dz-title" data-el="dz-title">Drag &amp; drop your {noun}</p>
      <p class="dz-or" aria-hidden="true">or</p>
      <button class="btn btn-secondary" type="button" data-el="browse-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"></path></svg>
        {isPdf ? 'Browse for a PDF' : 'Browse files'}
      </button>
      <p class="dz-hint" id="redact-dz-hint">{isPdf ? 'Accepts PDF · up to 150 pages, 100 MB' : 'Accepts JPEG, PNG, WebP · up to 30 images at once, 50 MB each'}</p>
    </div>
  </div>

  {isPdf && (
    <!-- STATE: password — an encrypted PDF is an ordinary file, not an error -->
    <div data-panel="password" class="widget-state" hidden>
      <form class="pw" data-el="pw-form">
        <div class="pw-head">
          <span class="pw-badge" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10.5" width="16" height="10" rx="2.2"></rect><path d="M8 10.5V7.6a4 4 0 0 1 8 0v2.9"></path></svg>
          </span>
          <div>
            <div class="pw-title">This PDF is locked</div>
            <p class="pw-msg" data-el="pw-message" aria-live="polite"></p>
          </div>
        </div>
        <label class="pw-label" for="redact-pw">Password</label>
        <input class="pw-input" id="redact-pw" data-el="pw-input" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" />
        <div class="actions">
          <button class="btn btn-ghost" type="button" data-el="pw-cancel">Start over</button>
          <button class="btn btn-primary grow" type="submit">Unlock</button>
        </div>
      </form>
    </div>
  )}

  <!-- STATE: editor -->
  <div data-panel="editor" class="widget-state" hidden>
    <div class="redact-stage-wrap">
      <canvas class="redact-stage" data-el="stage" tabindex="0" role="application" aria-label="Redaction editor. Drag to draw a box over an area to hide. Use arrow keys to nudge the selected box and Delete to remove it."></canvas>
    </div>
    <div class="filmstrip" data-el="filmstrip" role="group" aria-label={isPdf ? 'Pages in this document' : 'Images in this batch'} hidden>
      {!isPdf && (
        <button class="strip-add" type="button" data-el="strip-add" aria-label="Add more images">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
        </button>
      )}
    </div>
    <p class="redact-hint" data-el="editor-hint" aria-live="polite"></p>
    <div class="redact-toolbar">
      {showStrength && (
        <div class="opt" data-el="strength-row">
          <label for="redact-strength">Strength</label>
          <input class="slider" type="range" id="redact-strength" data-el="strength" min="1" max="5" step="1" value="3" aria-label="Redaction strength, 1 to 5" />
        </div>
      )}
      {isPdf && (
        <div class="opt" data-el="quality-row">
          <label for="redact-quality">Quality</label>
          <select class="qsel" id="redact-quality" data-el="quality">
            <option value="standard" selected>Standard · 150 DPI</option>
            <option value="high">High · 300 DPI</option>
          </select>
        </div>
      )}
      <div class="redact-tool-actions">
        {detect && (
          <button class="btn-icon-text is-detect" type="button" data-el="detect-btn" disabled hidden>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3"></path><path d="M16 3h3a2 2 0 0 1 2 2v3"></path><path d="M21 16v3a2 2 0 0 1-2 2h-3"></path><path d="M8 21H5a2 2 0 0 1-2-2v-3"></path><circle cx="12" cy="12" r="3.2"></circle></svg>
            <span class="detect-spin" data-el="detect-spin" hidden aria-hidden="true"></span>
            <span data-el="detect-label" data-base={detectLabel}>{detectLabel}</span>
          </button>
        )}
        <button class="btn-icon-text" type="button" data-el="apply-all-btn" disabled hidden>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M4 16V6a2 2 0 0 1 2-2h10"></path></svg>
          {isPdf ? 'Copy boxes to all pages' : 'Copy boxes to all'}
        </button>
        <button class="btn-icon-text" type="button" data-el="undo-btn" disabled>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14L4 9l5-5"></path><path d="M4 9h11a5 5 0 0 1 0 10h-1"></path></svg>
          Undo
        </button>
        <button class="btn-icon-text" type="button" data-el="clear-btn" disabled>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19"></path></svg>
          Clear
        </button>
      </div>
    </div>
    <p class="redact-switch">
      {isPdf ? (
        <Fragment>Redacting a photo or a screenshot instead? <a href="/redact-image/">Redact an image</a></Fragment>
      ) : (
        <Fragment>
          Need a different effect?
          {otherEffects.map((t, i) => (
            <Fragment>{i > 0 && <span aria-hidden="true"> · </span>}<a href={t.href}>{t.label}</a></Fragment>
          ))}
        </Fragment>
      )}
    </p>
    <div class="actions">
      <button class="btn btn-ghost" type="button" data-el="try-another-btn">Start over</button>
      <button class="btn btn-primary grow" type="button" data-el="apply-btn" disabled>
        <span data-el="apply-label" data-base={applyLabel}>{applyLabel}</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"></path><path d="M5 19h14"></path></svg>
      </button>
    </div>
  </div>

  <!-- STATE: processing -->
  <div data-panel="processing" class="widget-state" hidden>
    <div class="proc">
      <div class="proc-row">
        <div class="spinner" role="status" aria-label="Working"></div>
        <div>
          <div class="pt" data-el="proc-title">Rendering your image</div>
          <div class="ps" data-el="proc-sub">Baking the effect in at full resolution</div>
        </div>
      </div>
      <div class="proc-meter" data-el="proc-meter" hidden>
        <div class="bar" aria-hidden="true"><i data-el="proc-fill" style="width:0%"></i></div>
        <div class="proc-pct" aria-live="polite">
          <span data-el="proc-count"></span>
          <span data-el="proc-pct">0%</span>
        </div>
      </div>
      {(detect || isPdf) && (
        <div class="proc-cancel-row" data-el="cancel-row" hidden>
          <button class="btn btn-ghost" type="button" data-el="cancel">{isPdf ? 'Stop' : 'Stop scanning'}</button>
          <span class="proc-cancel-note">
            {isPdf
              ? 'Stops after the current page. Nothing is exported, and every box you drew is kept.'
              : "Finishes the image it's on, then stops. Boxes already found are kept."}
          </span>
        </div>
      )}
    </div>
  </div>

  <!-- STATE: done -->
  <div data-panel="done" class="widget-state" hidden>
    <div class="result-head">
      <span class="result-badge" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>
      </span>
      <div>
        <div class="rt" data-el="done-title">All done</div>
        <div class="rs" data-el="done-sub"></div>
      </div>
    </div>
    <figure class="result-preview" data-el="done-preview"></figure>
    <div class="actions">
      <button class="btn btn-secondary" type="button" data-el="another-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8M20 4v4h-4"></path></svg>
        Do another
      </button>
      <button class="btn btn-primary grow" type="button" data-el="download-btn">
        <span data-el="download-label">Download</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"></path><path d="M5 19h14"></path></svg>
      </button>
    </div>
  </div>

  <!-- STATE: error -->
  <div data-panel="error" class="widget-state" hidden>
    <div class="err-head">
      <span class="err-badge" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"></path><circle cx="12" cy="16.4" r=".4" fill="currentColor"></circle><path d="M10.3 4.2L3.4 16a2 2 0 0 0 1.7 3h13.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"></path></svg>
      </span>
      <div>
        <div class="et" data-el="err-title">Something went wrong</div>
        <div class="es" data-el="err-message"></div>
        <p class="help-text">{isPdf ? 'Your original PDF has not been changed.' : 'The original image has not been changed.'}</p>
      </div>
    </div>
    <div class="actions">
      <button class="btn btn-primary grow" type="button" data-el="try-another-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"></path></svg>
        Try another file
      </button>
    </div>
  </div>

  <input type="file" data-el="file-input" accept={isPdf ? 'application/pdf,.pdf' : 'image/*'} multiple={!isPdf} hidden aria-hidden="true" />
</div>

<style>
  .widget-state[hidden] {
    display: none;
  }

  .redact-stage-wrap {
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface-2);
    padding: 10px;
    display: flex;
    justify-content: center;
    /* Checkerboard hints at "canvas" and shows transparency for PNGs. */
    background-image:
      linear-gradient(45deg, var(--surface-3) 25%, transparent 25%),
      linear-gradient(-45deg, var(--surface-3) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, var(--surface-3) 75%),
      linear-gradient(-45deg, transparent 75%, var(--surface-3) 75%);
    background-size: 18px 18px;
    background-position:
      0 0,
      0 9px,
      9px -9px,
      -9px 0;
  }
  .redact-stage {
    display: block;
    width: 100%;
    height: auto;
    max-height: 460px;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 0 0 1px var(--border-strong);
    touch-action: none; /* let pointer drags draw instead of scrolling */
    cursor: crosshair;
    background: var(--surface);
  }
  .redact-stage:focus-visible {
    box-shadow:
      0 0 0 1px var(--border-strong),
      0 0 0 3px var(--ring);
  }

  .redact-hint {
    font-size: 13px;
    color: var(--text-2);
    margin: 12px 4px 0;
    min-height: 2.6em;
    line-height: 1.45;
  }

  .redact-toolbar {
    display: flex;
    align-items: center;
    gap: 18px 22px;
    flex-wrap: wrap;
    padding: 14px 4px 2px;
  }
  .redact-tool-actions {
    display: flex;
    gap: 4px;
    margin-left: auto;
    /* On a detector page in batch mode this row holds four buttons, which
       overflows the widget column on a phone. The outer .redact-toolbar wraps;
       this inner group has to as well. */
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  /* Auto-detect reads as the suggested next step, so it carries the accent
     while undo/clear stay quiet. Deliberately sets no `display` — that lets it
     inherit the .btn-icon-text[hidden] rule below instead of needing its own. */
  .btn-icon-text.is-detect {
    color: var(--accent-text);
  }
  .btn-icon-text.is-detect:hover:not(:disabled) {
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .detect-spin {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid currentColor;
    border-top-color: transparent;
    animation: detect-spin 0.7s linear infinite;
  }
  .detect-spin[hidden] {
    display: none;
  }
  @keyframes detect-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .btn-icon-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 12px;
    border-radius: var(--r-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-2);
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .btn-icon-text:hover:not(:disabled) {
    background: var(--surface-2);
    color: var(--text);
  }
  .btn-icon-text:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  /* An explicit display would otherwise beat the UA [hidden] rule. */
  .btn-icon-text[hidden] {
    display: none;
  }
  .btn-icon-text:focus-visible {
    box-shadow: 0 0 0 3px var(--ring);
  }

  /* Switch-effect cross-links (this tool is single-effect) */
  .redact-switch {
    margin: 12px 4px 0;
    font-size: 13px;
    color: var(--text-3);
  }
  .redact-switch a {
    color: var(--accent-text);
    font-weight: 600;
  }
  .redact-switch a:hover {
    text-decoration: underline;
  }

  /* Batch filmstrip — only rendered when more than one image is queued. */
  .filmstrip {
    display: flex;
    gap: 8px;
    align-items: center;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    padding: 12px 2px 4px;
    scrollbar-width: thin;
  }
  .filmstrip[hidden] {
    display: none;
  }
  .filmstrip :global(.strip-item) {
    position: relative;
    flex: 0 0 auto;
    width: 58px;
    height: 58px;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface-2);
    cursor: pointer;
    overflow: hidden;
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .filmstrip :global(.strip-item img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .filmstrip :global(.strip-item:hover) {
    border-color: var(--border-strong);
  }
  .filmstrip :global(.strip-item.is-active) {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
  }
  .filmstrip :global(.strip-item:focus-visible) {
    outline: none;
    box-shadow: 0 0 0 3px var(--ring);
  }
  /* Page number, bottom-left. JS-created like the thumbnails themselves, so it
     needs :global — Astro's scoping attribute is only on server-rendered
     markup and an unqualified rule here would match nothing. */
  .filmstrip :global(.strip-page) {
    position: absolute;
    left: 3px;
    bottom: 3px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    line-height: 17px;
    text-align: center;
  }
  .filmstrip :global(.strip-badge) {
    position: absolute;
    right: 3px;
    bottom: 3px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: var(--r-pill);
    background: var(--accent);
    color: var(--button-text);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    line-height: 17px;
    text-align: center;
  }
  .strip-add {
    flex: 0 0 auto;
    width: 58px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r-sm);
    background: transparent;
    color: var(--text-3);
    cursor: pointer;
    transition:
      color 0.15s,
      border-color 0.15s;
  }
  .strip-add:hover {
    color: var(--accent-text);
    border-color: var(--accent);
  }
  .strip-add:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--ring);
  }

  /* Output DPI, in the slot the strength slider occupies on the blur pages. */
  .qsel {
    height: 32px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 13px;
    cursor: pointer;
  }
  .qsel:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px var(--ring);
  }

  /* Password prompt for an encrypted PDF. */
  .pw {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .pw-head {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    margin-bottom: 4px;
  }
  .pw-badge {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--text-2);
  }
  .pw-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .pw-msg {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-2);
    min-height: 2.6em;
  }
  .pw-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-2);
  }
  .pw-input {
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 14px;
  }
  .pw-input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--ring);
  }

  .proc-meter {
    margin-top: 16px;
  }
  .proc-meter[hidden] {
    display: none;
  }
  .proc-cancel-row {
    display: flex;
    align-items: center;
