    cursor: not-allowed;
  }
</style>

<script>
  // Both controllers are dynamic imports so a page only downloads the one it
  // uses — the PDF page never ships the image queue, the five image pages never
  // ship the PDF one, and each page's eager script stays tiny.
  function boot() {
    document.querySelectorAll<HTMLElement>('.redact-widget').forEach(async (el) => {
      if (el.dataset.mode === 'pdf') {
        (await import('../lib/pdfRedact')).initPdfRedactWidget(el);
      } else {
        (await import('../lib/redact')).initRedactWidget(el);
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
