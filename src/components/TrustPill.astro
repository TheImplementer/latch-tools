---
interface Props {
  variant?: 'default' | 'inline' | 'soft';
  lead?: string;
  text?: string;
}
const { variant = 'default', lead, text = 'Your files never leave this device' } = Astro.props;
const cls = ['trust', variant === 'inline' ? 'trust--inline' : ''].filter(Boolean).join(' ');
---
<span class={cls}>
  <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9 2l5.5 2v3.8c0 3.6-2.3 6-5.5 7.2-3.2-1.2-5.5-3.6-5.5-7.2V4z"/>
    <path d="m6.5 9 1.6 1.6 3.4-3.5"/>
  </svg>
  <span>{lead && <strong>{lead}{' '}</strong>}{text}</span>
</span>
