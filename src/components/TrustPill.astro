---
interface Props {
  variant?: 'default' | 'inline' | 'soft';
  text?: string;
}
const { variant = 'default', text = 'Your files never leave this device' } = Astro.props;
const cls = ['trust', variant === 'inline' ? 'trust--inline' : '', variant === 'soft' ? 'trust--soft' : ''].filter(Boolean).join(' ');
---
<span class={cls}>
  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="7" width="10" height="6.5" rx="1.6"/>
    <path d="M5 7V5a3 3 0 0 1 6 0v2"/>
  </svg>
  {text}
</span>
