---
import Layout from '../layouts/Layout.astro';
import Header from '../components/HeaderEs.astro';
import Footer from '../components/FooterEs.astro';
import TrustPill from '../components/TrustPill.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "WebP a PNG", "item": "https://latchtools.com/webp-a-png/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Convertidor de WebP a PNG",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Convierte imágenes WebP a formato PNG directamente en tu navegador. Se conserva la transparencia. Sin subir nada: tus archivos nunca salen de tu dispositivo.",
      "url": "https://latchtools.com/webp-a-png/"
    },
    {
      "@type": "HowTo",
      "name": "Cómo convertir WebP a PNG",
      "step": [
        { "@type": "HowToStep", "name": "Añade tus archivos WebP", "text": "Arrastra las imágenes WebP al área de carga o haz clic en Seleccionar para elegirlas desde tu dispositivo." },
        { "@type": "HowToStep", "name": "La conversión ocurre en tu dispositivo", "text": "Latch decodifica cada WebP y lo vuelve a codificar como un PNG sin pérdida usando tu navegador: al instante y sin conexión." },
        { "@type": "HowToStep", "name": "Se conserva la transparencia", "text": "Las zonas transparentes de tus archivos WebP se mantienen intactas en el PNG resultante." },
        { "@type": "HowToStep", "name": "Descarga tus PNG", "text": "Guárdalos uno a uno o descárgalos todos de una vez en un único archivo zip." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "¿Se suben mis imágenes a algún servidor?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Tu navegador realiza toda la conversión de forma local. No se envía nada a ningún servidor; la herramienta funciona incluso con el Wi-Fi apagado." }
        },
        {
          "@type": "Question",
          "name": "¿Se pierde calidad al convertir de WebP a PNG?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. PNG es un formato sin pérdida. El PNG resultante es una copia idéntica, píxel a píxel, de tu imagen WebP: no se descarta nada." }
        },
        {
          "@type": "Question",
          "name": "¿Se conserva la transparencia?",
          "acceptedAnswer": { "@type": "Answer", "text": "Sí. Tanto WebP como PNG admiten transparencia (canal alfa). La conversión mantiene cada píxel transparente exactamente como estaba." }
        },
        {
          "@type": "Question",
          "name": "¿Por qué convertir de WebP a PNG?",
          "acceptedAnswer": { "@type": "Answer", "text": "PNG tiene compatibilidad casi universal: funciona en cualquier programa de diseño, editor de fotos y aplicación de documentos. WebP es ideal para la web, pero algunos programas antiguos aún no lo admiten." }
        },
        {
          "@type": "Question",
          "name": "¿Hay un límite de tamaño o de número de archivos?",
          "acceptedAnswer": { "@type": "Answer", "text": "Puedes convertir hasta 10 imágenes a la vez. El límite real es la memoria disponible de tu dispositivo, no un tope arbitrario." }
        },
        {
          "@type": "Question",
          "name": "¿Cómo convierto un archivo WebP a PNG?",
          "acceptedAnswer": { "@type": "Answer", "text": "Arrastra tus archivos WebP al área de carga o haz clic en Seleccionar y pulsa Convertir a PNG. Latch transforma cada WebP en un PNG dentro de tu navegador y te permite descargarlos de uno en uno o en un único zip: convierte un solo archivo o varios a la vez." }
        }
      ]
    }
  ]
};
---
<Layout
  lang="es"
  title="Convertidor WebP a PNG — Gratis, conserva la transparencia · Latch Tools"
  description="Convierte imágenes WebP a PNG en tu navegador. Se conserva la transparencia. Sin subir archivos ni registro: tus archivos nunca salen de tu dispositivo."
  ogImage="/og/webp-a-png.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="alternate" hreflang="es" href="https://latchtools.com/webp-a-png/" />
    <link rel="alternate" hreflang="en" href="https://latchtools.com/webp-to-png/" />
    <link rel="alternate" hreflang="x-default" href="https://latchtools.com/webp-to-png/" />
  </Fragment>

  <Header enUrl="/webp-to-png/" esUrl="/webp-a-png/" />

  <!-- TOOL HERO + WIDGET -->
  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Ruta de navegación">
          <a href="/">Herramientas</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">WebP a PNG</span>
        </nav>
        <h1>Convertidor de WebP a PNG</h1>
        <p>Convierte imágenes WebP en PNG sin pérdida, directamente en tu navegador. La transparencia se conserva.</p>
        <TrustPill text="Tus archivos nunca salen de tu dispositivo" />
      </div>

      <!-- WIDGET -->
      <div class="widget" id="widget" role="region" aria-label="Convertidor de WebP a PNG">
        <div class="widget-head">
          <span class="wt" style="font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:-.01em" id="widget-title">
            Convierte tus imágenes
          </span>
          <span class="fmt-pill" aria-hidden="true">
            <span class="from">WebP</span>
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            <span class="to">PNG</span>
          </span>
        </div>

        <!-- STATE: empty / drag -->
        <div id="state-drop" class="widget-state">
          <div
            class="dropzone"
            id="dropzone"
            role="button"
            tabindex="0"
            aria-label="Suelta aquí tus archivos WebP o haz clic para seleccionar"
            aria-describedby="dz-hint"
          >
            <div class="dz-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5m0 0L8 9m4-4l4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
            </div>
            <p class="dz-title" id="dz-title">Arrastra y suelta tus imágenes WebP</p>
            <p class="dz-or" aria-hidden="true">o</p>
            <button class="btn btn-secondary" type="button" id="browse-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Seleccionar archivos
            </button>
            <p class="dz-hint" id="dz-hint">Acepta .webp · hasta 10 archivos, 50 MB cada uno</p>
          </div>
        </div>

        <!-- STATE: selected -->
        <div id="state-selected" class="widget-state" hidden>
          <div class="filelist file-list" id="filelist" aria-live="polite" aria-label="Imágenes seleccionadas"></div>
          <p class="batch-summary" id="batch-summary"></p>
          <div class="actions">
            <button class="btn btn-primary grow" type="button" id="convert-btn">
              <span id="convert-label">Convertir a PNG</span>
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            </button>
          </div>
        </div>

        <!-- STATE: processing -->
        <div id="state-processing" class="widget-state" hidden>
          <div class="proc">
            <div class="proc-row">
              <div class="spinner" role="status" aria-label="Convirtiendo"></div>
              <div>
                <div class="pt">Convirtiendo tus imágenes</div>
                <div class="ps" id="proc-status" aria-live="polite"></div>
              </div>
            </div>
            <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="progress-bar">
              <i id="progress-fill" style="width:0%"></i>
            </div>
            <div class="proc-pct">
              <span id="proc-pct">0%</span>
              <span>Todo local — no se sube nada</span>
            </div>
          </div>
          <div class="actions">
            <button class="btn btn-ghost grow" type="button" id="cancel-btn">Cancelar</button>
          </div>
        </div>

        <!-- STATE: done -->
        <div id="state-done" class="widget-state" hidden>
          <div class="result-head">
            <span class="result-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <div>
              <div class="rt" id="done-title">¡Listo!</div>
              <div class="rs" id="done-sub">Guardado como PNG</div>
            </div>
          </div>
          <div class="filelist" id="results-list" aria-live="polite" aria-label="Archivos convertidos"></div>
          <div class="actions">
            <button class="btn btn-secondary" type="button" id="convert-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8M20 4v4h-4"/></svg>
              Convertir otra
            </button>
            <button class="btn btn-primary grow" type="button" id="download-all-btn">
              <span id="download-all-label">Descargar</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"/><path d="M5 19h14"/></svg>
            </button>
          </div>
        </div>

        <!-- STATE: error -->
        <div id="state-error" class="widget-state" hidden>
          <div class="err-head">
            <span class="err-badge" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"/><circle cx="12" cy="16.4" r=".4" fill="currentColor"/><path d="M10.3 4.2L3.4 16a2 2 0 0 0 1.7 3h13.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"/></svg>
            </span>
            <div>
              <div class="et" id="err-title">No pudimos convertir ese archivo</div>
              <div class="es" id="err-message"></div>
              <p class="help-text">El archivo original no se ha modificado.</p>
              <details class="support-details" id="err-support" hidden>
                <summary>Detalles técnicos</summary>
                <code id="err-code"></code>
              </details>
            </div>
          </div>
          <div class="filelist" id="error-list" aria-live="assertive"></div>
          <div class="actions">
            <button class="btn btn-secondary" type="button" id="remove-continue-btn">Quitar y continuar</button>
            <button class="btn btn-primary grow" type="button" id="try-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Probar con otro archivo
            </button>
          </div>
        </div>
      </div>
      <!-- hidden file input -->
      <input type="file" id="file-input" accept=".webp,image/webp" multiple hidden aria-hidden="true" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Cómo convertir WebP a PNG</h2>
          <p class="sec-desc">Cuatro pasos, unos segundos, cero subidas.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Añade tus archivos WebP</h4>
          <p>Arrastra las imágenes al recuadro de arriba o haz clic en Seleccionar para elegirlas desde tu dispositivo. Hasta 10 a la vez.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Convertimos de forma local</h4>
          <p>Latch decodifica cada WebP y lo vuelve a codificar como un PNG sin pérdida usando tu navegador: al instante y sin conexión.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Se conserva la transparencia</h4>
          <p>Las zonas transparentes o semitransparentes se trasladan a la perfección. PNG admite canal alfa completo, así que no se pierde nada.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Descarga tus PNG</h4>
          <p>Guárdalos uno a uno o descárgalos todos de una vez en un único zip. Eso es todo.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WEBP TO PNG EXPLAINED -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">WebP a PNG, explicado</h2>
        </div>
      </div>
      <p style="color:var(--text-2);line-height:1.7;margin-bottom:16px">
        WebP es el formato de imagen moderno de Google: genera archivos muy pequeños, por eso tantos sitios ahora sirven sus imágenes como <code>.webp</code>. El problema: cuando descargas uno, muchos programas de escritorio, editores y herramientas antiguas todavía no pueden abrirlo. Convertirlo a PNG te da un archivo que funciona en todas partes.
      </p>
      <p style="color:var(--text-2);line-height:1.7;margin-bottom:16px">
        PNG es un formato sin pérdida y con compatibilidad casi universal, así que es el destino natural cuando necesitas editar una imagen, insertarla en un documento o entregársela a un programa que no entiende WebP. La conversión es píxel a píxel —no se recomprime nada— y cualquier transparencia del WebP se traslada directamente al canal alfa del PNG.
      </p>
      <p style="color:var(--text-2);line-height:1.7">
        Para convertir un WebP en PNG, suelta tus archivos arriba y pulsa Convertir: todo se ejecuta en tu navegador, así que las imágenes nunca salen de tu dispositivo. ¿Trabajas con otros formatos de nueva generación? <a href="/avif-to-png/" style="color:var(--accent)">AVIF a PNG</a> y <a href="/jxl-to-png/" style="color:var(--accent)">JXL a PNG</a> hacen la misma conversión sin pérdida. ¿Necesitas un archivo más pequeño y fácil de compartir? <a href="/png-to-jpg/" style="color:var(--accent)">PNG a JPG</a> se encarga del resto.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Preguntas frecuentes</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">
            ¿Se suben mis imágenes a algún servidor?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">No. Tu navegador realiza toda la conversión de forma local. No se envía nada a ningún servidor; la herramienta funciona incluso con el Wi-Fi apagado.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            ¿Se pierde calidad al convertir de WebP a PNG?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">No. PNG es un formato sin pérdida. El resultado es una copia idéntica, píxel a píxel, de tu imagen WebP: no se descarta nada durante la conversión.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            ¿Se conserva la transparencia?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Sí. Tanto WebP como PNG admiten transparencia (canal alfa). Cada píxel transparente se conserva exactamente como estaba en el original.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            ¿Por qué convertir de WebP a PNG?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">PNG funciona en todas partes: cualquier programa de diseño, editor de fotos y aplicación de documentos. WebP es excelente en la web, pero algunos programas aún no lo admiten, así que PNG es la opción más segura cuando la compatibilidad importa.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            ¿Hay un límite de tamaño o de número de archivos?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Puedes convertir hasta 10 imágenes a la vez. El límite real es la memoria disponible de tu dispositivo, no un tope arbitrario que hayamos fijado.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            ¿Cómo convierto un archivo WebP a PNG?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Arrastra tus archivos WebP al área de carga (o haz clic en Seleccionar) y pulsa Convertir a PNG. Latch transforma cada WebP en un PNG dentro de tu navegador y te permite descargarlos de uno en uno o en un único zip: convierte un solo archivo o varios a la vez.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- RELATED TOOLS -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Herramientas relacionadas</h2>
        </div>
      </div>
      <div class="tool-grid" style="grid-template-columns:repeat(3,1fr)">
        <a href="/avif-to-png/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
          </div>
          <div class="tool-name">AVIF a PNG</div>
          <div class="tool-desc">Otro formato moderno a PNG sin pérdida, con la transparencia conservada.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/jxl-to-png/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
          </div>
          <div class="tool-name">JXL a PNG</div>
          <div class="tool-desc">Convierte imágenes JPEG XL de nueva generación a PNG sin pérdida, todo en el navegador.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/webp-to-avif/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </div>
          <div class="tool-name">WebP a AVIF</div>
          <div class="tool-desc">¿Vas en sentido contrario? Convierte WebP a un AVIF aún más pequeño.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>

  .widget-state[hidden] { display: none; }

  details.faq-item .faq-a { display: none; }
  details.faq-item[open] .faq-a { display: block; }
  details.faq-item[open] .pm svg path:last-child { opacity: 0; }
</style>

<script>
  import { attachThumb } from '../lib/thumbs';
  // -----------------------------------------------------------------------
  // WebP a PNG — controlador del widget del lado del cliente
  // Usa la API Canvas — no se necesita ninguna librería externa.
  // -----------------------------------------------------------------------

  type FileEntry = { file: File };
  type ResultEntry = { name: string; blob: Blob; originalSize: number };

  const MAX_SIZE_MB = 50;
  const MAX_SIZE_BYTES = MAX_SIZE_MB * 1024 * 1024;
  const MAX_FILES = 10;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const states = {
    drop: $('state-drop'),
    selected: $('state-selected'),
    processing: $('state-processing'),
    done: $('state-done'),
    error: $('state-error'),
  };

  function showState(name: keyof typeof states) {
    for (const [k, el] of Object.entries(states)) {
      (el as HTMLElement).hidden = k !== name;
    }
  }

  let files: FileEntry[] = [];
  let results: ResultEntry[] = [];
  let cancelled = false;

  const dropzone = $('dropzone');
  const fileInput = $<HTMLInputElement>('file-input');
  const browseBtn = $('browse-btn');
  const fileList = $('filelist');
  const convertBtn = $('convert-btn');
  const cancelBtn = $('cancel-btn');
  const resultsList = $('results-list');
  const convertAnotherBtn = $('convert-another-btn');
  const downloadAllBtn = $('download-all-btn');
  const doneTitleEl = $('done-title');
  const removeAndContinueBtn = $('remove-continue-btn');
  const tryAnotherBtn = $('try-another-btn');
  const widgetTitle = $('widget-title');
  const batchSummary = $('batch-summary');
  const convertLabel = $('convert-label');

  // ---- Drop zone ----
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('is-drag');
    $('dz-title').textContent = 'Suelta para añadir tus imágenes';
  });
  ['dragleave', 'dragend'].forEach((ev) => {
    dropzone.addEventListener(ev, () => {
      dropzone.classList.remove('is-drag');
      $('dz-title').textContent = 'Arrastra y suelta tus imágenes WebP';
    });
  });
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('is-drag');
    const de = e as DragEvent;
    addFiles(Array.from(de.dataTransfer?.files ?? []));
  });
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key === 'Enter' || ke.key === ' ') { e.preventDefault(); fileInput.click(); }
  });
  browseBtn.addEventListener('click', (e) => { e.stopPropagation(); fileInput.click(); });
  fileInput.addEventListener('change', () => {
    addFiles(Array.from(fileInput.files ?? []));
    fileInput.value = '';
  });

  function formatBytes(b: number): string {
    if (b < 1024) return b + ' B';
    if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
    return (b / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function escHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function addFiles(incoming: File[]) {
    const valid = incoming.filter((f) => {
      const ext = f.name.split('.').pop()?.toLowerCase() ?? '';
      return ext === 'webp' || f.type === 'image/webp';
    });

    if (valid.length === 0 && incoming.length > 0) {
      showError('Tipo de archivo no admitido', `Suelta un archivo <code>.webp</code>.`, files, 'UNSUPPORTED_FILE_TYPE');
      return;
    }
    if (valid.length === 0) return;

    const oversized = valid.find((f) => f.size > MAX_SIZE_BYTES);
    if (oversized) {
      showError('Archivo demasiado grande', `${oversized.name} debe pesar menos de ${MAX_SIZE_MB} MB.`, files, 'FILE_TOO_LARGE');
      return;
    }

    const existingNames = new Set(files.map((e) => e.file.name));
    const fresh = valid.filter((f) => !existingNames.has(f.name));
    files = [...files, ...fresh.map((f) => ({ file: f }))].slice(0, MAX_FILES);
    if (files.length === 0) return;

    renderFileList();
    widgetTitle.textContent = files.length === 1 ? 'Imagen lista' : `${files.length} imágenes listas`;
    showState('selected');
  }

  function removeFile(index: number) {
    files.splice(index, 1);
    if (files.length === 0) {
      widgetTitle.textContent = 'Convierte tus imágenes';
      showState('drop');
    } else {
      widgetTitle.textContent = files.length === 1 ? 'Imagen lista' : `${files.length} imágenes listas`;
      renderFileList();
    }
  }

  function updateBatchMeta() {
    const n = files.length;
    const total = files.reduce((s, e) => s + e.file.size, 0);
    batchSummary.textContent = n === 1
      ? `${formatBytes(total)} · se descarga como PNG`
      : `${formatBytes(total)} en total · se descarga como un único ZIP`;
    convertLabel.textContent = n === 1 ? 'Convertir a PNG' : `Convertir ${n} imágenes a PNG`;
  }

  function renderFileList() {
    fileList.innerHTML = '';
    files.forEach((entry, i) => {
      const row = document.createElement('div');
      row.className = 'filerow';
      row.innerHTML = `
        <span class="file-thumb">WebP</span>
        <div class="file-meta">
          <div class="file-name">${escHtml(entry.file.name)}</div>
          <div class="file-sub">${formatBytes(entry.file.size)}</div>
        </div>
        <button class="icon-btn" aria-label="Quitar ${escHtml(entry.file.name)}" data-index="${i}">
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 5l8 8M13 5l-8 8"/></svg>
        </button>
      `;
      attachThumb(row.querySelector('.file-thumb'), entry.file);
      row.querySelector('button')!.addEventListener('click', () => removeFile(i));
      fileList.appendChild(row);
    });
    updateBatchMeta();
  }

  convertBtn.addEventListener('click', startConversion);

  async function startConversion() {
    if (files.length === 0) return;
    cancelled = false;
    results = [];
    widgetTitle.textContent = 'Convirtiendo…';
    showState('processing');

    for (let i = 0; i < files.length; i++) {
      if (cancelled) break;

      const entry = files[i];
      const pct = Math.round((i / files.length) * 100);
      updateProgress(pct, `${i + 1} de ${files.length} · ${entry.file.name}`);

      try {
        const blob = await convertOne(entry.file);
        results.push({
          name: entry.file.name.replace(/\.webp$/i, '.png'),
          blob,
          originalSize: entry.file.size,
        });
      } catch (err) {
        if (!cancelled) {
          showError(
            `No se pudo convertir ${entry.file.name}`,
            `<code>${escHtml(entry.file.name)}</code> parece estar dañado o no es una imagen WebP válida.`,
            files.filter((_, j) => j !== i),
            'CONVERT_FAILED'
          );
          return;
        }
      }
    }

    if (!cancelled) {
      updateProgress(100, '');
      showDone();
    }
  }

  function updateProgress(pct: number, status: string) {
    const fill = $<HTMLElement>('progress-fill');
    const pctEl = $('proc-pct');
    const bar = $<HTMLElement>('progress-bar');
    const statusEl = $('proc-status');
    fill.style.width = pct + '%';
    pctEl.textContent = pct + '%';
    bar.setAttribute('aria-valuenow', String(pct));
    statusEl.textContent = status;
  }

  async function convertOne(file: File): Promise<Blob> {
    const bitmap = await createImageBitmap(file);
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    const ctx = canvas.getContext('2d')!;
    ctx.drawImage(bitmap, 0, 0);
    bitmap.close();
    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (blob) resolve(blob);
        else reject(new Error('Canvas conversion failed'));
      }, 'image/png');
    });
  }

  cancelBtn.addEventListener('click', () => {
    cancelled = true;
    files = [];
    results = [];
    widgetTitle.textContent = 'Convierte tus imágenes';
    showState('drop');
  });

  function showDone() {
    const count = results.length;
    doneTitleEl.textContent = `¡Listo! — ${count} ${count === 1 ? 'imagen convertida' : 'imágenes convertidas'}`;
    const totalOriginal = results.reduce((s, r) => s + r.originalSize, 0);
    const totalOutput = results.reduce((s, r) => s + r.blob.size, 0);
    const savedPct = totalOriginal > 0 ? Math.round((1 - totalOutput / totalOriginal) * 100) : 0;
    $('done-sub').textContent = `Guardado como PNG · ${formatBytes(totalOriginal)} → ${formatBytes(totalOutput)}${savedPct > 0 ? ` (${savedPct}% más pequeño)` : ''}`;

    resultsList.innerHTML = '';
    results.forEach((r) => {
      const row = document.createElement('div');
      row.className = 'filerow';
      row.innerHTML = `
        <span class="file-thumb done">PNG</span>
        <div class="file-meta">
          <div class="file-name">${escHtml(r.name)}</div>
          <div class="file-sub">${formatBytes(r.blob.size)}</div>
        </div>
        ${count > 1 ? `<button class="btn btn-secondary" type="button" style="height:40px;padding:0 16px" data-name="${escHtml(r.name)}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"/><path d="M5 19h14"/></svg>
          Guardar
        </button>` : ''}
      `;
      attachThumb(row.querySelector('.file-thumb'), r.blob);
      row.querySelector('button')?.addEventListener('click', () => downloadOne(r));
      resultsList.appendChild(row);
    });
    widgetTitle.textContent = 'Listo para descargar';
    $('download-all-label').textContent = count > 1 ? `Descargar ${count} PNG · ZIP` : 'Descargar PNG';
    showState('done');
  }

  function downloadOne(r: ResultEntry) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(r.blob);
    a.download = r.name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10000);
  }

  async function downloadAll() {
    if (results.length === 1) { downloadOne(results[0]); return; }
    const { default: JSZip } = await import('jszip');
    const zip = new JSZip();
    for (const r of results) zip.file(r.name, r.blob);
    const zipBlob = await zip.generateAsync({ type: 'blob' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(zipBlob);
    a.download = 'webp-a-png.zip';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10000);
  }

  downloadAllBtn.addEventListener('click', () => downloadAll());

  convertAnotherBtn.addEventListener('click', () => {
    files = [];
    results = [];
    widgetTitle.textContent = 'Convierte tus imágenes';
    showState('drop');
  });

  function showError(title: string, message: string, remainingFiles: FileEntry[], code?: string) {
    $('err-title').textContent = title;
    $('err-message').innerHTML = message;
    const support = $('err-support');
    if (code) {
      $('err-code').textContent = code;
      support.hidden = false;
    } else {
      support.hidden = true;
    }
    const errorList = $('error-list');
    errorList.innerHTML = `
      <div class="filerow" style="border-color:color-mix(in srgb,var(--danger) 35%,var(--border))">
        <span class="file-thumb" style="background:var(--danger-weak);color:var(--danger)">!</span>
        <div class="file-meta">
          <div class="file-name">${title}</div>
          <div class="file-sub" style="color:var(--danger)">${message.replace(/<[^>]+>/g, '')}</div>
        </div>
      </div>
    `;
    widgetTitle.textContent = 'Algo salió mal';
    showState('error');

    const handler = () => {
      files = remainingFiles;
      if (files.length === 0) {
        widgetTitle.textContent = 'Convierte tus imágenes';
        showState('drop');
      } else {
        widgetTitle.textContent = files.length === 1 ? 'Imagen lista' : `${files.length} imágenes listas`;
        renderFileList();
        showState('selected');
      }
      removeAndContinueBtn.removeEventListener('click', handler);
    };
    removeAndContinueBtn.addEventListener('click', handler);
  }

  tryAnotherBtn.addEventListener('click', () => {
    files = [];
    results = [];
    widgetTitle.textContent = 'Convierte tus imágenes';
    showState('drop');
  });
</script>
