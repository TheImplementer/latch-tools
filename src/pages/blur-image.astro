---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';
import HowToSteps from '../components/HowToSteps.astro';
import FaqList from '../components/FaqList.astro';
import { howToSchema, faqSchema, type Step, type Faq } from '../lib/guide';

// The hub of the image redaction pages, and a tool in its own right. Each
// page below it has one job: blur-face finds faces, blur-license-plate does a
// car listing in one batch, pixelate-image is for screenshots, redact-image
// for documents and IDs. This one covers blur itself, softening as much as
// hiding, and says which of the three effects to use. Keep a topic on one
// page; link to it from the others rather than repeating it.
const steps: Step[] = [
  { name: 'Add your image', text: 'Drag it onto the editor, or click Browse. JPEG, PNG and WebP are accepted, up to 30 images at a time.' },
  { name: 'Draw over each area', text: 'Drag a box over each area to blur. Everything outside the boxes stays sharp.' },
  { name: 'Choose the strength for the job', text: 'A low strength softens a cluttered background or a logo. Anything that identifies someone needs the top setting.' },
  { name: 'Download', text: 'Save the image, or a zip for a batch. The blur is part of the saved pixels.' },
];

const faqs: Faq[] = [
  {
    q: 'Is my image uploaded anywhere?',
    a: 'No. The image is decoded, blurred and saved in your browser, and nothing is sent to a server. Once the page has loaded, it keeps working offline.',
  },
  {
    q: 'Can I blur the background of a photo?',
    a: 'You can blur any area you draw a box over, so a background can be covered with a few boxes. It can\'t trace round a person to blur everything behind them, the way a phone\'s portrait mode does. For that look, use portrait mode when you take the photo.',
  },
  {
    q: 'Can the blur be reversed?',
    a: 'There is no sharp copy underneath: the blur is part of the saved pixels, not a layer on top. But a blur keeps an average of what was there, and a light blur over short, predictable text such as a number can be matched back to it. For anything that matters, use the top strength or a solid bar. <a href="/unblur-license-plate/">Can a blurred image be unblurred?</a> explains how.',
  },
  {
    q: 'Can I blur several images at once?',
    a: 'Yes, up to 30. Each image keeps its own boxes, <em>Copy boxes to all</em> repeats one image\'s boxes on the rest, and a batch downloads as one zip.',
  },
  {
    q: 'Does blurring lower the quality of the rest of the image?',
    a: 'Only the boxed areas change, and the image is saved at its original size. A PNG stays a lossless PNG. A JPEG is saved as a high-quality JPEG, which re-compresses it once, as any editor would.',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blur Image", "item": "https://latchtools.com/blur-image/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Blur Image",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Blur part of an image, such as a background, a logo, a face or a line of text, in your browser. The image is never uploaded.",
      "url": "https://latchtools.com/blur-image/"
    },
    howToSchema('How to blur part of an image', steps),
    faqSchema(faqs),
  ]
};
---
<Layout
  title="Blur Image — Blur Part of a Photo · Latch Tools"
  description="Blur part of an image, like a face, a background or a logo, in your browser, and see when to pixelate or black out instead. Nothing is uploaded."
  ogImage="/og/blur-image.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Blur Image</span>
        </nav>
        <h1>Blur part of an image</h1>
        <p>Draw a box over a face, a background, a logo, or a line of text, and that area is blurred. Everything outside the boxes stays sharp.</p>
        <TrustPill />
      </div>

      <RedactWidget heading="Blur part of an image" defaultEffect="blur" applyLabel="Blur & download" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to blur part of an image</h2>
        </div>
      </div>
      <HowToSteps steps={steps} />
    </div>
  </section>

  <!-- WHAT BLUR IS FOR -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">What blur is for, and what it isn't</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        Blur is the gentlest of the three effects. It keeps the colour and rough shape of what is underneath, so a blurred area still looks like part of the photo rather than a hole in it. That makes it the right choice for things you want to tone down: a messy background in a product photo, a brand logo you don't have permission to show, a spoiler in a screenshot, a stranger at the edge of the frame.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        It is the wrong choice for text that matters. A blur averages neighbouring pixels, and short, predictable text such as an account number can be matched against that average by trying candidates. So the effect to use depends on what you are hiding:
      </p>
      <ul class="check-list">
        <li><strong>Blur</strong> to soften: backgrounds, logos, faces where you want the photo to stay natural-looking. At the top strength it hides a face well.</li>
        <li><strong><a class="prose-link" href="/pixelate-image/">Pixelate</a></strong> when it should be obvious that something was censored, as in a screenshot you are sharing.</li>
        <li><strong><a class="prose-link" href="/redact-image/">Black out</a></strong> anything that must not be recoverable: account numbers, ID details, addresses, passwords.</li>
      </ul>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        <a class="prose-link" href="/unblur-license-plate/">Can a blurred image be unblurred?</a> goes through why, with the worst case: a license plate.
      </p>
    </div>
  </section>

  <!-- HUB -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">More ways to hide things in an image</h2>
          <p class="sec-desc">This tool blurs any area. The pages below are each set up for one specific job.</p>
        </div>
      </div>
      <div class="tool-grid">
        <a class="tool-card" href="/blur-face/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="4.2"/><path d="M4.6 20a7.4 7.4 0 0 1 14.8 0"/><path d="M9.2 8h5.6M9.8 10.2h4.4" opacity=".45"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Blur a face</h3>
          <p class="tool-desc">Finds the faces for you, with detection that runs on your device.</p>
          <div class="tool-tags"><span class="chip">faces</span><span class="chip">privacy</span></div>
        </a>

        <a class="tool-card" href="/blur-license-plate/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7.5" width="18" height="9" rx="1.6"/><path d="M6 12h2.2M10.2 12h2.2"/><rect x="14.4" y="10.4" width="4" height="3.2" fill="currentColor" stroke="none" opacity=".25"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Blur a license plate</h3>
          <p class="tool-desc">Box the plate once and copy it to every photo in a car listing.</p>
          <div class="tool-tags"><span class="chip">plates</span><span class="chip">privacy</span></div>
        </a>

        <a class="tool-card" href="/pixelate-image/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M9 4.5v15M14.5 4.5v15M3.5 9.5h17M3.5 14.5h17" opacity=".45"/><rect x="9" y="9.5" width="5.5" height="5" fill="currentColor" stroke="none" opacity=".22"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Pixelate an image</h3>
          <p class="tool-desc">Censor screenshots with blocks, and see how big they need to be for text.</p>
          <div class="tool-tags"><span class="chip">redact</span><span class="chip">screenshots</span></div>
        </a>

        <a class="tool-card" href="/redact-image/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2"/><rect x="6" y="8.4" width="8.5" height="2.4" fill="currentColor" stroke="none"/><rect x="6" y="13" width="12" height="2.4" fill="currentColor" stroke="none" opacity=".5"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Redact an image</h3>
          <p class="tool-desc">Solid bars for documents and IDs, including the details they print twice.</p>
          <div class="tool-tags"><span class="chip">blackout</span><span class="chip">documents</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <FaqList faqs={faqs} />

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/blur-license-plate/" style="color:var(--accent-text);font-weight:600">Blur a license plate</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
