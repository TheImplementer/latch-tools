---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blur Image", "item": "https://latchtools.com/blur-image/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Blur Image",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Blur part of an image — a face, a background, text or a logo — directly in your browser. Draw a box and download. Nothing is uploaded.",
      "url": "https://latchtools.com/blur-image/"
    },
    {
      "@type": "HowTo",
      "name": "How to blur part of an image",
      "step": [
        { "@type": "HowToStep", "name": "Add your image", "text": "Drag your image onto the editor, or click Browse to pick it from your device." },
        { "@type": "HowToStep", "name": "Draw over what to blur", "text": "Drag a box over each area you want to blur. Add as many boxes as you need." },
        { "@type": "HowToStep", "name": "Set the strength", "text": "Raise the strength until the area is as soft as you want — use the strongest setting to be sure it's unreadable." },
        { "@type": "HowToStep", "name": "Download the result", "text": "Save the image. The blur is baked into the pixels, so it stays blurred wherever you share it." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is my image uploaded anywhere?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The image is decoded, blurred, and re-saved entirely in your browser with the Canvas API. Nothing is sent to a server, and the tool keeps working offline once the page has loaded." }
        },
        {
          "@type": "Question",
          "name": "Can I blur just one part of an image instead of the whole thing?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Draw a box over each area you want to blur — a face, a sign, a window, a logo — and the rest of the image stays perfectly sharp. There is no limit on how many areas you blur." }
        },
        {
          "@type": "Question",
          "name": "Can I blur a background, a logo, or text?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — anything you draw a box over is blurred, whether that's a busy background, a brand logo, or a line of text. For text you want to be certain is unreadable, use a higher strength, or use the Redact tool to cover it with a solid bar." }
        },
        {
          "@type": "Question",
          "name": "Can the blur be reversed?",
          "acceptedAnswer": { "@type": "Answer", "text": "The blur is rendered into the exported pixels at full resolution, not added as a removable layer, so there is no sharp original underneath. A very light blur over predictable content can sometimes be reconstructed — for anything sensitive, use a strong blur or the Redact tool, which removes the pixels entirely." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between blur, pixelate and blackout?",
          "acceptedAnswer": { "@type": "Answer", "text": "Blur softens an area so it reads as out of focus. Pixelate replaces it with large blocks. Blackout covers it with a solid bar and is the most thorough — the pixels are replaced outright. This page blurs; the Pixelate and Redact tools handle the other two." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Blur Image — Blur Part of a Photo Free & Private · Latch Tools"
  description="Blur part of an image — a face, a background, text or a logo — right in your browser. Draw a box, download. Nothing is uploaded."
  ogImage="/og/blur-image.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Blur Image</span>
        </nav>
        <h1>Blur part of an image</h1>
        <p>Blur a face, a background, a logo, or a line of text — anything you draw a box over. The rest of the image stays sharp, and it all happens in your browser.</p>
        <TrustPill />
        <ul class="tool-features">
          <li>Blur any part — a face, background, logo or text</li>
          <li>Baked into the pixels — not a removable overlay</li>
          <li>The image never leaves your device</li>
        </ul>
      </div>

      <RedactWidget heading="Blur part of an image" defaultEffect="blur" applyLabel="Blur & download" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to blur part of an image</h2>
          <p class="sec-desc">Four steps, a few seconds, zero uploads.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Add your image</h4>
          <p>Drag your image onto the editor, or click Browse. JPEG, PNG, and WebP are all accepted.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Draw over what to blur</h4>
          <p>Drag a box over each area you want to blur. Add as many as you like; move or resize any box afterwards.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Set the strength</h4>
          <p>Raise the strength until the area is soft enough — use the strongest setting to be certain it's unreadable.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Download</h4>
          <p>Save the result. The blur is baked into the pixels, so it stays blurred wherever you share it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CLUSTER HUB -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">More ways to hide things in an image</h2>
          <p class="sec-desc">This tool blurs any area. For a specific job, these are tuned for it — all private, all in your browser.</p>
        </div>
      </div>
      <div class="tool-grid">
        <a class="tool-card" href="/blur-face/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8.5" r="4.2"/><path d="M4.6 20a7.4 7.4 0 0 1 14.8 0"/><path d="M9.2 8h5.6M9.8 10.2h4.4" opacity=".45"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Blur a face</h3>
          <p class="tool-desc">Protect identities before you share — blur any number of faces at once.</p>
          <div class="tool-tags"><span class="chip">faces</span><span class="chip">privacy</span></div>
        </a>

        <a class="tool-card" href="/blur-license-plate/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7.5" width="18" height="9" rx="1.6"/><path d="M6 12h2.2M10.2 12h2.2"/><rect x="14.4" y="10.4" width="4" height="3.2" fill="currentColor" stroke="none" opacity=".25"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Blur a license plate</h3>
          <p class="tool-desc">Hide a number plate before selling a car or posting a photo online.</p>
          <div class="tool-tags"><span class="chip">plates</span><span class="chip">privacy</span></div>
        </a>

        <a class="tool-card" href="/pixelate-image/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2"/><path d="M9 4.5v15M14.5 4.5v15M3.5 9.5h17M3.5 14.5h17" opacity=".45"/><rect x="9" y="9.5" width="5.5" height="5" fill="currentColor" stroke="none" opacity=".22"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Pixelate an image</h3>
          <p class="tool-desc">Censor names, faces and details in screenshots with blocks or blur.</p>
          <div class="tool-tags"><span class="chip">redact</span><span class="chip">screenshots</span></div>
        </a>

        <a class="tool-card" href="/redact-image/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2"/><rect x="6" y="8.4" width="8.5" height="2.4" fill="currentColor" stroke="none"/><rect x="6" y="13" width="12" height="2.4" fill="currentColor" stroke="none" opacity=".5"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">Redact an image</h3>
          <p class="tool-desc">Black out names and numbers on documents — the strongest, permanent option.</p>
          <div class="tool-tags"><span class="chip">blackout</span><span class="chip">documents</span></div>
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">Is my image uploaded anywhere?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">No. The image is decoded, blurred, and re-saved entirely in your browser with the Canvas API. Nothing is sent to a server, and the tool keeps working offline once the page has loaded.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I blur just one part of an image instead of the whole thing?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Draw a box over each area you want to blur — a face, a sign, a window, a logo — and the rest of the image stays perfectly sharp. There is no limit on how many areas you blur.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I blur a background, a logo, or text?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes — anything you draw a box over is blurred, whether that's a busy background, a brand logo, or a line of text. For text you want to be certain is unreadable, use a higher strength, or use the <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">redact tool</a> to cover it with a solid bar.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can the blur be reversed?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">The blur is rendered into the exported pixels at full resolution, not added as a removable layer, so there's no sharp original underneath. A very light blur over predictable content can sometimes be reconstructed — for anything sensitive, use a strong blur or the <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">redact tool</a>, which removes the pixels entirely.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What is the difference between blur, pixelate and blackout?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Blur softens an area so it reads as out of focus. Pixelate replaces it with large blocks. Blackout covers it with a solid bar and is the most thorough — the pixels are replaced outright. This page blurs; the <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">pixelate</a> and <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">redact</a> tools handle the other two.</p>
        </details>
      </div>

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/blur-license-plate/" style="color:var(--accent-text);font-weight:600">Blur a license plate</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
