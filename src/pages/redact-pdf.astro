---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Redact PDF", "item": "https://latchtools.com/redact-pdf/" }
      ]
    },
    {
      "@type": "HowTo",
      "name": "How to redact a PDF",
      "description": "Black out text in a PDF so it is removed rather than covered: every page is rebuilt with the bars burned into its pixels, so no text remains to copy or extract.",
      "step": [
        { "@type": "HowToStep", "name": "Open your PDF", "text": "Drag your PDF onto the editor, or click Browse to pick it from your device." },
        { "@type": "HowToStep", "name": "Find or draw what to hide", "text": "Type a name or number into Find and black out, or tick what to look for, such as email addresses, phone numbers or account numbers, and every match gets a box. Drag a box over anything else. You can move, resize or delete any box before you export." },
        { "@type": "HowToStep", "name": "Check every page", "text": "Use the page strip to review each page. Search cannot see text inside pictures or scans, so look at every page yourself. If the same detail sits in the same place throughout, draw it once and use Copy boxes to all pages." },
        { "@type": "HowToStep", "name": "Redact and download", "text": "Press Redact and download. Every page is rebuilt with the bars baked into the pixels, so the text underneath is gone rather than covered." }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Redact PDF",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Black out text in a PDF so it cannot be copied back out. Every page is rebuilt in your browser with the bars baked into the pixels, and the document is never uploaded.",
      "url": "https://latchtools.com/redact-pdf/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can redacted PDF text be recovered?",
          "acceptedAnswer": { "@type": "Answer", "text": "Not from a file redacted here. This tool does not draw a box over your text. It renders every page to an image with the blacked-out areas already burned into the pixels, then rebuilds the PDF from those images, and the original text layer is not carried across. There is nothing under the bar to select, copy or extract, because the page is no longer made of text. That is the difference between this and a black rectangle drawn in a PDF editor, where the words are still in the file and come straight back out with copy and paste." }
        },
        {
          "@type": "Question",
          "name": "Is my PDF uploaded anywhere?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The document is opened, rendered and rebuilt entirely in your browser. There is no upload endpoint to send it to. Once the page has loaded you can disconnect from the network and the tool still works." }
        },
        {
          "@type": "Question",
          "name": "Can I redact a PDF for free?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. This tool is free, with no account, no watermark on the output and no daily limit. A single PDF can be up to 150 pages and 100 MB." }
        },
        {
          "@type": "Question",
          "name": "Can I redact a PDF on a Mac, iPhone or iPad?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. It runs in the browser, so it works the same in Safari on a Mac, iPhone or iPad as in Chrome, Edge or Firefox on Windows. There is nothing to install. On a phone, drag with one finger to draw a box." }
        },
        {
          "@type": "Question",
          "name": "Why can't I select the text in the redacted file?",
          "acceptedAnswer": { "@type": "Answer", "text": "Because that is what makes it safe. The whole page becomes an image, so no text remains anywhere in the document, including outside the bars. If you could still search a redacted PDF, its words would still be in the file." }
        },
        {
          "@type": "Question",
          "name": "Does the redacted file get bigger?",
          "acceptedAnswer": { "@type": "Answer", "text": "Usually, yes. A page of text stored as text is very compact; the same page stored as an image is not. Standard quality renders at 150 DPI and suits most documents. High renders at 300 DPI and is sharper but larger, so choose it if the result will be printed or zoomed into." }
        },
        {
          "@type": "Question",
          "name": "Does it work on scanned PDFs?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, and a scan is the simplest case. The page is already an image, so nothing is lost by rebuilding it. Scans often carry an invisible OCR text layer added by the scanner or by Acrobat. That text is searchable and copyable, and rebuilding the page removes it too. If a scan has that layer, Find and black out can search it as well. If it does not, draw the boxes by hand." }
        },
        {
          "@type": "Question",
          "name": "Can I redact a password-protected PDF?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, if you know the password. You will be asked for it when you open the file. It is used in your browser to unlock the document and is not sent anywhere. The redacted copy is saved without a password." }
        },
        {
          "@type": "Question",
          "name": "Can I redact several pages at once?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every page keeps its own boxes and the page strip shows which pages you have marked. When the same detail appears in the same position throughout, such as a letterhead, a footer or an address block, draw it once and use Copy boxes to all pages, then check each page, because a box that fits page one may not fit page four." }
        },
        {
          "@type": "Question",
          "name": "Can it find and black out text automatically?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Type a name, phrase or number and every match in the document gets a box, or tick what to look for: email addresses, phone numbers, UK sort codes and account numbers, IBANs, card numbers, National Insurance numbers and US Social Security numbers. Each box is fitted to the printed characters on the page, and you can adjust or remove any of them before you export. Search only sees text the PDF contains, so it can't find anything in a scan without a text layer or inside a picture. The tool lists the pages it couldn't read, and you should still check every page." }
        },
        {
          "@type": "Question",
          "name": "What happens to the rest of the document?",
          "acceptedAnswer": { "@type": "Answer", "text": "The output is rebuilt from scratch, so it carries none of the original's hidden extras either: no document metadata, no annotations or comments, no attachments, and no form fields. The visible content stays where it was, at the same page size and orientation." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Redact PDF — Black Out Text Safely, Free · Latch Tools"
  description="How to redact a PDF so the text is really gone: search for it or draw over it, and every page is rebuilt with the bars burned in. Free, no upload."
  ogImage="/og/redact-pdf.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Redact PDF</span>
        </nav>
        <h1>How to redact a PDF</h1>
        <p>Search for a name or number, or draw a box over anything else, then download. Every page is rebuilt with the bars burned into its pixels. The text underneath is removed rather than covered, so there's nothing left to copy back out.</p>
        <TrustPill />
      </div>

      <RedactWidget heading="Black out anything private" defaultEffect="blackout" applyLabel="Redact &amp; download" mode="pdf" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to black out text in a PDF</h2>
          <p class="sec-desc">Four steps in the editor above.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Open your PDF</h4>
          <p>Drag your PDF onto the editor, or click Browse to pick it from your device.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Find or draw what to hide</h4>
          <p>Type a name or number into <em>Find and black out</em>, or tick what to look for, and every match gets a box. Drag a box over anything else. Move, resize or delete any box before you export.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Check every page</h4>
          <p>Use the page strip to review each page. Search can't see text inside pictures or scans, so look at every page yourself. If the same detail sits in the same place throughout, draw it once and use <em>Copy boxes to all pages</em>.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Redact and download</h4>
          <p>Every page is rebuilt with the bars baked into the pixels, so the text underneath is gone rather than covered.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY / SAFETY -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Why a black box in a PDF editor isn't redaction</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        A PDF stores a document as a list of instructions for drawing it. Draw a black rectangle over a name in a PDF editor and the name stays where it was. The editor adds one more instruction, "paint this area black", which runs after the one that says "write this name here". Both are still in the file. Select the area and copy it, run the file through a text extractor, or open it in a different viewer, and the words come back out intact.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        This is the most common way redactions fail, and nothing warns you when it happens. On screen the document looks redacted, so nobody notices until someone thinks to check. It has caught out courts, government departments and law firms often enough that "redacted PDF leaks its own text" is a recognised genre of story. In those stories the bar looked fine. The leak came from the text still sitting underneath it.
      </p>
      <h3 style="font-size:17px;margin-top:26px">The two traps people fall into most</h3>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:10px">
        <strong style="color:var(--text)">A rectangle drawn in a free PDF reader.</strong> Free readers let you draw a filled shape, but a shape is an annotation sitting on top of the page, and the text beneath it is untouched. In Adobe's lineup, real redaction is part of Acrobat Pro; the free Reader can't do it.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        <strong style="color:var(--text)">Black highlighting in Word before exporting.</strong> Shading text black, or setting black text on a black background, only changes how it looks. Export that to PDF and the words go with it, still selectable. If you still have the source document, delete the sensitive text there. Otherwise, redact the exported PDF here.
      </p>
      <h3 style="font-size:17px;margin-top:26px">What this tool does instead</h3>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:10px">
        Every page is rendered to a canvas, the black bars are composited into those pixels, and a new PDF is assembled from the finished images. The text layer is never carried across into the file you download. No instruction is left that would draw those words, and there is no object to peel a rectangle away from, because the page is no longer built out of text.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        Rebuilding the file instead of editing it has a useful side effect. The hidden parts of the original don't come along either. A PDF can carry document metadata, annotations and comments, attachments, form-field values and earlier saved versions of a page without showing you any of them, and each of these has leaked from documents that looked clean. The copy you download has none of them.
      </p>
      <h3 style="font-size:17px;margin-top:26px">Finding names and numbers for you</h3>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:10px">
        Most PDFs made on a computer still contain their text, which is why a badly redacted one leaks. The same text makes it possible to search. Type a name, a phrase or a number into <em>Find and black out</em> and every match across the document gets a box. It ignores capitals, and a number matches however it's spaced, so 41234567 also finds 4123 4567. Or tick what to look for: email addresses, phone numbers, UK sort codes and account numbers, IBANs, card numbers, National Insurance numbers and US Social Security numbers. Card numbers and IBANs are checked against their built-in check digits, which keeps random strings of digits from being blacked out.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        The text tells the tool roughly where each word is. The box is then fitted to the printed characters on the page itself, so it covers the whole word rather than a guess at it. Like everything else here, the search runs on your device.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        Search only sees text the PDF actually contains. A scanned page with no text layer, a photo of a document, a signature or a logo is just a picture to it, and the tool tells you which pages it couldn't read. Patterns can also miss a number written an unusual way. Treat the results as a head start and still look at every page.
      </p>
      <h3 style="font-size:17px;margin-top:26px">The trade-off</h3>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:10px">
        Destroying the text layer destroys all of it, including the text outside your bars. The redacted PDF is a stack of images. You can't select or search its text, a screen reader can't read it aloud, and it will usually be a larger file than the original. A file can't keep its text and also guarantee the text is gone. If you also need a searchable document, keep that one separately and use the redacted file as the copy you share.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        If nothing needs to be hidden and you only want the document to stop being editable, with its form fields locked and its annotations merged in, that's a different job with a cheaper answer. <a href="/flatten-pdf/" style="color:var(--accent-text);font-weight:600">Flatten it instead</a>, which can do that while leaving the text sharp and searchable.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        The tool can't decide for you what to cover. Check every page before you export, including headers, footers, page margins and anything that repeats. Remember too that a document can identify someone through context as easily as through a name.
      </p>
    </div>
  </section>

  <!-- CHECK -->
  <section class="section" id="check" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">How to check a PDF is really redacted</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        Whoever made the file (this tool, Acrobat or a colleague), these checks take a couple of minutes and catch the failures above. Run them on the exact copy you're about to send rather than the one you were editing.
      </p>
      <ol class="check-list">
        <li><strong>Copy across a bar.</strong> Drag-select over a blacked-out area, copy, and paste into a plain text editor. If words appear, the bar is only covering the text.</li>
        <li><strong>Search for what you removed.</strong> Search the document (Ctrl+F, or ⌘F on a Mac) for a name or number you blacked out. Any match means the text is still in the file.</li>
        <li><strong>Read the document properties.</strong> File → Properties shows the title, author, subject and keywords. These often hold a client's name or the original filename.</li>
        <li><strong>Open the side panels.</strong> Look through the comments, attachments and bookmarks panels. Each can hold text that never appears on a page.</li>
        <li><strong>Extract all the text.</strong> If you're comfortable in a terminal, <code>pdftotext redacted.pdf -</code> from the free Poppler tools prints every piece of text in the file. On a file redacted here it comes back empty, because no text is left.</li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">Can redacted PDF text be recovered?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Not from a file redacted here. This tool doesn't draw a box over your text. It renders every page to an image with the blacked-out areas already burned into the pixels, then rebuilds the PDF from those images, and the original text layer is not carried across. There's nothing under the bar to select, copy or extract, because the page is no longer made of text. That's the difference between this and a black rectangle drawn in a PDF editor, where the words are still in the file and come straight back out with copy and paste. <a href="/unredact-pdf/" style="color:var(--accent-text);font-weight:600">Why redacted PDFs leak, with real cases</a>.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is my PDF uploaded anywhere?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">No. The document is opened, rendered and rebuilt entirely in your browser. There's no upload endpoint to send it to. Once the page has loaded you can disconnect from the network and the tool still works.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I redact a PDF for free?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. This tool is free, with no account, no watermark on the output and no daily limit. A single PDF can be up to 150 pages and 100 MB.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I redact a PDF on a Mac, iPhone or iPad?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. It runs in the browser, so it works the same in Safari on a Mac, iPhone or iPad as in Chrome, Edge or Firefox on Windows. There's nothing to install. On a phone, drag with one finger to draw a box.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Why can't I select the text in the redacted file?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Because that's what makes it safe. The whole page becomes an image, so no text remains anywhere in the document, including outside the bars. If you could still search a redacted PDF, its words would still be in the file.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does the redacted file get bigger?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Usually, yes. A page of text stored as text is very compact; the same page stored as an image is not. Standard quality renders at 150 DPI and suits most documents. High renders at 300 DPI and is sharper but larger, so choose it if the result will be printed or zoomed into.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does it work on scanned PDFs?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes, and a scan is the simplest case. The page is already an image, so nothing is lost by rebuilding it. Scans often carry an invisible OCR text layer added by the scanner or by Acrobat. That text is searchable and copyable, and rebuilding the page removes it too. If a scan has that layer, <em>Find and black out</em> can search it as well. If it doesn't, draw the boxes by hand.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I redact a password-protected PDF?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes, if you know the password. You'll be asked for it when you open the file. It's used in your browser to unlock the document and isn't sent anywhere. The redacted copy is saved without a password.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I redact several pages at once?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Every page keeps its own boxes, and the page strip shows which pages you've marked. When the same detail appears in the same position throughout, such as a letterhead, a footer or an address block, draw it once and use <em>Copy boxes to all pages</em>, then check each page, because a box that fits page one may not fit page four.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can it find and black out text automatically?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Type a name, phrase or number into <em>Find and black out</em> and every match in the document gets a box, or tick what to look for: email addresses, phone numbers, UK sort codes and account numbers, IBANs, card numbers, National Insurance numbers and US Social Security numbers. Each box is fitted to the printed characters on the page, and you can adjust or remove any of them before you export. Search only sees text the PDF contains, so it can't find anything in a scan without a text layer or inside a picture. The tool lists the pages it couldn't read, and you should still check every page.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What happens to the rest of the document?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">The output is rebuilt from scratch, so it carries none of the original's hidden extras either: no document metadata, no annotations or comments, no attachments, and no form fields. The visible content stays where it was, at the same page size and orientation.</p>
        </details>
      </div>

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related: <a href="/unredact-pdf/" style="color:var(--accent-text);font-weight:600">Can redacted PDF text be recovered?</a> · <a href="/redact-bank-statement/" style="color:var(--accent-text);font-weight:600">Redact a bank statement</a> · <a href="/flatten-pdf/" style="color:var(--accent-text);font-weight:600">Flatten a PDF</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>

      <p class="muted" style="font-size:14px;margin-top:12px">
        The same trap catches images too: <a href="/unblur-license-plate/" style="color:var(--accent-text);font-weight:600">why a bar drawn on top of something isn't the same as removing it</a>.
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .check-list {
    margin: 18px 0 0;
    padding-left: 1.3em;
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.65;
  }
  .check-list li + li {
    margin-top: 10px;
  }
  .check-list strong {
    color: var(--text);
  }
  .check-list code {
    font-family: var(--font-mono);
    font-size: 0.88em;
    padding: 1px 6px;
    border-radius: 5px;
    background: var(--surface-soft);
    border: 1px solid var(--border);
    overflow-wrap: anywhere;
  }
</style>
