---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Redact PDF", "item": "https://latchtools.com/redact-pdf/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Redact PDF",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Black out text in a PDF so it cannot be copied back out. Every page is rebuilt with the bars baked into the pixels, in your browser — the document is never uploaded.",
      "url": "https://latchtools.com/redact-pdf/"
    },
    {
      "@type": "HowTo",
      "name": "How to redact a PDF",
      "step": [
        { "@type": "HowToStep", "name": "Open your PDF", "text": "Drag your PDF onto the editor, or click Browse to pick it from your device. It is opened in your browser — nothing is uploaded." },
        { "@type": "HowToStep", "name": "Draw over what to hide", "text": "Drag a box over each name, number or clause you want gone. You can move, resize or delete any box before you export." },
        { "@type": "HowToStep", "name": "Check every page", "text": "Use the page strip to review each page. If the same detail sits in the same place throughout, draw it once and use Copy boxes to all pages." },
        { "@type": "HowToStep", "name": "Redact and download", "text": "Press Redact and download. Every page is rebuilt with the bars baked into the pixels, so the text underneath is gone rather than covered." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can redacted PDF text be recovered?",
          "acceptedAnswer": { "@type": "Answer", "text": "Not from a file redacted here. This tool does not draw a box over your text. It renders every page to an image with the blacked-out areas already burned into the pixels, then rebuilds the PDF from those images, and the original text layer is not carried across. There is nothing under the bar to select, copy or extract, because the page is no longer made of text. That is the difference between this and a black rectangle drawn in a PDF editor, where the words are still in the file and come straight back out with copy and paste." }
        },
        {
          "@type": "Question",
          "name": "Is my PDF uploaded anywhere?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The document is opened, rendered and rebuilt entirely in your browser. There is no upload endpoint to send it to. Once the page has loaded you can disconnect from the network and the tool still works." }
        },
        {
          "@type": "Question",
          "name": "Why can't I select the text in the redacted file?",
          "acceptedAnswer": { "@type": "Answer", "text": "Because that is exactly what makes it safe. The whole page becomes an image, so no text remains anywhere in the document, not only under the bars. It is an honest trade: a redacted PDF you can still search is a redacted PDF that still contains its words." }
        },
        {
          "@type": "Question",
          "name": "Does the redacted file get bigger?",
          "acceptedAnswer": { "@type": "Answer", "text": "Usually, yes. A page of text stored as text is very compact; the same page stored as an image is not. Standard quality renders at 150 DPI and suits most documents. High renders at 300 DPI and is sharper but larger — worth it if the result will be printed or zoomed into." }
        },
        {
          "@type": "Question",
          "name": "Does it work on scanned PDFs?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, and a scan is the simplest case: the page is already an image, so nothing is lost by rebuilding it. Worth knowing that a scan often carries an invisible OCR text layer added by the scanner or by Acrobat — that text is searchable and copyable, and rebuilding the page removes it too." }
        },
        {
          "@type": "Question",
          "name": "Can I redact a password-protected PDF?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes, if you know the password. You will be asked for it when you open the file. It is used in your browser to unlock the document, so the password never leaves your device any more than the file does. The redacted copy is saved without a password." }
        },
        {
          "@type": "Question",
          "name": "Can I redact several pages at once?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every page keeps its own boxes and the page strip shows which pages you have marked. When the same detail appears in the same position throughout — a letterhead, a footer, an address block — draw it once and use Copy boxes to all pages, then check each page, because a box that fits page one may not fit page four." }
        },
        {
          "@type": "Question",
          "name": "What happens to the rest of the document?",
          "acceptedAnswer": { "@type": "Answer", "text": "The output is rebuilt from scratch, so it carries none of the original's hidden extras either: no document metadata, no annotations or comments, no attachments, and no form fields. The visible content stays where it was, at the same page size and orientation." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Redact PDF — Black Out Text Safely, Free · Latch Tools"
  description="Black out text in a PDF so it can't be copied back out. The bars are baked into the pixels, in your browser — your document is never uploaded."
  ogImage="/og/redact-pdf.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Redact PDF</span>
        </nav>
        <h1>Redact a PDF</h1>
        <p>Black out names, numbers and whole clauses — and actually remove them. Each page is rebuilt with the bars burned into the pixels, so there is no text hiding underneath to be copied back out. It all happens in your browser.</p>
        <TrustPill />
        <p class="quick-details">PDF · up to 150 pages · 100 MB · multi-page editing</p>
      </div>

      <RedactWidget heading="Black out anything private" defaultEffect="blackout" applyLabel="Redact &amp; download" mode="pdf" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to redact a PDF</h2>
          <p class="sec-desc">Four steps, and nothing leaves your device.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Open your PDF</h4>
          <p>Drag your PDF onto the editor, or click Browse. It's opened in your browser — nothing is uploaded.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Draw over what to hide</h4>
          <p>Drag a box over each name, number or clause you want gone. Move, resize or delete any box before you export.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Check every page</h4>
          <p>Use the page strip to review each page. If the same detail sits in the same place throughout, draw it once and use <em>Copy boxes to all pages</em>.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Redact and download</h4>
          <p>Every page is rebuilt with the bars baked into the pixels, so the text underneath is gone rather than covered.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY / SAFETY -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Why a black box in a PDF editor isn't redaction</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        A PDF isn't a picture of a document — it's a list of instructions for drawing one. Draw a black rectangle over a name in a PDF editor and you haven't removed the name; you've added one more instruction that says "paint this area black", to be carried out after the one that says "write this name here". Both are still in the file. Select the area and copy it, run the file through a text extractor, or open it in a different viewer, and the words come back out intact.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        This is the single most common way redactions fail, and it fails quietly: on screen the document looks perfectly redacted, so nobody notices until someone thinks to check. It has caught out courts, government departments and law firms often enough that "redacted PDF leaks its own text" is a recognised genre of story. The bar was never the problem — what was underneath it was.
      </p>
      <h3 style="font-size:17px;margin-top:26px">What this tool does instead</h3>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:10px">
        Every page is rendered to a canvas, the black bars are composited into those pixels, and a new PDF is assembled from the finished images. The text layer isn't hidden or covered — it is simply never carried across into the file you download. There is no instruction left that would draw those words, and no object to peel a rectangle away from, because the page is no longer built out of text at all.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        Rebuilding rather than editing has a useful side effect: the hidden parts of the original don't come along either. Document metadata, annotations and comments, attachments, and form-field values are all things a PDF can carry without showing you, and all things that have leaked from documents that looked clean. The copy you download has none of them.
      </p>
      <h3 style="font-size:17px;margin-top:26px">The trade-off, stated plainly</h3>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:10px">
        Destroying the text layer destroys all of it, not just the parts under your bars. The redacted PDF is a stack of images: you can't select or search its text, a screen reader can't read it aloud, and it will usually be a larger file than the original. That is the cost of the guarantee, and there isn't a version of this that keeps both. If you need a searchable document, redact this one and keep it as the shareable copy — don't try to have it both ways in a single file.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        One thing the tool can't do for you is decide what to cover. Check every page before you export, including headers, footers, page margins and anything that repeats — and remember that a document can identify someone through context as easily as through a name.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">Can redacted PDF text be recovered?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Not from a file redacted here. This tool doesn't draw a box over your text — it renders every page to an image with the blacked-out areas already burned into the pixels, then rebuilds the PDF from those images, and the original text layer is not carried across. There's nothing under the bar to select, copy or extract, because the page is no longer made of text. That's the difference between this and a black rectangle drawn in a PDF editor, where the words are still in the file and come straight back out with copy and paste.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Is my PDF uploaded anywhere?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">No. The document is opened, rendered and rebuilt entirely in your browser. There's no upload endpoint to send it to. Once the page has loaded you can disconnect from the network and the tool still works.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Why can't I select the text in the redacted file?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Because that's exactly what makes it safe. The whole page becomes an image, so no text remains anywhere in the document — not only under the bars. It's an honest trade: a redacted PDF you can still search is a redacted PDF that still contains its words.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does the redacted file get bigger?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Usually, yes. A page of text stored as text is very compact; the same page stored as an image is not. Standard quality renders at 150 DPI and suits most documents. High renders at 300 DPI and is sharper but larger — worth it if the result will be printed or zoomed into.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does it work on scanned PDFs?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes, and a scan is the simplest case: the page is already an image, so nothing is lost by rebuilding it. Worth knowing that a scan often carries an invisible OCR text layer added by the scanner or by Acrobat — that text is searchable and copyable, and rebuilding the page removes it too.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I redact a password-protected PDF?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes, if you know the password. You'll be asked for it when you open the file. It's used in your browser to unlock the document, so the password never leaves your device any more than the file does. The redacted copy is saved without a password.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I redact several pages at once?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Every page keeps its own boxes, and the page strip shows which pages you've marked. When the same detail appears in the same position throughout — a letterhead, a footer, an address block — draw it once and use <em>Copy boxes to all pages</em>, then check each page, because a box that fits page one may not fit page four.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What happens to the rest of the document?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">The output is rebuilt from scratch, so it carries none of the original's hidden extras either: no document metadata, no annotations or comments, no attachments, and no form fields. The visible content stays where it was, at the same page size and orientation.</p>
        </details>
      </div>

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>

      <p class="muted" style="font-size:14px;margin-top:12px">
        The same trap catches images too: <a href="/unblur-license-plate/" style="color:var(--accent-text);font-weight:600">why a bar drawn on top of something isn't the same as removing it</a>.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
