---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
---
<Layout
  title="Latch Tools — Redact PDFs and photos for good"
  description="Black out names, account numbers, faces and plates in PDFs and photos. The bars are burned into the pixels, so nothing can be copied back out."
  ogImage="/og/home.png"
>
  <Header />

  <!-- HERO -->
  <section>
    <div class="wrap" style="text-align:center;display:flex;flex-direction:column;align-items:center;padding:72px 28px 40px">
      <span class="eyebrow">PDF and photo redaction</span>
      <h1 class="hero-h">Redact it so it<br>stays redacted.</h1>
      <p class="hero-sub">
        Black out names, account numbers, faces and plates. The file you download is rebuilt with
        the boxes burned into its pixels, so there's no hidden text or layer left to copy back out.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="/redact-pdf/">
          Redact a PDF
          <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="/redact-image/">Redact an image</a>
      </div>
      <TrustPill />
    </div>
  </section>

  <!-- TOOLS DIRECTORY -->
  <section class="tool-finder" id="tools">
    <div class="wrap">
      <div class="finder-top">
        <div>
          <h2 class="sec-title" style="font-size:clamp(24px,3.4vw,30px)">Choose a tool</h2>
          <p class="sec-desc">Start with what you need to do. Each tool opens on its own focused page.</p>
        </div>
        <div class="search-wrap">
          <label for="tool-search">Search tools</label>
          <input id="tool-search" type="search" placeholder="PDF, blur a face, HEIC…" data-tool-search autocomplete="off" />
        </div>
      </div>

      <div class="groups">
        <section class="tool-group" id="redact" data-tool-group>
          <h3>Redact and hide</h3>
          <div class="tool-list">
            <a class="tool-row" href="/redact-pdf/" data-tool-row><span class="format-label">pdf · redact</span><span class="tool-name">Redact a PDF</span><span class="tool-description">Black out text so it can't be copied back out</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/redact-bank-statement/" data-tool-row><span class="format-label">pdf · statement</span><span class="tool-name">Redact a bank statement</span><span class="tool-description">Hide account details and transactions, keep your income readable</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/redact-image/" data-tool-row><span class="format-label">redact</span><span class="tool-name">Redact an image</span><span class="tool-description">Black out details permanently, with nothing left underneath</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/remove-metadata-from-pdf/" data-tool-row><span class="format-label">pdf · metadata</span><span class="tool-name">Remove PDF metadata</span><span class="tool-description">Clear the author, edit history and earlier versions hidden in a PDF</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/flatten-pdf/" data-tool-row><span class="format-label">pdf · flatten</span><span class="tool-name">Flatten a PDF</span><span class="tool-description">Lock form fields and merge layers so nothing can be edited</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/blur-face/" data-tool-row><span class="format-label">blur</span><span class="tool-name">Blur a face</span><span class="tool-description">Hide someone's identity before sharing a photo</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/blur-license-plate/" data-tool-row><span class="format-label">blur</span><span class="tool-name">Blur a license plate</span><span class="tool-description">Hide a number plate in a vehicle photo</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/blur-image/" data-tool-row><span class="format-label">blur</span><span class="tool-name">Blur part of an image</span><span class="tool-description">Blur a face, logo, text or anything else you box over</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/pixelate-image/" data-tool-row><span class="format-label">pixelate</span><span class="tool-name">Pixelate an image</span><span class="tool-description">Censor names and faces with pixel blocks</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/remove-exif/" data-tool-row><span class="format-label">exif · gps</span><span class="tool-name">Remove image metadata</span><span class="tool-description">Strip location, camera and other hidden details</span><span class="tool-arrow" aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="tool-group" data-tool-group>
          <h3>Sign</h3>
          <div class="tool-list">
            <a class="tool-row" href="/sign-pdf/" data-tool-row><span class="format-label">pdf · sign</span><span class="tool-name">Sign a PDF</span><span class="tool-description">Draw, type or upload a signature and place it on any page</span><span class="tool-arrow" aria-hidden="true">→</span></a>
          </div>
        </section>

        <section class="tool-group" data-tool-group>
          <h3>Resize and encode</h3>
          <div class="tool-list">
            <a class="tool-row" href="/resize-image/" data-tool-row><span class="format-label">resize</span><span class="tool-name">Resize for passport &amp; visa</span><span class="tool-description">Crop to passport, visa and LinkedIn presets</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/image-to-base64/" data-tool-row><span class="format-label">base64</span><span class="tool-name">Image to Base64</span><span class="tool-description">Encode an image to a Base64 data URI</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/base64-to-image/" data-tool-row><span class="format-label">base64</span><span class="tool-name">Base64 to Image</span><span class="tool-description">Decode a Base64 string back into an image</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="mailto:hello@latchtools.com?subject=Tool%20suggestion" data-tool-row><span class="format-label">suggest</span><span class="tool-name">Need another tool?</span><span class="tool-description">Tell us what to build next, and we'll ship the most-asked first</span><span class="tool-arrow" aria-hidden="true">→</span></a>
          </div>
        </section>
        <section class="tool-group" data-tool-group>
          <h3>Convert images</h3>
          <div class="tool-list">
            <a class="tool-row" href="/heic-to-jpg/" data-tool-row><span class="format-label">.heic → .jpg</span><span class="tool-name">HEIC to JPG</span><span class="tool-description">Make iPhone photos easy to open and share</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/heic-to-png/" data-tool-row><span class="format-label">.heic → .png</span><span class="tool-name">HEIC to PNG</span><span class="tool-description">iPhone photos to lossless PNG with transparency</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/png-to-jpg/" data-tool-row><span class="format-label">.png → .jpg</span><span class="tool-name">PNG to JPG</span><span class="tool-description">Smaller JPGs from PNGs, with quality control</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/webp-to-png/" data-tool-row><span class="format-label">.webp → .png</span><span class="tool-name">WebP to PNG</span><span class="tool-description">Turn WebP back into a universal PNG</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/webp-to-jpg/" data-tool-row><span class="format-label">.webp → .jpg</span><span class="tool-name">WebP to JPG</span><span class="tool-description">Turn WebP into a compact, shareable JPG</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/png-to-webp/" data-tool-row><span class="format-label">.png → .webp</span><span class="tool-name">PNG to WebP</span><span class="tool-description">Smaller PNGs for the web, transparency kept</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/jpg-to-webp/" data-tool-row><span class="format-label">.jpg → .webp</span><span class="tool-name">JPG to WebP</span><span class="tool-description">Shrink JPG photos to lighter WebP files</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/avif-to-jpg/" data-tool-row><span class="format-label">.avif → .jpg</span><span class="tool-name">AVIF to JPG</span><span class="tool-description">Open AVIF images anywhere as a JPG</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/avif-to-png/" data-tool-row><span class="format-label">.avif → .png</span><span class="tool-name">AVIF to PNG</span><span class="tool-description">AVIF to lossless PNG with transparency</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/png-to-avif/" data-tool-row><span class="format-label">.png → .avif</span><span class="tool-name">PNG to AVIF</span><span class="tool-description">Much smaller PNGs with the modern AVIF codec</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/jpg-to-avif/" data-tool-row><span class="format-label">.jpg → .avif</span><span class="tool-name">JPG to AVIF</span><span class="tool-description">Shrink JPGs to AVIF at the same quality</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/avif-to-webp/" data-tool-row><span class="format-label">.avif → .webp</span><span class="tool-name">AVIF to WebP</span><span class="tool-description">AVIF to widely-supported WebP</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/webp-to-avif/" data-tool-row><span class="format-label">.webp → .avif</span><span class="tool-name">WebP to AVIF</span><span class="tool-description">Compress WebP further with the AV1 codec</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/jxl-to-jpg/" data-tool-row><span class="format-label">.jxl → .jpg</span><span class="tool-name">JXL to JPG</span><span class="tool-description">Open JPEG XL files as a universal JPG</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/jxl-to-png/" data-tool-row><span class="format-label">.jxl → .png</span><span class="tool-name">JXL to PNG</span><span class="tool-description">JPEG XL to lossless PNG</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/png-to-jxl/" data-tool-row><span class="format-label">.png → .jxl</span><span class="tool-name">PNG to JXL</span><span class="tool-description">Smaller PNGs as JPEG XL, transparency kept</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/jpg-to-jxl/" data-tool-row><span class="format-label">.jpg → .jxl</span><span class="tool-name">JPG to JXL</span><span class="tool-description">Encode JPG photos to modern JPEG XL</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/jfif-to-jpg/" data-tool-row><span class="format-label">.jfif → .jpg</span><span class="tool-name">JFIF to JPG</span><span class="tool-description">Fix a .jfif so any app can open it</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/jfif-to-png/" data-tool-row><span class="format-label">.jfif → .png</span><span class="tool-name">JFIF to PNG</span><span class="tool-description">Turn a .jfif into a lossless PNG</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/svg-to-jpg/" data-tool-row><span class="format-label">.svg → .jpg</span><span class="tool-name">SVG to JPG</span><span class="tool-description">Rasterise vector SVGs to a JPG at any size</span><span class="tool-arrow" aria-hidden="true">→</span></a>
            <a class="tool-row" href="/svg-to-png/" data-tool-row><span class="format-label">.svg → .png</span><span class="tool-name">SVG to PNG</span><span class="tool-description">Rasterise vector SVGs to PNG with transparency</span><span class="tool-arrow" aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>
      <p class="no-results" data-no-results hidden>No tools match that search.</p>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section" id="how" style="padding-top:8px">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="sec-title">How it works</h2>
          <p class="sec-desc">Open a tool, drag a box over each detail, and download the copy. The difference is in what that copy contains.</p>
        </div>
      </div>

      <div class="compare">
        <figure class="cmp-card">
          <figcaption class="cmp-label">A black box drawn in a PDF editor</figcaption>
          <div class="cmp-doc" aria-hidden="true">
            <p class="cmp-head">Statement of account</p>
            <p>Account holder: <span class="cmp-bar">Jane Example</span></p>
            <p>Sort code: <span class="cmp-bar">12-34-56</span></p>
            <p>Account no.: <span class="cmp-bar">87654321</span></p>
          </div>
          <div class="cmp-out">
            <span class="cmp-out-label">Copy and paste returns</span>
            <code>Account holder: Jane Example<br>Sort code: 12-34-56<br>Account no.: 87654321</code>
          </div>
        </figure>

        <figure class="cmp-card cmp-card--ok">
          <figcaption class="cmp-label">The same page redacted here</figcaption>
          <div class="cmp-doc cmp-doc--flat" aria-hidden="true">
            <p class="cmp-head">Statement of account</p>
            <p>Account holder: <span class="cmp-bar cmp-bar--empty" style="width:7.2em"></span></p>
            <p>Sort code: <span class="cmp-bar cmp-bar--empty" style="width:4.6em"></span></p>
            <p>Account no.: <span class="cmp-bar cmp-bar--empty" style="width:5.2em"></span></p>
          </div>
          <div class="cmp-out">
            <span class="cmp-out-label">Copy and paste returns</span>
            <code class="cmp-empty">Nothing. Every page is now an image, with the bars burned into its pixels.</code>
          </div>
        </figure>
      </div>

      <p class="cmp-more">
        Real cases where the left-hand version leaked, and how to check a file:
        <a href="/unredact-pdf/">can redacted PDF text be recovered?</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  // Homepage tool search: filter rows by text, hide empty groups, toggle the empty state.
  const search = document.querySelector<HTMLInputElement>('[data-tool-search]');
  const rows = [...document.querySelectorAll<HTMLElement>('[data-tool-row]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-tool-group]')];
  const empty = document.querySelector<HTMLElement>('[data-no-results]');
  search?.addEventListener('input', () => {
    const query = search.value.trim().toLowerCase();
    let visible = 0;
    rows.forEach((row) => {
      const match = row.textContent!.toLowerCase().includes(query);
      row.hidden = !match;
      if (match) visible++;
    });
    groups.forEach((group) => {
      group.hidden = !group.querySelector('[data-tool-row]:not([hidden])');
    });
    if (empty) empty.hidden = visible > 0;
  });
</script>

<style>
  .compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 760px) {
    .compare {
      grid-template-columns: 1fr;
    }
  }
  .cmp-card {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .cmp-label {
    padding: 14px 18px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--border);
  }
  .cmp-card--ok .cmp-label {
    color: var(--accent-text);
  }
  /* Paper-white in both themes, so the bars read as ink on a page. */
  .cmp-doc {
    padding: 20px 22px;
    background: #fdfdfb;
    color: #1d211e;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 15.5px;
    line-height: 1.95;
    border-bottom: 1px solid var(--border);
  }
  .cmp-doc p {
    margin: 0;
  }
  .cmp-head {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #5e6962;
    margin-bottom: 6px !important;
  }
  .cmp-bar {
    background: #111;
    color: #111;
    padding: 1px 2px;
    border-radius: 1px;
  }
  .cmp-bar--empty {
    display: inline-block;
    height: 1.05em;
    vertical-align: -0.15em;
    padding: 0;
  }
  /* The redacted copy is an image: nothing on it can be selected. */
  .cmp-doc--flat {
    user-select: none;
    -webkit-user-select: none;
  }
  .cmp-out {
    padding: 14px 18px 18px;
    background: var(--surface-soft);
    flex: 1;
  }
  .cmp-out-label {
    display: block;
    font-size: 12.5px;
    color: var(--text-3);
    margin-bottom: 6px;
  }
  .cmp-out code {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--danger);
  }
  .cmp-out code.cmp-empty {
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--text-2);
  }
  .cmp-more {
    margin: 18px 0 0;
    font-size: 14.5px;
    color: var(--text-2);
  }
  .cmp-more a {
    color: var(--accent-text);
    font-weight: 600;
  }
</style>
