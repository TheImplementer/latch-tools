---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
---
<Layout
  title="Latch Tools — Private file tools that run in your browser"
  description="A fast, free toolkit for your images — convert, compress, resize and clean metadata. Every tool runs entirely in your browser. Nothing is uploaded, nothing is stored."
  ogImage="/og/home.png"
>
  <Header />

  <!-- HERO -->
  <section style="background:radial-gradient(62% 120% at 50% -8%, var(--accent-weak), transparent 60%)">
    <div class="wrap" style="text-align:center;display:flex;flex-direction:column;align-items:center;padding:80px 28px 44px">
      <span class="eyebrow">
        <span class="bar"></span>
        Private by design
      </span>
      <h1 class="hero-h">Edit your files without<br>ever uploading them.</h1>
      <p class="hero-sub">
        A fast, free toolkit for your images — convert, compress, resize and clean metadata.
        Every tool runs entirely in your browser. Nothing is uploaded, nothing is stored, nothing leaves your device.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="#tools">
          Browse the tools
          <svg width="17" height="17" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a class="btn btn-ghost btn-lg" href="#how">How it works</a>
      </div>
      <div style="margin-top:30px">
        <TrustPill />
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section" id="tools" style="padding-top:34px">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <h2 class="sec-title">Pick a tool</h2>
          <p class="sec-desc">A growing set of focused image tools — each one does a single job, well.</p>
        </div>
      </div>

      <div class="tool-grid">
        <a class="tool-card" href="/heic-to-jpg/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">HEIC to JPG</h3>
          <p class="tool-desc">Turn iPhone HEIC photos into universal JPGs anything can open.</p>
          <div class="tool-tags"><span class="chip">.heic → .jpg</span></div>
        </a>

        <a class="tool-card" href="/heic-to-png/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">HEIC to PNG</h3>
          <p class="tool-desc">Convert iPhone HEIC photos to lossless PNG with transparency preserved.</p>
          <div class="tool-tags"><span class="chip">.heic → .png</span></div>
        </a>

        <a class="tool-card" href="/png-to-jpg/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="11" y="5" width="2" height="14" rx="1" fill="currentColor" stroke="none" opacity=".22"/><path d="M3 12h5m0 0L5.5 9.5M8 12l-2.5 2.5"/><path d="M21 12h-5m0 0l2.5-2.5M16 12l2.5 2.5"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">PNG to JPG</h3>
          <p class="tool-desc">Convert PNG images to JPG with adjustable quality, right in your browser.</p>
          <div class="tool-tags"><span class="chip">.png → .jpg</span></div>
        </a>

        <a class="tool-card" href="/webp-to-png/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 16a8 8 0 0 1-13.5 2.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">WebP to PNG</h3>
          <p class="tool-desc">Convert WebP images back to lossless, universally-supported PNG.</p>
          <div class="tool-tags"><span class="chip">.webp → .png</span></div>
        </a>

        <a class="tool-card" href="/webp-to-jpg/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 16a8 8 0 0 1-13.5 2.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">WebP to JPG</h3>
          <p class="tool-desc">Convert WebP images to compact, universally-supported JPGs with adjustable quality.</p>
          <div class="tool-tags"><span class="chip">.webp → .jpg</span></div>
        </a>

        <a class="tool-card" href="/png-to-webp/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 16a8 8 0 0 1-13.5 2.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">PNG to WebP</h3>
          <p class="tool-desc">Convert PNG images to smaller WebP files — transparency preserved.</p>
          <div class="tool-tags"><span class="chip">.png → .webp</span></div>
        </a>

        <a class="tool-card" href="/jpg-to-webp/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 16a8 8 0 0 1-13.5 2.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">JPG to WebP</h3>
          <p class="tool-desc">Convert JPG photos to smaller WebP files with adjustable quality.</p>
          <div class="tool-tags"><span class="chip">.jpg → .webp</span></div>
        </a>

        <a class="tool-card" href="/avif-to-jpg/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">AVIF to JPG</h3>
          <p class="tool-desc">Convert modern AVIF images to universal JPGs anything can open.</p>
          <div class="tool-tags"><span class="chip">.avif → .jpg</span></div>
        </a>

        <a class="tool-card" href="/avif-to-png/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">AVIF to PNG</h3>
          <p class="tool-desc">Convert AVIF images to lossless PNG with transparency preserved.</p>
          <div class="tool-tags"><span class="chip">.avif → .png</span></div>
        </a>

        <a class="tool-card" href="/png-to-avif/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">PNG to AVIF</h3>
          <p class="tool-desc">Shrink PNGs to modern AVIF — much smaller files, transparency kept.</p>
          <div class="tool-tags"><span class="chip">.png → .avif</span></div>
        </a>

        <a class="tool-card" href="/jpg-to-avif/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">JPG to AVIF</h3>
          <p class="tool-desc">Shrink JPGs to modern AVIF — same quality, a fraction of the size.</p>
          <div class="tool-tags"><span class="chip">.jpg → .avif</span></div>
        </a>

        <a class="tool-card" href="/avif-to-webp/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 16a8 8 0 0 1-13.5 2.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">AVIF to WebP</h3>
          <p class="tool-desc">Convert AVIF images to widely-supported WebP, transparency kept.</p>
          <div class="tool-tags"><span class="chip">.avif → .webp</span></div>
        </a>

        <a class="tool-card" href="/webp-to-avif/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">WebP to AVIF</h3>
          <p class="tool-desc">Shrink WebP images further with the modern AV1 codec.</p>
          <div class="tool-tags"><span class="chip">.webp → .avif</span></div>
        </a>

        <a class="tool-card" href="/jxl-to-jpg/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">JXL to JPG</h3>
          <p class="tool-desc">Open JPEG XL files anywhere by converting them to a universal JPG.</p>
          <div class="tool-tags"><span class="chip">.jxl → .jpg</span></div>
        </a>

        <a class="tool-card" href="/jxl-to-png/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">JXL to PNG</h3>
          <p class="tool-desc">Convert JPEG XL images to lossless PNG with transparency preserved.</p>
          <div class="tool-tags"><span class="chip">.jxl → .png</span></div>
        </a>

        <a class="tool-card" href="/jfif-to-jpg/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">JFIF to JPG</h3>
          <p class="tool-desc">A JFIF is just a JPEG — fix the extension so any app can open it.</p>
          <div class="tool-tags"><span class="chip">.jfif → .jpg</span></div>
        </a>

        <a class="tool-card" href="/jfif-to-png/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">JFIF to PNG</h3>
          <p class="tool-desc">Turn a .jfif into a lossless PNG that opens in any app.</p>
          <div class="tool-tags"><span class="chip">.jfif → .png</span></div>
        </a>

        <a class="tool-card" href="/svg-to-jpg/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="4" height="4" rx="1"/><rect x="17" y="3" width="4" height="4" rx="1"/><rect x="3" y="17" width="4" height="4" rx="1"/><rect x="17" y="17" width="4" height="4" rx="1"/><path d="M7 5h10M5 7v10M19 7v10M7 19h10"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">SVG to JPG</h3>
          <p class="tool-desc">Rasterise SVG vector graphics to a JPG at any size you choose.</p>
          <div class="tool-tags"><span class="chip">.svg → .jpg</span></div>
        </a>

        <a class="tool-card" href="/svg-to-png/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="4" height="4" rx="1"/><rect x="17" y="3" width="4" height="4" rx="1"/><rect x="3" y="17" width="4" height="4" rx="1"/><rect x="17" y="17" width="4" height="4" rx="1"/><path d="M7 5h10M5 7v10M19 7v10M7 19h10"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11L11 5M6 5h5v5"/></svg>
          </span>
          <h3 class="tool-name">SVG to PNG</h3>
          <p class="tool-desc">Rasterise SVG vector graphics to lossless PNG with transparency preserved.</p>
          <div class="tool-tags"><span class="chip">.svg → .png</span></div>
        </a>

        <a class="tool-card" href="/resize-image/">
          <span class="tool-ic">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3v14a2 2 0 0 0 2 2h14"/><path d="M19 21V7a2 2 0 0 0-2-2H3"/><circle cx="12" cy="10" r="2"/><path d="M9 15.2a3 3 0 0 1 6 0"/></svg>
          </span>
          <span class="tool-arrow" aria-hidden="true">
