---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';
import HowToSteps from '../components/HowToSteps.astro';
import FaqList from '../components/FaqList.astro';
import { howToSchema, faqSchema, type Step, type Faq } from '../lib/guide';

// This page's job: photos and scans of documents, IDs above all. The solid
// bar is the only effect here, and the copy is about what people forget to
// cover: the places a document repeats what you blacked out.
const steps: Step[] = [
  { name: 'Add the photo or scan', text: 'Drag the photo of the ID, letter or statement onto the editor, or click Browse. JPEG, PNG and WebP are accepted.' },
  { name: 'Bar each detail, and its repeats', text: 'Cover every name, number and signature. Then look for the same details printed again: the coded lines at the foot of a passport, a barcode, a reference in the footer.' },
  { name: 'Zoom in on the edges', text: 'Check that each bar covers the whole detail, including the tops of tall letters and the tails of g, p and y.' },
  { name: 'Download', text: 'Save the result. Each bar replaces the pixels under it, so the file holds nothing of what it covered.' },
];

const faqs: Faq[] = [
  {
    q: 'Is it safe to use with a photo of my passport?',
    a: 'The photo is opened, redacted and saved in your browser, and it is never uploaded, so no copy ends up on a server to be kept or leaked. The copy you download is re-saved without the original\'s location and camera details.',
  },
  {
    q: 'Can the blacked-out details be recovered?',
    a: 'No. A bar replaces the pixels under it with solid black before the image is saved, so there is nothing underneath to recover. That is the difference from blur and pixelation, which keep an average of the original pixels and can sometimes be matched back to the text. For documents, use a bar.',
  },
  {
    q: 'I\'ve heard black-box redactions can be undone. Is this safe?',
    a: 'That failure happens with documents that have text in them, such as PDFs, where a black box is drawn on top and the text stays in the file to be copied out. An image has no text layer: the bar overwrites the pixels, and the image is saved flat. A PDF needs more than a drawn box, and <a href="/redact-pdf/">Redact PDF</a> handles that, including searching the text for you.',
  },
  {
    q: 'Can I redact several documents at once?',
    a: 'Yes, up to 30 images. Each keeps its own bars. When they share a layout, such as the pages of one statement photographed the same way, bar the first and press <em>Copy boxes to all</em>, then check each one.',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Redact Image", "item": "https://latchtools.com/redact-image/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Redact Image",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Black out names, ID numbers and other details in a photo or scan of a document, with solid bars that replace the pixels. Runs in your browser.",
      "url": "https://latchtools.com/redact-image/"
    },
    howToSchema('How to black out details on a photo of a document', steps),
    faqSchema(faqs),
  ]
};
---
<Layout
  title="Redact Image — Black Out Sensitive Info · Latch Tools"
  description="Black out names, ID numbers and signatures on a photo of a passport or letter, including the coded lines and barcodes people miss. In your browser."
  ogImage="/og/redact-image.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Redact Image</span>
        </nav>
        <h1>Redact sensitive details in an image</h1>
        <p>Black out names, account numbers, addresses or signatures on a photo of a document, an ID or a screenshot. Draw a bar over each detail and the pixels under it are replaced, leaving nothing underneath.</p>
        <TrustPill />
      </div>

      <RedactWidget heading="Black out sensitive details" defaultEffect="blackout" applyLabel="Redact & download" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to black out details on a document</h2>
        </div>
      </div>
      <HowToSteps steps={steps} />
    </div>
  </section>

  <!-- ID CHECKLIST -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">What to black out on an ID</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        When someone asks for a copy of your ID, ask what they actually need to see. It is often just the name and photo, and the rest can go. Identity documents repeat their details in places that are easy to miss, so check for each of these.
      </p>
      <ul class="check-list">
        <li><strong>The document number</strong>, on the front and anywhere it is printed again, such as down the side or on the back.</li>
        <li><strong>The two coded lines on a passport.</strong> The lines of capitals, digits and <code>&lt;&lt;&lt;</code> along the bottom of the photo page repeat your name, passport number, nationality, date of birth and expiry date. Covering the printed fields above and leaving these lines gives every one of them away.</li>
        <li><strong>A UK driving licence number.</strong> It is built from the first five letters of your surname, your date of birth and your initials, so it gives those away even with the name covered.</li>
        <li><strong>Barcodes.</strong> The barcode on the back of a US driver's license holds the name, address and date of birth printed on the front, in a form any phone can read.</li>
        <li><strong>Signature and photo</strong>, unless the person you are sending it to needs them.</li>
      </ul>
    </div>
  </section>

  <!-- SAFE BARS -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Are black bars safe?</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        You may have heard of redactions being undone, with a black box lifted off a document to reveal the text beneath. That happens with <strong>PDFs and other documents that contain text</strong>, where drawing a box only adds a shape on top while the original text stays in the file, ready to be copied out.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        An image works differently. It has <strong>pixels, not text</strong>, and when you export, each bar's pixels overwrite the originals and the image is saved flat. What can still go wrong is coverage: a bar that stops short of a letter's edge, or a detail you didn't notice was printed twice. That is what the checklist above is for.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <FaqList faqs={faqs} />

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/redact-pdf/" style="color:var(--accent-text);font-weight:600">Redact a PDF</a> · <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">Blur part of an image</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/blur-license-plate/" style="color:var(--accent-text);font-weight:600">Blur a license plate</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
