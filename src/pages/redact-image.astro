---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Redact Image", "item": "https://latchtools.com/redact-image/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Redact Image",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Black out names, numbers and sensitive details in an image or screenshot. The bars are baked into the pixels, and the file never leaves your browser.",
      "url": "https://latchtools.com/redact-image/"
    },
    {
      "@type": "HowTo",
      "name": "How to redact an image",
      "step": [
        { "@type": "HowToStep", "name": "Add your image", "text": "Drag the document, screenshot, or photo onto the editor, or click Browse to select it." },
        { "@type": "HowToStep", "name": "Draw over each detail", "text": "Drag a black bar over every name, number, or line you want to hide. Add as many as you need." },
        { "@type": "HowToStep", "name": "Check the coverage", "text": "Make sure each bar fully covers the detail. Blackout is the strongest option — the covered pixels are replaced entirely." },
        { "@type": "HowToStep", "name": "Download the redacted image", "text": "Save the result. The bars are flattened into the pixels, so nothing sensitive remains in the file." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is my image uploaded to a server?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The image is opened, redacted, and re-saved entirely in your browser with the Canvas API. Nothing is uploaded, so even documents full of personal data stay on your device." }
        },
        {
          "@type": "Question",
          "name": "Can the blacked-out content be recovered?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. A blackout bar replaces the covered pixels with solid colour and is flattened into the exported image — there is no original detail left underneath to recover. It is the strongest of the three options: blur and pixelation obscure detail and can occasionally be reversed if applied too lightly, whereas a solid bar removes it outright." }
        },
        {
          "@type": "Question",
          "name": "I've heard black-box redactions can be undone — is this safe?",
          "acceptedAnswer": { "@type": "Answer", "text": "That well-known failure happens with black boxes drawn over text in PDFs or other documents, where the text layer still exists underneath the graphic and can be copied out. This tool exports a flat raster image: the pixels themselves are overwritten, so there is no hidden text or layer beneath the bar. (To redact a PDF safely you must flatten or rasterise it — drawing a box in a PDF editor is not enough.)" }
        },
        {
          "@type": "Question",
          "name": "Can I redact several things at once?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Draw a separate bar over each detail — there is no limit. You can move, resize, or delete any bar before you export." }
        },
        {
          "@type": "Question",
          "name": "Should I use blackout, blur, or pixelate?",
          "acceptedAnswer": { "@type": "Answer", "text": "Use blackout when the goal is certainty — an account number, an address, a name on an ID. If you'd rather show that something is present but hidden, such as a face in a photo, the Blur and Pixelate tools do that with a softer look." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Redact an Image — Black Out Sensitive Info Free · Latch Tools"
  description="Black out names, numbers and sensitive details in an image or screenshot. The bars are baked into the pixels — nothing underneath. Runs in your browser, no upload."
  ogImage="/og/redact-image.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Redact Image</span>
        </nav>
        <h1>Redact sensitive details in an image</h1>
        <p>Black out names, account numbers, addresses, or signatures on a document, statement, ID, or screenshot. Draw a bar over each detail — the covered pixels are replaced for good, with nothing left underneath.</p>
        <TrustPill />
        <ul class="tool-features">
          <li>Solid black bars over anything sensitive</li>
          <li>Bars flattened into the pixels, not a layer on top</li>
          <li>The file never leaves your device</li>
        </ul>
      </div>

      <RedactWidget heading="Black out sensitive details" defaultEffect="blackout" applyLabel="Redact & download" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to redact an image</h2>
          <p class="sec-desc">Four steps, a few seconds, zero uploads.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Add your image</h4>
          <p>Drag the document, screenshot, or photo onto the editor, or click Browse. JPEG, PNG, and WebP are accepted.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Draw over each detail</h4>
          <p>Drag a black bar over every name, number, or line you want to hide. Add as many as you need.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Check the coverage</h4>
          <p>Make sure each bar fully covers the detail. Blackout replaces the covered pixels entirely — the strongest option.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Download</h4>
          <p>Save the result. The bars are flattened into the pixels, so nothing sensitive remains in the file.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY / SAFETY -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Are black bars actually safe?</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        You may have heard of redactions being undone — a black box lifted off a document to reveal the text beneath. That happens with <strong>PDFs and other layered documents</strong>, where drawing a box only adds a graphic on top while the original text stays in the file, ready to be copied out. It's a real and common mistake.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        This tool avoids it by working on <strong>pixels, not layers</strong>. When you export, the bar's pixels overwrite the originals and the whole image is flattened — there is no text, no layer, and no original detail hiding underneath. And because it all happens in your browser, the sensitive image is never uploaded. If you need to redact a PDF specifically, remember it must be flattened or rasterised first; a box drawn in a PDF editor is not enough.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">Is my image uploaded to a server?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">No. The image is opened, redacted, and re-saved entirely in your browser with the Canvas API. Nothing is uploaded, so even documents full of personal data stay on your device.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can the blacked-out content be recovered?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">No. A blackout bar replaces the covered pixels with solid colour and is flattened into the exported image — there is no original detail left underneath. It's the strongest of the three options: blur and pixelation obscure detail and can occasionally be reversed if applied too lightly, whereas a solid bar removes it outright.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">I've heard black-box redactions can be undone — is this safe?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">That failure happens with black boxes drawn over text in PDFs or other documents, where the text layer still exists underneath the graphic and can be copied out. This tool exports a flat raster image: the pixels themselves are overwritten, so there is no hidden text or layer beneath the bar. To redact a PDF safely you must flatten or rasterise it — drawing a box in a PDF editor is not enough.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I redact several things at once?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Draw a separate bar over each detail — there is no limit. You can move, resize, or delete any bar before you export.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Should I use blackout, blur, or pixelate?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Use blackout when the goal is certainty — an account number, an address, a name on an ID. If you'd rather show that something is present but hidden, such as a face in a photo, the <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">blur</a> and <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">pixelate</a> tools do that with a softer look.</p>
        </details>
      </div>

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">Blur part of an image</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
