---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "JPEG XL", "item": "https://latchtools.com/jpeg-xl/" }
      ]
    },
    {
      "@type": "TechArticle",
      "headline": "What is JPEG XL (JXL)?",
      "description": "JPEG XL (.jxl) explained: what the format is, why it won't open in most browsers, how it compares to AVIF, WebP, PNG and JPG, and how to convert .jxl files so you can view them anywhere.",
      "about": { "@type": "Thing", "name": "JPEG XL" },
      "url": "https://latchtools.com/jpeg-xl/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How do I open a .jxl file?",
          "acceptedAnswer": { "@type": "Answer", "text": "On a recent Apple device, Safari and the built-in Preview/Quick Look can open .jxl files directly. On Windows, Android, or in Chrome, Edge and Firefox, they usually won't open at all — the simplest fix is to convert the file to a format everything supports, such as JPG or PNG." }
        },
        {
          "@type": "Question",
          "name": "Is JPEG XL better than AVIF or WebP?",
          "acceptedAnswer": { "@type": "Answer", "text": "Technically JPEG XL matches or beats both on compression and adds features like lossless JPEG recompression and very high bit depth. In practice AVIF and WebP win today because they're supported in every major browser, while JPEG XL is not. For anything you need to share now, AVIF or WebP are the safer choice." }
        },
        {
          "@type": "Question",
          "name": "Do Chrome and Firefox support JPEG XL?",
          "acceptedAnswer": { "@type": "Answer", "text": "Not by default yet. Chrome removed JPEG XL in version 110 (early 2023), then added a new decoder back in Chrome 145 (February 2026) — but it's behind a flag and off by default, and Google may enable it by default later in 2026. Firefox 152 (June 2026) also shipped support, but disabled out of the box. So in a normal Chrome, Edge or Firefox install a .jxl file still won't display, and converting it to JPG or PNG remains the reliable fix." }
        },
        {
          "@type": "Question",
          "name": "Is JPEG XL lossless?",
          "acceptedAnswer": { "@type": "Answer", "text": "It can be both. JPEG XL supports a true lossless mode that stores every pixel exactly, and a lossy mode that trades some detail for much smaller files. It can also losslessly recompress an existing JPEG to roughly 20% smaller with no quality change." }
        },
        {
          "@type": "Question",
          "name": "Will JPEG XL replace JPEG?",
          "acceptedAnswer": { "@type": "Answer", "text": "That was the goal, and it may still happen over time — JPEG XL is royalty-free and technically strong. But adoption depends on browsers and operating systems shipping support. Until Chrome and Firefox enable it by default, JPEG remains the universal default." }
        },
        {
          "@type": "Question",
          "name": "How do I create a .jxl file?",
          "acceptedAnswer": { "@type": "Answer", "text": "You can encode an existing image to JPEG XL in your browser: PNG to JXL keeps transparency, and JPG to JXL re-encodes photos smaller. Because .jxl only opens in Safari and recent Apple devices today, it's best for storage or archiving rather than sharing." }
        }
      ]
    }
  ]
};
---
<Layout
  title="What Is JPEG XL (JXL)? Support & How to Open .jxl Files · Latch Tools"
  description="JPEG XL (.jxl) explained — what it is, why it won't open in most browsers, and how to convert a .jxl file to JPG or PNG so you can view it anywhere."
  ogImage="/og/jpeg-xl.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <main>
    <!-- HERO -->
    <section class="section" style="padding-bottom: 0">
      <div class="wrap" style="max-width: 780px">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">JPEG XL</span>
        </nav>
        <h1 style="font-family: var(--font-display); font-weight: 600; letter-spacing: -.035em; line-height: 1.06; font-size: clamp(32px, 5.2vw, 50px); margin: 18px 0 0; text-wrap: balance;">
          What is <span style="color: var(--accent)">JPEG XL</span> (JXL)?
        </h1>
        <p style="font-size: clamp(16px, 2.2vw, 18px); color: var(--text-2); max-width: 40em; margin: 20px 0 0; line-height: 1.7; text-wrap: pretty;">
          JPEG XL (file extension <code>.jxl</code>) is a modern image format built to
          succeed the original JPEG — smaller files, higher quality, and features JPEG never
          had. It's powerful, but barely supported, which is why a <code>.jxl</code> you
          downloaded may refuse to open. Here's what the format is, why it won't open, and how
          to convert it so you can actually use it.
        </p>
      </div>
    </section>

    <!-- CONVERSION DIRECTIONS -->
    <section class="section" style="padding-top: 44px; padding-bottom: 0">
      <div class="wrap" style="max-width: 780px">
        <h2 class="sec-title" style="font-size: 22px; margin-bottom: 16px">Convert a JPEG XL file, or create one</h2>
        <div class="hub-grid">
          <a class="hub-card" href="/jxl-to-jpg/">
            <span class="format-label">.jxl → .jpg</span>
            <h3>JPEG XL to JPG</h3>
            <span class="tool-arrow" aria-hidden="true">→</span>
            <p>Make a .jxl easy to open, share and upload anywhere.</p>
          </a>
          <a class="hub-card" href="/jxl-to-png/">
            <span class="format-label">.jxl → .png</span>
            <h3>JPEG XL to PNG</h3>
            <span class="tool-arrow" aria-hidden="true">→</span>
            <p>Convert to PNG for lossless output or transparency.</p>
          </a>
          <a class="hub-card" href="/jpg-to-jxl/">
            <span class="format-label">.jpg → .jxl</span>
            <h3>JPG to JPEG XL</h3>
            <span class="tool-arrow" aria-hidden="true">→</span>
            <p>Re-encode photos smaller at the same visual quality.</p>
          </a>
          <a class="hub-card" href="/png-to-jxl/">
            <span class="format-label">.png → .jxl</span>
            <h3>PNG to JPEG XL</h3>
            <span class="tool-arrow" aria-hidden="true">→</span>
            <p>Compress PNGs while keeping transparency intact.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- WHAT IT IS -->
    <section class="section">
      <div class="wrap" style="max-width: 780px">
        <h2 class="sec-title" style="margin-bottom: 16px">A next-generation image format</h2>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 16px;">
          JPEG XL was standardised (ISO/IEC 18181) and finalised around 2021 by the same
          committee behind the original JPEG. It's royalty-free and designed as a single format
          that does everything: it compresses photos roughly 20–60% smaller than JPEG at the
          same visual quality, and supports both a true lossless mode and an efficient lossy one.
        </p>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0;">
          Beyond size, it adds what JPEG lacked — full alpha transparency, animation, progressive
          loading, very high bit depth and wide colour gamut, and the ability to losslessly
          recompress an existing JPEG about 20% smaller with no quality change. On paper it's an
          excellent replacement. The catch is support.
        </p>
      </div>
    </section>

    <!-- WHY WON'T IT OPEN -->
    <section class="band section">
      <div class="wrap" style="max-width: 780px">
        <h2 class="sec-title" style="margin-bottom: 16px">Why won't my <code>.jxl</code> file open?</h2>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 16px;">
          Because most software still can't read it. As of 2026, browser and OS support looks
          like this:
        </p>
        <ul style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 16px; padding-left: 1.1em;">
          <li><strong>Safari (macOS &amp; iOS 17+):</strong> supported — Apple added JPEG XL in 2023, so it opens in Safari, Preview and Quick Look.</li>
          <li><strong>Chrome &amp; Edge:</strong> off by default — Chrome removed JPEG XL in version 110 (early 2023), then added a new decoder back in Chrome 145 (February 2026), but it stays behind a flag and is disabled by default. Google may switch it on by default later in 2026.</li>
          <li><strong>Firefox:</strong> off by default — Firefox 152 (June 2026) shipped JPEG XL support, but behind a setting that's turned off out of the box.</li>
          <li><strong>Windows, Android &amp; most editors:</strong> no native support without a plugin.</li>
        </ul>
        <p style="color:var(--text-3);font-family:var(--font-mono);font-size:13px;margin:0 0 16px;">Browser support — last checked August 2026</p>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0;">
          So unless you're on a recent Apple device, a <code>.jxl</code> file usually won't open
          at all. The reliable fix is to convert it to a format everything supports —
          <a href="/jxl-to-png/" style="color:var(--accent)">JXL to PNG</a> for a lossless copy
          with transparency, or <a href="/jxl-to-jpg/" style="color:var(--accent)">JXL to JPG</a>
          for a small file that opens anywhere.
        </p>
      </div>
    </section>

    <!-- COMPARISON -->
    <section class="section">
      <div class="wrap" style="max-width: 780px">
        <h2 class="sec-title" style="margin-bottom: 16px">JPEG XL vs AVIF, WebP, PNG and JPG</h2>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 20px;">
          How JPEG XL stacks up against the formats you'll actually convert it to:
        </p>
        <div class="table-scroll">
          <table class="cmp">
            <thead>
              <tr><th>Format</th><th>Compression</th><th>Lossless</th><th>Transparency</th><th>Browser support</th><th>Best for</th></tr>
            </thead>
            <tbody>
              <tr><th>JPEG XL</th><td data-label="Compression">Excellent</td><td data-label="Lossless">Yes</td><td data-label="Transparency">Yes</td><td data-label="Browser support">Safari; off by default in Chrome/FF</td><td data-label="Best for">Future-proofing, once supported</td></tr>
              <tr><th>AVIF</th><td data-label="Compression">Excellent</td><td data-label="Lossless">Limited</td><td data-label="Transparency">Yes</td><td data-label="Browser support">Wide</td><td data-label="Best for">Smallest modern web images</td></tr>
              <tr><th>WebP</th><td data-label="Compression">Very good</td><td data-label="Lossless">Yes</td><td data-label="Transparency">Yes</td><td data-label="Browser support">Universal</td><td data-label="Best for">General-purpose web use</td></tr>
              <tr><th>PNG</th><td data-label="Compression">Lossless only</td><td data-label="Lossless">Yes</td><td data-label="Transparency">Yes</td><td data-label="Browser support">Universal</td><td data-label="Best for">Graphics, transparency, exact copies</td></tr>
              <tr><th>JPG</th><td data-label="Compression">Good (lossy)</td><td data-label="Lossless">No</td><td data-label="Transparency">No</td><td data-label="Browser support">Universal</td><td data-label="Best for">Photos that open anywhere</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- HOW TO CONVERT (funnel) -->
    <section class="band section">
      <div class="wrap" style="max-width: 780px">
        <h2 class="sec-title" style="margin-bottom: 16px">How to open or convert a <code>.jxl</code> file</h2>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 16px;">
          Since most apps can't open JPEG XL, the practical answer is to convert it to something
          universal. Both tools below run entirely in your browser — your file is decoded locally
          and never uploaded to a server:
        </p>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 16px;">
          <strong>Need it to open anywhere, or to keep the file small?</strong> Use the
          <a href="/jxl-to-jpg/" style="color:var(--accent)">JXL to JPG converter</a>. JPG opens
          in virtually every app on every platform, with adjustable quality.
        </p>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 24px;">
          <strong>Need transparency, or a lossless copy for editing?</strong> Use
          <a href="/jxl-to-png/" style="color:var(--accent)">JXL to PNG</a> instead — PNG is
          lossless and preserves the alpha channel exactly.
        </p>
        <a href="/jxl-to-png/" class="btn btn-primary btn-lg">
          Convert a JXL file
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- HOW TO CREATE (encoders) -->
    <section class="band section">
      <div class="wrap" style="max-width: 780px">
        <h2 class="sec-title" style="margin-bottom: 16px">How to create a <code>.jxl</code> file</h2>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 16px;">
          Want to go the other way and encode <em>to</em> JPEG XL — say, to archive a photo library
          at a smaller size? These converters also run entirely in your browser, so your images are
          never uploaded. Just remember a <code>.jxl</code> file only opens in Safari and recent
          Apple devices today, so it's best for storage rather than sharing.
        </p>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 16px;">
          <strong>Starting from a photo?</strong> Use the
          <a href="/jpg-to-jxl/" style="color:var(--accent)">JPG to JXL converter</a> to re-encode
          JPGs smaller at the same visual quality.
        </p>
        <p style="color: var(--text-2); font-size: 16px; line-height: 1.7; margin: 0 0 24px;">
          <strong>Need transparency kept?</strong> Use
          <a href="/png-to-jxl/" style="color:var(--accent)">PNG to JXL</a> — it preserves the alpha
          channel while shrinking the file.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="wrap" style="max-width: 780px">
        <h2 class="sec-title" style="margin-bottom: 20px">Frequently asked</h2>

        <details class="faq-item">
          <summary class="faq-q">
            How do I open a .jxl file?
            <span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span>
          </summary>
          <p class="faq-a">On a recent Apple device, Safari and the built-in Preview/Quick Look open .jxl files directly. On Windows, Android, or in Chrome, Edge and Firefox they usually won't open at all — the simplest fix is to <a href="/jxl-to-jpg/" style="color:var(--accent)">convert it to JPG</a> or <a href="/jxl-to-png/" style="color:var(--accent)">to PNG</a>.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Is JPEG XL better than AVIF or WebP?
            <span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span>
          </summary>
          <p class="faq-a">Technically JPEG XL matches or beats both on compression and adds features like lossless JPEG recompression and very high bit depth. In practice AVIF and WebP win today because they work in every major browser and JPEG XL doesn't. For anything you need to share now, AVIF or WebP are the safer choice.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Do Chrome and Firefox support JPEG XL?
            <span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span>
          </summary>
          <p class="faq-a">Not by default yet. Chrome removed JPEG XL in version 110 (early 2023), then added a new decoder back in Chrome 145 (February 2026) — but it's behind a flag and off by default, and Google may enable it by default later in 2026. Firefox 152 (June 2026) also shipped support, but disabled out of the box. So in a normal Chrome, Edge or Firefox install a .jxl still won't display — <a href="/jxl-to-jpg/" style="color:var(--accent)">converting it to JPG</a> or <a href="/jxl-to-png/" style="color:var(--accent)">PNG</a> remains the reliable fix.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Is JPEG XL lossless?
            <span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span>
          </summary>
          <p class="faq-a">It can be both. JPEG XL supports a true lossless mode that stores every pixel exactly, and a lossy mode that trades some detail for much smaller files. It can also losslessly recompress an existing JPEG to roughly 20% smaller with no quality change.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Will JPEG XL replace JPEG?
            <span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span>
          </summary>
          <p class="faq-a">That was the goal, and it still might over time — JPEG XL is royalty-free and technically strong. But adoption depends on browsers and operating systems shipping support. Until Chrome and Firefox enable it by default, JPEG remains the universal default.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            How do I create a .jxl file?
            <span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span>
          </summary>
          <p class="faq-a">Encode an existing image to JPEG XL right in your browser — <a href="/png-to-jxl/" style="color:var(--accent)">PNG to JXL</a> keeps transparency, and <a href="/jpg-to-jxl/" style="color:var(--accent)">JPG to JXL</a> re-encodes photos smaller. Because <code>.jxl</code> only opens in Safari and recent Apple devices today, it's best for storage or archiving rather than sharing.</p>
        </details>
      </div>
    </section>

    <!-- RELATED TOOLS -->
    <section class="section" style="padding-top:0">
      <div class="wrap" style="max-width:980px">
        <div class="sec-head">
          <div>
            <h2 class="sec-title" style="font-size:22px">Related tools</h2>
          </div>
        </div>
        <div class="tool-grid" style="grid-template-columns:repeat(4,1fr)">
          <a href="/jxl-to-png/" class="tool-card">
            <div class="tool-ic" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
            </div>
            <div class="tool-name">JXL to PNG</div>
            <div class="tool-desc">Open a .jxl anywhere — convert it to a universal, lossless PNG.</div>
            <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
          </a>
          <a href="/jxl-to-jpg/" class="tool-card">
            <div class="tool-ic" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
            </div>
            <div class="tool-name">JXL to JPG</div>
            <div class="tool-desc">Turn a .jxl into a smaller, universally supported JPG.</div>
            <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
          </a>
          <a href="/png-to-jxl/" class="tool-card">
            <div class="tool-ic" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4M21.5 19.5v-4"/></svg>
            </div>
            <div class="tool-name">PNG to JXL</div>
            <div class="tool-desc">Encode a PNG to JPEG XL — transparency preserved.</div>
            <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
          </a>
          <a href="/jpg-to-jxl/" class="tool-card">
            <div class="tool-ic" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
            </div>
            <div class="tool-name">JPG to JXL</div>
            <div class="tool-desc">Re-encode a JPG to JPEG XL at the same visual quality.</div>
            <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .table-scroll {
    /* Clips the table's last-row border into the rounded corners; the table now
       fits at every width (it reflows to cards below the breakpoint), so no
       horizontal scroll is needed. */
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
  }
  .cmp {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }
  .cmp th,
  .cmp td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  .cmp thead th,
  .cmp tbody th {
    white-space: nowrap;
  }
  .cmp thead th {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-2);
    background: var(--surface-2, rgba(127, 127, 127, 0.06));
