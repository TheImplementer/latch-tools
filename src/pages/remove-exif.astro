---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Remove EXIF", "item": "https://latchtools.com/remove-exif/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Remove EXIF Data from Photos",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Strip GPS location, camera info, and all EXIF metadata from JPEG, PNG, and WebP files directly in your browser. No uploads required.",
      "url": "https://latchtools.com/remove-exif/"
    },
    {
      "@type": "HowTo",
      "name": "How to remove EXIF data from a photo",
      "step": [
        { "@type": "HowToStep", "name": "Add your photos", "text": "Drag photos onto the drop zone, or click Browse to pick them from your device." },
        { "@type": "HowToStep", "name": "We scan the metadata", "text": "Latch reads what EXIF data is present — GPS coordinates, camera make and model, date taken, and more." },
        { "@type": "HowToStep", "name": "Strip everything in one click", "text": "Click 'Strip metadata' and all EXIF, IPTC, and XMP data is removed by re-encoding the image through the browser's Canvas API." },
        { "@type": "HowToStep", "name": "Download the clean copy", "text": "Save your metadata-free photo. The original on your device is untouched." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is EXIF data?",
          "acceptedAnswer": { "@type": "Answer", "text": "EXIF (Exchangeable Image File Format) is metadata embedded in photo files by cameras and phones. It can include GPS coordinates showing exactly where a photo was taken, the camera make and model, lens settings, the date and time, and sometimes even the device's serial number." }
        },
        {
          "@type": "Question",
          "name": "Does removing EXIF data affect image quality?",
          "acceptedAnswer": { "@type": "Answer", "text": "For JPEG photos the tool re-encodes at 99% quality, which is visually identical to the original. PNG images are re-encoded losslessly. The pixel content of the image is unchanged." }
        },
        {
          "@type": "Question",
          "name": "Are my photos uploaded anywhere?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Everything happens in your browser using the Canvas API. Your photos never leave your device — which is rather fitting for a privacy tool." }
        },
        {
          "@type": "Question",
          "name": "What metadata is removed?",
          "acceptedAnswer": { "@type": "Answer", "text": "All of it. The Canvas API re-encodes only pixel data, discarding all EXIF fields (GPS, camera info, dates, settings), as well as IPTC and XMP metadata." }
        },
        {
          "@type": "Question",
          "name": "Why should I remove EXIF data before sharing photos?",
          "acceptedAnswer": { "@type": "Answer", "text": "Photos taken on a smartphone contain the precise GPS coordinates of where they were shot. Sharing a photo publicly — on social media, a forum, or via email — can inadvertently reveal your home address, workplace, or travel habits to anyone who looks at the file metadata." }
        },
        {
          "@type": "Question",
          "name": "Can someone track my location from a photo?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes — if your photo has GPS metadata embedded. When a photo is taken on a smartphone with location services enabled, the precise coordinates (latitude and longitude) are stored in the EXIF data. Anyone who receives the original file can extract those coordinates using free online tools and map them to a street address." }
        },
        {
          "@type": "Question",
          "name": "How do I remove metadata from a photo on iPhone or Android?",
          "acceptedAnswer": { "@type": "Answer", "text": "The easiest way is to use a browser-based tool like this one — drag in your photo and download the clean version. Both iPhone and Android can be set to strip location data when sharing via the native share sheet, but that only removes GPS and may leave other EXIF fields intact. For complete metadata removal, re-encoding through a dedicated tool is the most reliable method." }
        },
        {
          "@type": "Question",
          "name": "Do social media sites remove EXIF data automatically?",
          "acceptedAnswer": { "@type": "Answer", "text": "Most major platforms — Instagram, Facebook, Twitter/X — strip EXIF data when you upload a photo. But messaging apps like WhatsApp and iMessage often pass EXIF through intact, and email attachments always preserve it. Removing metadata before sharing is the only way to be certain it's gone." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between EXIF, IPTC, and XMP metadata?",
          "acceptedAnswer": { "@type": "Answer", "text": "All three are metadata standards embedded in image files. EXIF is written by cameras and phones: GPS, date, camera model, lens settings. IPTC is used by photographers and agencies for descriptive data: captions, keywords, copyright. XMP is an Adobe standard recording editing history and adjustments. This tool strips all three." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Remove EXIF Data from Photos — Free, Private, No Upload · Latch Tools"
  description="Strip GPS location, camera model, and timestamps from JPEG and PNG photos. Runs entirely in your browser — your files never leave your device."
  ogImage="/og/remove-exif.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <!-- TOOL HERO + WIDGET -->
  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Remove EXIF</span>
        </nav>
        <h1>Remove EXIF metadata from photos</h1>
        <p>Strip GPS location, camera details, and all hidden data from your photos — right in your browser. The pixel content stays identical.</p>
        <TrustPill />
        <ul class="tool-features">
          <li>Removes GPS, camera info, and all metadata</li>
          <li>Pixel content stays completely identical</li>
          <li>Supports JPEG, PNG, and WebP</li>
        </ul>
      </div>

      <!-- WIDGET -->
      <div class="widget" id="widget" role="region" aria-label="Remove EXIF metadata">
        <div class="widget-head">
          <span class="wt" style="font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:-.01em" id="widget-title">
            Strip your photos
          </span>
          <span class="fmt-pill" aria-hidden="true">
            <span class="from">EXIF</span>
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            <span class="to">Clean</span>
          </span>
        </div>

        <!-- STATE: empty / drag -->
        <div id="state-drop" class="widget-state">
          <div
            class="dropzone"
            id="dropzone"
            role="button"
            tabindex="0"
            aria-label="Drop photo files here or click to browse"
            aria-describedby="dz-hint"
          >
            <div class="dz-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5m0 0L8 9m4-4l4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
            </div>
            <p class="dz-title" id="dz-title">Drag &amp; drop your photos</p>
            <p class="dz-or" aria-hidden="true">or</p>
            <button class="btn btn-secondary" type="button" id="browse-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Browse files
            </button>
            <p class="dz-hint" id="dz-hint">Accepts JPEG, PNG, WebP · up to 10 files, 50 MB each</p>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Processing happens right here in your browser — nothing is uploaded.
          </div>
        </div>

        <!-- STATE: selected -->
        <div id="state-selected" class="widget-state" hidden>
          <div class="filelist" id="filelist" aria-live="polite" aria-label="Selected files"></div>
          <div class="exif-note">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="8" r="6"/><path d="M8 7v4M8 5.5v.5"/></svg>
            All EXIF, GPS, and embedded metadata will be stripped. Pixel content is unchanged.
          </div>
          <div class="actions">
            <button class="btn btn-primary grow" type="button" id="convert-btn">
              Strip metadata
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            </button>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            These photos stay on your device the entire time.
          </div>
        </div>

        <!-- STATE: processing -->
        <div id="state-processing" class="widget-state" hidden>
          <div class="proc">
            <div class="proc-row">
              <div class="spinner" role="status" aria-label="Stripping metadata"></div>
              <div>
                <div class="pt">Stripping metadata</div>
                <div class="ps" id="proc-status" aria-live="polite"></div>
              </div>
            </div>
            <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="progress-bar">
              <i id="progress-fill" style="width:0%"></i>
            </div>
            <div class="proc-pct">
              <span id="proc-pct">0%</span>
              <span>Working locally — nothing uploaded</span>
            </div>
          </div>
          <div class="actions">
            <button class="btn btn-ghost grow" type="button" id="cancel-btn">Cancel</button>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Your browser is doing the work — no file has been sent anywhere.
          </div>
        </div>

        <!-- STATE: done -->
        <div id="state-done" class="widget-state" hidden>
          <div class="result-head">
            <span class="result-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <div>
              <div class="rt" id="done-title">All done</div>
              <div class="rs">Metadata stripped · stayed on your device the whole time</div>
            </div>
          </div>
          <div class="filelist" id="results-list" aria-live="polite" aria-label="Cleaned files"></div>
          <div class="actions">
            <button class="btn btn-secondary" type="button" id="convert-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8M20 4v4h-4"/></svg>
              Strip another
            </button>
            <button class="btn btn-primary grow" type="button" id="download-all-btn">
              <span id="download-all-label">Download</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"/><path d="M5 19h14"/></svg>
            </button>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Close this tab and every file is gone — nothing was kept.
          </div>
        </div>

        <!-- STATE: error -->
        <div id="state-error" class="widget-state" hidden>
          <div class="err-head">
            <span class="err-badge" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"/><circle cx="12" cy="16.4" r=".4" fill="currentColor"/><path d="M10.3 4.2L3.4 16a2 2 0 0 0 1.7 3h13.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"/></svg>
            </span>
            <div>
              <div class="et" id="err-title">We couldn't process that file</div>
              <div class="es" id="err-message"></div>
            </div>
          </div>
          <div class="filelist" id="error-list" aria-live="assertive"></div>
          <div class="actions">
            <button class="btn btn-secondary" type="button" id="remove-continue-btn">Remove &amp; continue</button>
            <button class="btn btn-primary grow" type="button" id="try-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Try another file
            </button>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            The file stayed on your device — even when something goes wrong.
          </div>
        </div>
      </div>
      <!-- hidden file input -->
      <input type="file" id="file-input" accept=".jpg,.jpeg,image/jpeg,.png,image/png,.webp,image/webp" multiple hidden aria-hidden="true" />
    </div>
  </section>

  <!-- WHAT'S HIDDEN IN YOUR PHOTOS -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">What's hidden in your photos?</h2>
          <p class="sec-desc">Modern smartphones embed far more than you might expect. Here's what anyone with the right tool can read from an unstripped image.</p>
        </div>
      </div>
      <div class="howto" style="grid-template-columns:repeat(3,1fr)">
        <div class="howto-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          <h4>GPS coordinates</h4>
          <p>Your exact latitude and longitude — often precise enough to identify your home address or place of work.</p>
        </div>
        <div class="howto-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          <h4>Date &amp; time</h4>
          <p>The exact timestamp the photo was taken — which, combined with GPS, can reveal your routines and travel patterns.</p>
        </div>
        <div class="howto-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
          <h4>Device make &amp; model</h4>
          <p>The brand and model of your phone or camera — which can identify the device and sometimes correlate across photos.</p>
        </div>
        <div class="howto-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3m10 0h3a2 2 0 0 0 2-2v-3"/><path d="M9 12h6M12 9v6"/></svg>
          <h4>Software &amp; OS version</h4>
          <p>The app used to edit or shoot the photo, plus the operating system version — useful for fingerprinting a device.</p>
        </div>
        <div class="howto-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
          <h4>Camera settings</h4>
          <p>Aperture, shutter speed, ISO, focal length, and flash mode — the full technical fingerprint of the shot.</p>
        </div>
        <div class="howto-step">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <h4>Embedded thumbnail</h4>
          <p>A tiny copy of the original, unedited image is often stored inside the file — even if you cropped or filtered the photo before sharing.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO SHOULD REMOVE EXIF -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Who should remove EXIF data?</h2>
          <p class="sec-desc">Most people are unaware their photos carry this data. Here are the groups most at risk.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Online sellers</h4>
          <p>Listing on eBay, Etsy, or Facebook Marketplace? Photos taken at home embed your address. Strip the metadata before you post.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Journalists &amp; activists</h4>
          <p>Sharing images of sensitive subjects or locations? GPS data can betray sources and put people at risk. Remove it first.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Social media users</h4>
          <p>Platforms may strip metadata when you upload, but the original file you share directly — via DM, email, or link — often passes EXIF through intact.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Anyone sharing privately</h4>
          <p>WhatsApp, iMessage, and email attachments frequently preserve EXIF. If you're sending original photos, assume the metadata goes with them.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to remove EXIF data from a photo</h2>
          <p class="sec-desc">Four steps, a few seconds, zero uploads.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Add your photos</h4>
          <p>Drag photos onto the box above, or click Browse. JPEG, PNG, and WebP are all accepted. Up to 50 at once.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>We scan the metadata</h4>
          <p>Latch reads the EXIF data present in each file — GPS coordinates, camera make and model, date taken, software, and more.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Strip everything in one click</h4>
          <p>The browser re-encodes the image through its Canvas API, which only copies pixel data — all EXIF, IPTC, and XMP metadata is discarded automatically.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Download the clean copy</h4>
          <p>Save your metadata-free photo. Your original file on your device is completely untouched.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY REMOVE EXIF -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Why remove EXIF data?</h2>
        </div>
      </div>
      <p style="color:var(--text-2);line-height:1.7;margin-bottom:16px">
        Every photo taken on a smartphone contains precise GPS coordinates showing exactly where the shot was taken. Share that photo publicly — on social media, a forum, a property listing, or via email — and anyone who inspects the file can extract your home address, workplace, or travel route.
      </p>
      <p style="color:var(--text-2);line-height:1.7;margin-bottom:16px">
        Beyond GPS, EXIF data includes the camera make and model (which can identify the device), the date and time, lens settings, and sometimes even a serial number. Stripping it before sharing is a simple habit with a meaningful privacy benefit.
      </p>
      <p style="color:var(--text-2);line-height:1.7">
        Common use cases: posting photos to public forums or social media, sending images to people you don't fully trust, submitting photos for competitions or publications, listing a property for sale, or simply keeping your metadata your own business.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">
            What is EXIF data?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">EXIF (Exchangeable Image File Format) is metadata embedded in photo files by cameras and phones. It can include GPS coordinates, the camera make and model, lens settings, date and time, and sometimes even the device's serial number.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Does removing EXIF data affect image quality?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">For JPEG photos the tool re-encodes at 99% quality, which is visually identical to the original. PNG images are re-encoded losslessly. The pixel content is unchanged in both cases.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Are my photos uploaded anywhere?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">No. Everything happens in your browser using the Canvas API. Your photos never leave your device — which is rather fitting for a privacy tool.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            What metadata is removed?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">All of it. The Canvas API re-encodes only pixel data, discarding all EXIF fields (GPS, camera info, dates, lens settings), IPTC metadata (captions, keywords, copyright), and XMP metadata (editing history, colour profiles).</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Why should I remove EXIF data before sharing photos?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Photos taken on a smartphone contain precise GPS coordinates of where they were shot. Sharing a photo publicly — on social media, a forum, or via email — can inadvertently reveal your home address, workplace, or travel habits to anyone who inspects the file metadata.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Can someone track my location from a photo I shared?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Yes — if the original file has GPS metadata embedded. When a photo is taken on a smartphone with location services enabled, the precise coordinates are stored in the EXIF data. Anyone who receives that file can extract the coordinates using free tools and resolve them to a street address. Most people share photos without ever knowing this data is there.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Do social media sites like Instagram remove EXIF automatically?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Most major platforms — Instagram, Facebook, Twitter/X — strip EXIF when photos are uploaded to their servers. But this doesn't help when you share the original file directly: messaging apps like WhatsApp and iMessage often pass EXIF through intact, and email attachments always preserve it. Stripping before sharing is the only reliable approach.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            How is this different from just screenshotting my photo?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">A screenshot does remove all original EXIF (since it creates a new image file) but it also reduces quality significantly, often adding compression artefacts and losing fine detail. This tool re-encodes the image at 99% quality for JPEG and losslessly for PNG, so the result is indistinguishable from the original — just without the metadata.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Can I remove EXIF from iPhone HEIC photos?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">This tool accepts JPEG, PNG, and WebP. iPhone photos in HEIC format need to be converted first — use our <a href="/heic-to-jpg/" style="color:var(--accent)">HEIC to JPG converter</a> to get a JPEG, then strip the metadata here. Both steps happen entirely in your browser.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- RELATED TOOLS -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Related tools</h2>
        </div>
      </div>
      <div class="tool-grid" style="grid-template-columns:repeat(3,1fr)">
        <a href="/heic-to-jpg/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          </div>
          <div class="tool-name">HEIC to JPG</div>
          <div class="tool-desc">Convert iPhone HEIC photos to JPEG — then strip the metadata here.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/webp-to-png/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
          </div>
          <div class="tool-name">WebP to PNG</div>
          <div class="tool-desc">Convert WebP images to PNG format, fully in-browser with no quality loss.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/resize-image/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
          </div>
          <div class="tool-name">Resize Image</div>
          <div class="tool-desc">Resize photos to exact pixel dimensions or for passport and visa requirements.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
