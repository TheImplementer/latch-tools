---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blur License Plate", "item": "https://latchtools.com/blur-license-plate/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Blur License Plate",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Blur a license plate in a photo before selling a car or posting online. Runs in your browser, so the photo is never uploaded.",
      "url": "https://latchtools.com/blur-license-plate/"
    },
    {
      "@type": "HowTo",
      "name": "How to blur a license plate in a photo",
      "step": [
        { "@type": "HowToStep", "name": "Add your photo", "text": "Drag the vehicle photo onto the editor, or click Browse to select it." },
        { "@type": "HowToStep", "name": "Draw over the plate", "text": "Drag a box over the number plate. Add more boxes for any other plates in the shot." },
        { "@type": "HowToStep", "name": "Check the strength", "text": "The blur starts at full strength because plates are short and easy to guess. Check that no character is legible before you download." },
        { "@type": "HowToStep", "name": "Download the result", "text": "Save the image. The plate is obscured in the exported pixels and cannot be read back." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is the photo uploaded anywhere?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The photo is edited entirely in your browser with the Canvas API and is never sent to a server. Nothing about your vehicle or location leaves your device." }
        },
        {
          "@type": "Question",
          "name": "Why blur a license plate before posting?",
          "acceptedAnswer": { "@type": "Answer", "text": "A plate can be used to look up or infer details about a vehicle and its owner, and it appears in car-sale listings, dashcam footage, and street photos. Blurring it before you publish keeps that identifier out of public view." }
        },
        {
          "@type": "Question",
          "name": "Can the plate number be recovered from the blurred image?",
          "acceptedAnswer": { "@type": "Answer", "text": "Not if you obscure it thoroughly. The blur is written into the exported pixels at full resolution. It is not a separate layer that could be removed. Use a high strength so no characters are legible. A light blur over a few large characters can sometimes be reversed, so check that every character on the plate is unreadable. If the plate matters, use a solid blackout. It is the only option that cannot be reversed at all." }
        },
        {
          "@type": "Question",
          "name": "Can I blur several plates in one photo?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Draw a box over each plate, as many as the photo needs. You can also use it on faces, house numbers, or anything else in the same shot." }
        },
        {
          "@type": "Question",
          "name": "Does it work on a phone?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. The editor is touch-friendly, so you can draw and adjust the box with your finger. That's handy when you're photographing a car to sell." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Blur a License Plate — Free & Private · Latch Tools"
  description="Blur a license plate before selling a car or posting a photo online. Runs entirely in your browser, and the photo is never uploaded."
  ogImage="/og/blur-license-plate.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Blur License Plate</span>
        </nav>
        <h1>Blur a license plate</h1>
        <p>Hide the number plate before you sell a car, share a dashcam still, or post a street photo. Draw a box over it, download the copy, and post that one instead.</p>
        <TrustPill />
      </div>

      <RedactWidget heading="Blur a license plate" defaultEffect="blur" applyLabel="Blur & download" defaultStrength={5} />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to blur a license plate</h2>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Add your photo</h4>
          <p>Drag the vehicle photo onto the editor, or click Browse. JPEG, PNG, and WebP are accepted.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Draw over the plate</h4>
          <p>Drag a box over the number plate. Add more boxes for any other plates in the shot.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Check the strength</h4>
          <p>The blur starts at full strength, because plates are short and easy to guess. Make sure no character is legible.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Download</h4>
          <p>Save the result. The plate is obscured in the exported pixels and can't be read back.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY / PRIVACY -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Why hide a number plate?</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        A license plate is a unique identifier tied to a vehicle and, often, to a person. It turns up in the places we share most freely, such as a car for sale on a marketplace, a dashcam clip of a near-miss, or a holiday photo with traffic in the background. Once that plate is public it can be used to look up or infer more than you'd like, so take it out of the photo before you post.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        Because this runs in your browser, the photo of your car and wherever it was parked never touches a server. And the blur is permanent: it's composited into the exported pixels at full resolution, so there's no crisp original underneath. Plates are short and predictable, so use a strong setting and check that not a single character is legible before you share.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">Is the photo uploaded anywhere?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">No. The photo is edited entirely in your browser with the Canvas API and is never sent to a server. Nothing about your vehicle or location leaves your device.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Why blur a license plate before posting?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">A plate can be used to look up or infer details about a vehicle and its owner, and it appears in car-sale listings, dashcam footage, and street photos. Blurring it before you publish keeps that identifier out of public view.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can the plate number be recovered from the blurred image?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Not if you obscure it thoroughly. The blur is written into the exported pixels at full resolution. It is not a separate layer that could be removed. Use a high strength so no characters are legible. A light blur over a few large characters can sometimes be reversed, so check that every character on the plate is unreadable. For the full picture, see <a href="/unblur-license-plate/" style="color:var(--accent)">can a blurred license plate be unblurred?</a></p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I blur several plates in one photo?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Draw a box over each plate, as many as the photo needs. You can also use it on faces, house numbers, or anything else in the same shot.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does it work on a phone?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. The editor is touch-friendly, so you can draw and adjust the box with your finger. That's handy when you're photographing a car to sell.</p>
        </details>
      </div>

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">Blur part of an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>

      <p class="muted" style="font-size:14px;margin-top:12px">
        Before you post it, read <a href="/unblur-license-plate/" style="color:var(--accent-text);font-weight:600">can a blurred license plate be unblurred?</a> It explains when a blur is too light to hold and what to use instead.
      </p>
    </div>
  </section>

  <Footer />
</Layout>
