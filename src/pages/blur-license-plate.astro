---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';
import HowToSteps from '../components/HowToSteps.astro';
import FaqList from '../components/FaqList.astro';
import { howToSchema, faqSchema, type Step, type Faq } from '../lib/guide';

// This page's job: the car listing. Several photos of one car, the plate in
// most of them, so the batch and "Copy boxes to all" lead. The other image
// redaction pages each have their own job; see blur-image.astro for the map.
const steps: Step[] = [
  { name: 'Add every photo', text: 'Drop all the listing photos on the editor at once, up to 30. JPEG, PNG and WebP all work.' },
  { name: 'Box the plate once', text: 'On the first photo, drag a box over the number plate, with a little margin on every side.' },
  { name: 'Copy it to the rest', text: 'Press <em>Copy boxes to all</em>, then step through the photos. Where the car sits differently in the frame, drag the box back onto the plate.' },
  { name: 'Download and check', text: 'Press <em>Blur &amp; download</em>. A batch saves as one zip. Open a photo at full size and make sure no character can be read.' },
];

const faqs: Faq[] = [
  {
    q: 'Do I need to blur my number plate when selling a car?',
    a: 'Nothing says you must, and plenty of listings show the plate. Sellers hide it mostly because of plate cloning, where someone has copies of a real plate made for a car of the same make and colour, and the fines and tolls go to the real owner. Others would rather not link their car, and the street it is parked on, to a public listing. It takes a minute either way.',
  },
  {
    q: 'Can I blur the plate in all my listing photos at once?',
    a: 'Yes. Add up to 30 photos, box the plate on one, and press <em>Copy boxes to all</em>. Then fix any photo where the plate sits somewhere else in the frame. They download together as a zip.',
  },
  {
    q: 'Is a blur enough, or should I black the plate out?',
    a: 'A plate is the hardest thing to blur safely. It is a short string from a fixed alphabet in a standard typeface, so someone can try each candidate, blur it the same way and compare. That is why this page starts at full strength. For a photo that matters, a solid bar from <a href="/redact-image/">Redact image</a> leaves nothing to compare against. <a href="/unblur-license-plate/">Can a blurred license plate be unblurred?</a> explains how the matching works.',
  },
  {
    q: 'Does it work on dashcam footage?',
    a: 'It works on still images, not video. Pause the clip on the frame you want to share, save that frame or take a screenshot, and blur the plate in that.',
  },
  {
    q: 'Does it work on a phone?',
    a: 'Yes. The editor works with touch, and you can add a batch of photos from the camera roll the same way as on a computer.',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blur License Plate", "item": "https://latchtools.com/blur-license-plate/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Blur License Plate",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Blur the license plate or number plate in a batch of car photos: box it once, copy the box to every photo, and download them together. Runs in your browser.",
      "url": "https://latchtools.com/blur-license-plate/"
    },
    howToSchema('How to blur a number plate in a batch of car photos', steps),
    faqSchema(faqs),
  ]
};
---
<Layout
  title="Blur a License Plate or Number Plate in Photos · Latch Tools"
  description="Blur the number plate in every photo of a car listing at once: box it on one, copy the box to the rest, download a zip. Runs in your browser."
  ogImage="/og/blur-license-plate.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Blur License Plate</span>
        </nav>
        <h1>Blur a license plate</h1>
        <p>Hide the number plate in a car listing, a dashcam still or a street photo. Box it on one photo, copy the box to the rest of the batch, and download them all together.</p>
        <TrustPill />
      </div>

      <RedactWidget heading="Blur a license plate" defaultEffect="blur" applyLabel="Blur & download" defaultStrength={5} />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to blur a number plate in every photo</h2>
        </div>
      </div>
      <HowToSteps steps={steps} />
    </div>
  </section>

  <!-- BATCH -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">One box for the whole listing</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        A car listing is rarely one photo. You walk round the car taking the front, the back, both sides and the interior, and the plate is in half of them, in roughly the same place each time if you held the phone at the same height. The editor stores each box as a position on the photo rather than in pixels, so <em>Copy boxes to all</em> puts it on the same spot in every shot, whatever size each one is. You only adjust the photos where the plate moved.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        Treat the copy as a starting point. A box that is slightly off leaves the edge of a character showing, and a plate is short enough that one or two characters narrow down the rest. The strip of thumbnails shows how many boxes each photo has, so a photo with none stands out before you download.
      </p>

      <h3 style="font-size:17px;margin-top:26px">Why it doesn't find plates by itself</h3>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:10px">
        <a class="prose-link" href="/blur-face/">Blur face</a> finds faces for you, with a detection model that runs in your browser. We tried the same thing for plates with an openly licensed plate detector, trained mostly on Chinese plates. In our test photos it found none of 9 US plates and 8 of 24 UK ones. A tool that finds some plates is worse than one that finds none, because it teaches you to stop checking. So plates are boxed by hand, and the batch copy does the repetitive part.
      </p>
    </div>
  </section>

  <!-- WHAT ELSE -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">What else in a car photo gives you away</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        The plate is the obvious one. Before you post, look over each photo for these as well. The same editor blurs them; draw another box.
      </p>
      <ul class="check-list">
        <li><strong>Your house.</strong> A car photographed on the drive shows the house number, the front door and often the street sign. Box them, or move the car somewhere neutral.</li>
        <li><strong>The VIN.</strong> Many cars show the vehicle identification number through the bottom of the windscreen. A serious buyer can ask for it in a message.</li>
        <li><strong>Stickers and permits.</strong> A residents' parking permit names your area, and dealer stickers and toll tags can carry an account number.</li>
        <li><strong>Reflections.</strong> Glossy paint and windows reflect the photographer and the houses opposite.</li>
        <li><strong>The logbook.</strong> If you photograph the V5C, black out its 11-digit document reference number, which is what is needed to tax the car online. <a class="prose-link" href="/redact-image/">Redact image</a> does that with a solid bar.</li>
        <li><strong>The file itself.</strong> Phone photos record the GPS position they were taken at, which for a car on the drive is your home. The copies you download here are re-saved in the browser and carry no location or camera details.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <FaqList faqs={faqs} />

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">Blur part of an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
