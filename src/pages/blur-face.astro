---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';
import HowToSteps from '../components/HowToSteps.astro';
import FaqList from '../components/FaqList.astro';
import { howToSchema, faqSchema, type Step, type Faq } from '../lib/guide';

// This page's job: people in photos. It is the only image page that finds
// what to hide by itself (on-device face detection), so that leads, followed
// by what identifies someone besides their face.
const steps: Step[] = [
  { name: 'Add your photos', text: 'Drag your images onto the editor, or click Browse. JPEG, PNG and WebP are accepted, up to 30 at a time.' },
  { name: 'Find the faces', text: 'Click <em>Find faces</em> to detect them across every photo, on your device.' },
  { name: 'Check what it missed', text: 'Look for small, turned or shadowed faces and draw a box over each. Move, resize or delete any box you don\'t want.' },
  { name: 'Set the strength and download', text: 'Raise the strength until no features remain, then download. A batch saves as one zip.' },
];

const faqs: Faq[] = [
  {
    q: 'Does it find every face?',
    a: 'No. Treat the finder as a first pass. It is good at faces that are reasonably large and facing the camera, and it can miss faces that are small, turned away, in deep shadow or partly covered. Check every photo and draw a box over anything it missed before you share it.',
  },
  {
    q: 'Does the face detection run on a server?',
    a: 'No. The detection model downloads to your browser the first time you click <em>Find faces</em>, then runs on your device. The photo, the faces it finds and their positions never leave it. Most tools that blur faces automatically upload the photo to do the detection.',
  },
  {
    q: 'Can a blurred face be unblurred?',
    a: 'Not the way a license plate can. A plate can be recovered by trying every possible plate, because the list of candidates is short. A face cannot be listed like that. Two things do work against a light blur, though. AI "unblur" tools paint in a plausible face, which is invented rather than recovered but can still look like the person. And researchers have shown that face recognition trained on blurred photos can match a lightly blurred face to a known person. Use the top strength on anyone who must not be recognised.',
  },
  {
    q: 'How much should I blur a face?',
    a: 'Turn the strength up until no features are recognisable. Small or low-resolution faces need the strongest setting. If you would rather use blocks or a solid bar than a soft blur, <a href="/pixelate-image/">Pixelate image</a> and <a href="/redact-image/">Redact image</a> do the same job with a different look.',
  },
  {
    q: 'Can I blur faces in a whole batch of photos?',
    a: 'Yes, up to 30 at once. <em>Find faces</em> scans each photo in turn, and the thumbnail strip shows how many boxes each one got, so a photo where it found nothing stands out for a closer look.',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Blur Face", "item": "https://latchtools.com/blur-face/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Blur Faces in Photos",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Find and blur faces in photos with face detection that runs on your device. The photo is never uploaded.",
      "url": "https://latchtools.com/blur-face/"
    },
    howToSchema('How to blur faces in a photo', steps),
    faqSchema(faqs),
  ]
};
---
<Layout
  title="Blur Faces in Photos — Free & Private · Latch Tools"
  description="Find and blur faces in your photos automatically, with face detection that runs on your device. Check what it found, then download. Nothing is uploaded."
  ogImage="/og/blur-face.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Blur Face</span>
        </nav>
        <h1>Blur faces in a photo</h1>
        <p>Hide faces before you post, whether they belong to bystanders, children, or anyone who didn't agree to be shared. Find the faces automatically, check the boxes, and download. The face detection runs on your device too.</p>
        <TrustPill />
      </div>

      <RedactWidget heading="Blur a face" defaultEffect="blur" applyLabel="Blur & download" detect="face" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to blur a face</h2>
        </div>
      </div>
      <HowToSteps steps={steps} />
    </div>
  </section>

  <!-- DETECTION -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Face detection that happens on your device</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        Automatic face detection normally means an upload. You send the photo to a server, it finds the faces, and it sends coordinates back. For a privacy tool that is an odd arrangement, because you have disclosed the image you were trying to protect to a company whose retention policy you have to take on trust.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        On this page, clicking <em>Find faces</em> downloads a small open-source detection model (<a href="https://github.com/opencv/opencv_zoo/tree/main/models/face_detection_yunet" rel="noopener" style="color:var(--accent-text);font-weight:600">YuNet</a>, from the OpenCV Zoo) into your browser once, and every photo after that is scanned locally. No pixels, face coordinates or thumbnails are transmitted. A batch works the same way, with 30 photos scanned one after another on the device.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        On-device detection has limits. It is a first pass and can't promise to catch every face. It reliably finds faces that are reasonably large and facing the camera, and it will miss some that are small, turned away, or in shadow. Treat the boxes it draws as a starting point and check every photo before you share it. Each box stays editable for that reason, and nothing is exported until you press the button yourself.
      </p>
    </div>
  </section>

  <!-- BEYOND THE FACE -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">What identifies someone besides their face</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        People who know someone recognise far more than a face. When the point is that a child, a witness or a colleague can't be identified, look over the rest of the photo as well, and box anything on this list.
      </p>
      <ul class="check-list">
        <li><strong>Names on clothing.</strong> Name badges, lanyards, a school uniform's crest, a team shirt with a name on the back.</li>
        <li><strong>Distinctive features.</strong> Tattoos, a hairstyle, a wheelchair or a bike that people around them would know.</li>
        <li><strong>Reflections.</strong> Glasses, windows and mirrors can show a second, unblurred copy of a face.</li>
        <li><strong>The setting.</strong> A school gate, a house number or a car's plate can place someone as precisely as their face. <a class="prose-link" href="/blur-license-plate/">Blur license plate</a> covers cars.</li>
        <li><strong>The file name.</strong> The download keeps your file name, with <code>-blurred</code> added. A photo called <code>emma-school-play.jpg</code> names the person you blurred, so rename it before you share.</li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <FaqList faqs={faqs} />

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">Blur part of an image</a> · <a href="/pixelate-image/" style="color:var(--accent-text);font-weight:600">Pixelate an image</a> · <a href="/blur-license-plate/" style="color:var(--accent-text);font-weight:600">Blur a license plate</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
