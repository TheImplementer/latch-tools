---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "PNG to JPG", "item": "https://latchtools.com/png-to-jpg/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "PNG to JPG Converter",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Convert PNG images to JPG, or JPG to PNG, in the browser without uploading anything.",
      "url": "https://latchtools.com/png-to-jpg/"
    },
    {
      "@type": "HowTo",
      "name": "How to convert PNG to JPG",
      "step": [
        { "@type": "HowToStep", "name": "Add your PNG files", "text": "Drag PNG images onto the drop zone, or click Browse to pick them from your device." },
        { "@type": "HowToStep", "name": "Set the quality and background", "text": "Choose a JPG quality level (default 92%) and a background colour to fill any transparent areas." },
        { "@type": "HowToStep", "name": "Download your JPGs", "text": "Download each one on its own, or all of them in a single zip." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Are my images uploaded anywhere?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Conversion happens entirely in your browser using the Canvas API. Nothing is sent to a server, and the tool keeps working offline once the page has loaded." }
        },
        {
          "@type": "Question",
          "name": "What happens to transparent areas when converting PNG to JPG?",
          "acceptedAnswer": { "@type": "Answer", "text": "JPG has no transparency, so those areas need a background colour. White is the default, and you can pick any other solid colour." }
        },
        {
          "@type": "Question",
          "name": "Can I also convert JPG to PNG?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Drop JPG files and the tool automatically switches to JPG → PNG mode. PNG output is lossless, so no quality is lost." }
        },
        {
          "@type": "Question",
          "name": "What quality setting should I use?",
          "acceptedAnswer": { "@type": "Answer", "text": "92% looks nearly identical to the original and gives a noticeably smaller file. Go higher if the image will be printed, or lower if you need a very small file for the web." }
        },
        {
          "@type": "Question",
          "name": "Is there a file size or count limit?",
          "acceptedAnswer": { "@type": "Answer", "text": "You can convert up to 10 images at once, each up to 50 MB." }
        }
      ]
    }
  ]
};
---
<Layout
  title="PNG to JPG Converter — Free, Handles Transparency · Latch Tools"
  description="Convert PNG images to JPG (and JPG to PNG) in your browser, with a background fill for transparent areas. Files never leave your device."
  ogImage="/og/png-to-jpg.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <!-- TOOL HERO + WIDGET -->
  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">PNG to JPG</span>
        </nav>
        <h1>PNG to JPG converter</h1>
        <p>Convert PNG images to JPG, or JPG back to PNG. Transparent areas get a background colour of your choice.</p>
        <TrustPill />
      </div>

      <!-- WIDGET -->
      <div class="widget" id="widget" role="region" aria-label="PNG to JPG converter">
        <div class="widget-head">
          <span class="wt" style="font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:-.01em" id="widget-title">
            Convert your images
          </span>
          <span class="fmt-pill" aria-hidden="true">
            <span class="from" id="pill-from">PNG</span>
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            <span class="to" id="pill-to">JPG</span>
          </span>
        </div>

        <!-- STATE: empty / drag -->
        <div id="state-drop" class="widget-state">
          <div
            class="dropzone"
            id="dropzone"
            role="button"
            tabindex="0"
            aria-label="Drop PNG or JPG files here or click to browse"
            aria-describedby="dz-hint"
          >
            <div class="dz-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5m0 0L8 9m4-4l4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
            </div>
            <p class="dz-title" id="dz-title">Drag &amp; drop your PNG or JPG images</p>
            <p class="dz-or" aria-hidden="true">or</p>
            <button class="btn btn-secondary" type="button" id="browse-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Browse files
            </button>
            <p class="dz-hint" id="dz-hint">Accepts .png and .jpg · up to 10 files, 50 MB each</p>
          </div>
        </div>

        <!-- STATE: selected -->
        <div id="state-selected" class="widget-state" hidden>
          <div class="filelist file-list" id="filelist" aria-live="polite" aria-label="Selected images"></div>
          <p class="batch-summary" id="batch-summary"></p>
          <!-- PNG→JPG options (hidden for JPG→PNG) -->
          <div class="opts" id="png-opts">
            <div class="opt">
              <label for="quality-slider">Quality</label>
              <input
                class="slider"
                type="range"
                min="40"
                max="100"
                value="92"
                id="quality-slider"
                aria-label="JPG quality percentage"
              />
              <span class="val" id="quality-val" aria-live="polite">92%</span>
            </div>
            <div class="opt">
              <label for="bg-color">Transparent areas filled with</label>
              <span class="color-wrap">
                <input type="color" id="bg-color" value="#ffffff" aria-label="Background fill colour for transparent areas" />
                <span class="color-preview" id="color-preview" aria-hidden="true" style="background:#ffffff"></span>
              </span>
            </div>
          </div>
          <div class="actions">
            <button class="btn btn-primary grow" type="button" id="convert-btn">
              <span id="convert-btn-label">Convert to JPG</span>
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            </button>
          </div>
        </div>

        <!-- STATE: processing -->
        <div id="state-processing" class="widget-state" hidden>
          <div class="proc">
            <div class="proc-row">
              <div class="spinner" role="status" aria-label="Converting"></div>
              <div>
                <div class="pt">Converting your images</div>
                <div class="ps" id="proc-status" aria-live="polite"></div>
              </div>
            </div>
            <div class="bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="progress-bar">
              <i id="progress-fill" style="width:0%"></i>
            </div>
            <div class="proc-pct">
              <span id="proc-pct">0%</span>
              <span>Converting…</span>
            </div>
          </div>
          <div class="actions">
            <button class="btn btn-ghost grow" type="button" id="cancel-btn">Cancel</button>
          </div>
        </div>

        <!-- STATE: done -->
        <div id="state-done" class="widget-state" hidden>
          <div class="result-head">
            <span class="result-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <div>
              <div class="rt" id="done-title">All done</div>
              <div class="rs" id="done-sub"></div>
            </div>
          </div>
          <div class="filelist" id="results-list" aria-live="polite" aria-label="Converted files"></div>
          <div class="actions">
            <button class="btn btn-secondary" type="button" id="convert-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8M20 4v4h-4"/></svg>
              Convert another
            </button>
            <button class="btn btn-primary grow" type="button" id="download-all-btn">
              <span id="download-all-label">Download</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"/><path d="M5 19h14"/></svg>
            </button>
          </div>
        </div>

        <!-- STATE: error -->
        <div id="state-error" class="widget-state" hidden>
          <div class="err-head">
            <span class="err-badge" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"/><circle cx="12" cy="16.4" r=".4" fill="currentColor"/><path d="M10.3 4.2L3.4 16a2 2 0 0 0 1.7 3h13.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"/></svg>
            </span>
            <div>
              <div class="et" id="err-title">We couldn't convert that file</div>
              <div class="es" id="err-message"></div>
              <p class="help-text">The original file has not been changed.</p>
              <details class="support-details" id="err-support" hidden>
                <summary>Technical details</summary>
                <code id="err-code"></code>
              </details>
            </div>
          </div>
          <div class="filelist" id="error-list" aria-live="assertive"></div>
          <div class="actions">
            <button class="btn btn-secondary" type="button" id="remove-continue-btn">Remove &amp; continue</button>
            <button class="btn btn-primary grow" type="button" id="try-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Try another file
            </button>
          </div>
        </div>
      </div>
      <!-- hidden file input -->
      <input type="file" id="file-input" accept=".png,.jpg,.jpeg,image/png,image/jpeg" multiple hidden aria-hidden="true" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to convert PNG to JPG</h2>
        </div>
      </div>
      <div class="howto" style="grid-template-columns:repeat(3,1fr)">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Add your PNG or JPG files</h4>
          <p>Drag images onto the box above, or click Browse. Drop PNGs to get JPGs, or JPGs to get PNGs. The tool detects the direction automatically from the files you add.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Set quality and background</h4>
          <p>When converting to JPG, choose a quality level (default 92%) and pick a background colour to fill any transparent areas.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Download your results</h4>
          <p>Download each one on its own, or all of them in a single zip.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">
            Are my images uploaded anywhere?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">No. Conversion happens entirely in your browser using the Canvas API. Nothing is sent to a server, and the tool keeps working offline once the page has loaded.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            What happens to transparent areas when converting PNG to JPG?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">JPG has no transparency, so those areas need a background colour. White is the default, and you can pick any other solid colour with the colour picker.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Can I also convert JPG to PNG?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Yes. Drop JPG files and the tool automatically switches to JPG → PNG mode. PNG output is lossless, so no quality is lost in the conversion.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            What quality setting should I use?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">At the default of 92%, the result looks the same as the original and the file is noticeably smaller. For print, use 95–100%. For web thumbnails, where file size matters more than sharpness, 70–80% is enough.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Is there a file size or count limit?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">You can convert up to 10 images at once, each up to 50 MB.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- RELATED TOOLS -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Related tools</h2>
        </div>
      </div>
      <div class="tool-grid" style="grid-template-columns:repeat(4,1fr)">
        <a href="/png-to-avif/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </div>
          <div class="tool-name">PNG to AVIF</div>
          <div class="tool-desc">Shrink a PNG into a much smaller AVIF file.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/png-to-webp/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 16a8 8 0 0 1-13.5 2.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </div>
          <div class="tool-name">PNG to WebP</div>
          <div class="tool-desc">Convert PNG images to smaller WebP files with transparency preserved.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/jfif-to-jpg/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </div>
          <div class="tool-name">JFIF to JPG</div>
          <div class="tool-desc">A .jfif is a JPEG under another name. Save it as a standard JPG.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/svg-to-jpg/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="13" height="10" rx="2.2"/><circle cx="6.8" cy="7.8" r="1.2"/><path d="M3.6 12.4l3.1-3 2.3 2.1L12 8.2l4 3.8"/><path d="M14.5 19.5h6m0 0l-2.4-2.4m2.4 2.4l-2.4 2.4"/></svg>
          </div>
          <div class="tool-name">SVG to JPG</div>
          <div class="tool-desc">Rasterise SVG vector graphics to JPG at any resolution.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>

  .widget-state[hidden] { display: none; }

  .color-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  input[type="color"] {
    width: 36px;
    height: 36px;
    border: 1.5px solid var(--border-strong);
    border-radius: var(--r-sm);
    padding: 2px;
    background: var(--surface);
    cursor: pointer;
  }
  .color-preview {
    width: 36px;
    height: 36px;
    border-radius: var(--r-sm);
    border: 1.5px solid var(--border);
    flex-shrink: 0;
  }

  details.faq-item .faq-a { display: none; }
  details.faq-item[open] .faq-a { display: block; }
  details.faq-item[open] .pm svg path:last-child { opacity: 0; }
</style>

<script>
  import { attachThumb } from '../lib/thumbs';
  // -----------------------------------------------------------------------
  // PNG ↔ JPG — client-side widget controller
  // Auto-detects direction from dropped file type.
  // Uses the Canvas API — no external library needed.
  // -----------------------------------------------------------------------

  type FileEntry = { file: File };
  type ResultEntry = { name: string; blob: Blob; originalSize: number };
  type Direction = 'png-to-jpg' | 'jpg-to-png';

  const MAX_SIZE_MB = 50;
  const MAX_SIZE_BYTES = MAX_SIZE_MB * 1024 * 1024;
  const MAX_FILES = 10;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const states = {
    drop: $('state-drop'),
    selected: $('state-selected'),
    processing: $('state-processing'),
    done: $('state-done'),
    error: $('state-error'),
  };

  function showState(name: keyof typeof states) {
    for (const [k, el] of Object.entries(states)) {
      (el as HTMLElement).hidden = k !== name;
    }
  }

  let files: FileEntry[] = [];
  let results: ResultEntry[] = [];
  let cancelled = false;
  let direction: Direction = 'png-to-jpg';

  const dropzone = $('dropzone');
  const fileInput = $<HTMLInputElement>('file-input');
  const browseBtn = $('browse-btn');
  const fileList = $('filelist');
  const qualitySlider = $<HTMLInputElement>('quality-slider');
  const qualityVal = $('quality-val');
  const bgColorInput = $<HTMLInputElement>('bg-color');
  const colorPreview = $('color-preview');
  const pngOpts = $('png-opts');
  const convertBtn = $('convert-btn');
  const convertBtnLabel = $('convert-btn-label');
  const cancelBtn = $('cancel-btn');
  const resultsList = $('results-list');
  const convertAnotherBtn = $('convert-another-btn');
  const downloadAllBtn = $('download-all-btn');
  const doneTitleEl = $('done-title');
  const doneSub = $('done-sub');
  const removeAndContinueBtn = $('remove-continue-btn');
  const tryAnotherBtn = $('try-another-btn');
  const widgetTitle = $('widget-title');
  const batchSummary = $('batch-summary');
  const pillFrom = $('pill-from');
  const pillTo = $('pill-to');

  qualitySlider.addEventListener('input', () => {
    qualityVal.textContent = qualitySlider.value + '%';
  });

  bgColorInput.addEventListener('input', () => {
    colorPreview.style.background = bgColorInput.value;
  });

  // ---- Drop zone ----
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('is-drag');
    $('dz-title').textContent = 'Drop to add your images';
  });
  ['dragleave', 'dragend'].forEach((ev) => {
    dropzone.addEventListener(ev, () => {
      dropzone.classList.remove('is-drag');
      $('dz-title').textContent = 'Drag & drop your PNG or JPG images';
    });
  });
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('is-drag');
    const de = e as DragEvent;
    addFiles(Array.from(de.dataTransfer?.files ?? []));
  });
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key === 'Enter' || ke.key === ' ') { e.preventDefault(); fileInput.click(); }
  });
  browseBtn.addEventListener('click', (e) => { e.stopPropagation(); fileInput.click(); });
  fileInput.addEventListener('change', () => {
    addFiles(Array.from(fileInput.files ?? []));
    fileInput.value = '';
  });

  function getFileDirection(f: File): Direction | null {
    const ext = f.name.split('.').pop()?.toLowerCase() ?? '';
    if (ext === 'png' || f.type === 'image/png') return 'png-to-jpg';
    if (ext === 'jpg' || ext === 'jpeg' || f.type === 'image/jpeg') return 'jpg-to-png';
    return null;
  }

  function setDirection(dir: Direction) {
    direction = dir;
    if (dir === 'png-to-jpg') {
      pillFrom.textContent = 'PNG';
      pillTo.textContent = 'JPG';
      convertBtnLabel.textContent = 'Convert to JPG';
      pngOpts.hidden = false;
    } else {
      pillFrom.textContent = 'JPG';
      pillTo.textContent = 'PNG';
      convertBtnLabel.textContent = 'Convert to PNG';
      pngOpts.hidden = true;
    }
  }

  function formatBytes(b: number): string {
    if (b < 1024) return b + ' B';
    if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
    return (b / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function escHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function addFiles(incoming: File[]) {
    const valid = incoming.filter((f) => getFileDirection(f) !== null);

    if (valid.length === 0 && incoming.length > 0) {
      showError('Unsupported file type', `Please drop a <code>.png</code> or <code>.jpg</code> file.`, files, 'UNSUPPORTED_FILE_TYPE');
      return;
    }
    if (valid.length === 0) return;

    // Direction locked to first file in the batch (or existing direction)
    const batchDir = files.length > 0 ? direction : getFileDirection(valid[0])!;
    const matching = valid.filter((f) => getFileDirection(f) === batchDir);
    if (matching.length === 0) return;

    const oversized = matching.find((f) => f.size > MAX_SIZE_BYTES);
    if (oversized) {
      showError('File too large', `${oversized.name} must be under ${MAX_SIZE_MB} MB.`, files, 'FILE_TOO_LARGE');
      return;
    }

    const existingNames = new Set(files.map((e) => e.file.name));
    const fresh = matching.filter((f) => !existingNames.has(f.name));
    const combined = [...files, ...fresh.map((f) => ({ file: f }))].slice(0, MAX_FILES);
    if (combined.length === 0) return;

    setDirection(batchDir);
    files = combined;
    renderFileList();
    const label = batchDir === 'png-to-jpg' ? 'PNG' : 'JPG';
    widgetTitle.textContent = files.length === 1 ? `${label} ready` : `${files.length} ${label}s ready`;
    showState('selected');
  }

  function removeFile(index: number) {
    files.splice(index, 1);
    if (files.length === 0) {
      widgetTitle.textContent = 'Convert your images';
      showState('drop');
    } else {
      const label = direction === 'png-to-jpg' ? 'PNG' : 'JPG';
      widgetTitle.textContent = files.length === 1 ? `${label} ready` : `${files.length} ${label}s ready`;
      renderFileList();
    }
  }

  function updateBatchMeta() {
    const n = files.length;
    const total = files.reduce((s, e) => s + e.file.size, 0);
    batchSummary.textContent = n === 1
      ? `${formatBytes(total)} · downloads as a single file`
      : `${formatBytes(total)} total · downloads as a single ZIP`;
  }

  function renderFileList() {
    fileList.innerHTML = '';
    const thumbLabel = direction === 'png-to-jpg' ? 'PNG' : 'JPG';
    files.forEach((entry, i) => {
      const row = document.createElement('div');
      row.className = 'filerow';
      row.innerHTML = `
        <span class="file-thumb">${thumbLabel}</span>
        <div class="file-meta">
          <div class="file-name">${escHtml(entry.file.name)}</div>
          <div class="file-sub">${formatBytes(entry.file.size)}</div>
        </div>
        <button class="icon-btn" aria-label="Remove ${escHtml(entry.file.name)}" data-index="${i}">
          <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 5l8 8M13 5l-8 8"/></svg>
        </button>
      `;
      attachThumb(row.querySelector('.file-thumb'), entry.file);
      row.querySelector('button')!.addEventListener('click', () => removeFile(i));
      fileList.appendChild(row);
    });
    updateBatchMeta();
  }

  convertBtn.addEventListener('click', startConversion);

  async function startConversion() {
    if (files.length === 0) return;
    cancelled = false;
    results = [];
    widgetTitle.textContent = 'Converting…';
    showState('processing');

    const quality = parseInt(qualitySlider.value, 10) / 100;
    const bgColor = bgColorInput.value;

    for (let i = 0; i < files.length; i++) {
      if (cancelled) break;

      const entry = files[i];
      const pct = Math.round((i / files.length) * 100);
      updateProgress(pct, `${i + 1} of ${files.length} · ${entry.file.name}`);

      try {
        const blob = await convertOne(entry.file, quality, bgColor);
        const ext = direction === 'png-to-jpg' ? '.jpg' : '.png';
        const name = entry.file.name.replace(/\.(png|jpe?g)$/i, '') + ext;
        results.push({ name, blob, originalSize: entry.file.size });
      } catch (err) {
        if (!cancelled) {
          showError(
            `Couldn't convert ${entry.file.name}`,
            `<code>${escHtml(entry.file.name)}</code> looks corrupted or isn't a valid image.`,
            files.filter((_, j) => j !== i),
            'CONVERT_FAILED'
          );
          return;
        }
      }
    }

    if (!cancelled) {
      updateProgress(100, '');
      showDone();
    }
  }

  function updateProgress(pct: number, status: string) {
    const fill = $<HTMLElement>('progress-fill');
    const pctEl = $('proc-pct');
    const bar = $<HTMLElement>('progress-bar');
    const statusEl = $('proc-status');
    fill.style.width = pct + '%';
    pctEl.textContent = pct + '%';
    bar.setAttribute('aria-valuenow', String(pct));
    statusEl.textContent = status;
  }

  async function convertOne(file: File, quality: number, bgColor: string): Promise<Blob> {
    const bitmap = await createImageBitmap(file);
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    const ctx = canvas.getContext('2d')!;

    if (direction === 'png-to-jpg') {
      ctx.fillStyle = bgColor;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    ctx.drawImage(bitmap, 0, 0);
    bitmap.close();

    const mimeType = direction === 'png-to-jpg' ? 'image/jpeg' : 'image/png';
    const qualityArg = direction === 'png-to-jpg' ? quality : undefined;

    return new Promise<Blob>((resolve, reject) => {
      canvas.toBlob((blob) => {
        if (blob) resolve(blob);
        else reject(new Error('Canvas conversion failed'));
      }, mimeType, qualityArg);
    });
  }

  cancelBtn.addEventListener('click', () => {
    cancelled = true;
    files = [];
    results = [];
    widgetTitle.textContent = 'Convert your images';
    showState('drop');
  });

  function showDone() {
    const count = results.length;
    const outLabel = direction === 'png-to-jpg' ? 'JPG' : 'PNG';
    doneTitleEl.textContent = `Finished: ${count} image${count !== 1 ? 's' : ''} converted`;    const totalOriginal = results.reduce((s, r) => s + r.originalSize, 0);
    const totalOutput = results.reduce((s, r) => s + r.blob.size, 0);
    const savedPct = totalOriginal > 0 ? Math.round((1 - totalOutput / totalOriginal) * 100) : 0;
    doneSub.textContent = `Saved as ${outLabel} · ${formatBytes(totalOriginal)} → ${formatBytes(totalOutput)}${savedPct > 0 ? ` (${savedPct}% smaller)` : ''}`;

    resultsList.innerHTML = '';
    results.forEach((r) => {
      const saving = Math.round((1 - r.blob.size / r.originalSize) * 100);
      const row = document.createElement('div');
      row.className = 'filerow';
      row.innerHTML = `
        <span class="file-thumb done">${outLabel}</span>
        <div class="file-meta">
          <div class="file-name">${escHtml(r.name)}</div>
          <div class="file-sub">${formatBytes(r.blob.size)}${saving > 0 ? ` <span class="ok">· ${saving}% smaller</span>` : ''}</div>
        </div>
        ${count > 1 ? `<button class="btn btn-secondary" type="button" style="height:40px;padding:0 16px" data-name="${escHtml(r.name)}">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0l-4-4m4 4l4-4"/><path d="M5 19h14"/></svg>
          Save
        </button>` : ''}
      `;
      attachThumb(row.querySelector('.file-thumb'), r.blob);
      row.querySelector('button')?.addEventListener('click', () => downloadOne(r));
      resultsList.appendChild(row);
    });
    widgetTitle.textContent = 'Ready to download';
    $('download-all-label').textContent = count > 1 ? `Download ${count} ${outLabel}s · ZIP` : `Download ${outLabel}`;
    showState('done');
  }

  function downloadOne(r: ResultEntry) {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(r.blob);
    a.download = r.name;
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10000);
  }

  async function downloadAll() {
    if (results.length === 1) { downloadOne(results[0]); return; }
    const { default: JSZip } = await import('jszip');
    const zip = new JSZip();
    for (const r of results) zip.file(r.name, r.blob);
    const zipBlob = await zip.generateAsync({ type: 'blob' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(zipBlob);
    a.download = 'converted-images.zip';
    a.click();
    setTimeout(() => URL.revokeObjectURL(a.href), 10000);
  }

  downloadAllBtn.addEventListener('click', () => downloadAll());

  convertAnotherBtn.addEventListener('click', () => {
    files = [];
    results = [];
    setDirection('png-to-jpg');
    widgetTitle.textContent = 'Convert your images';
    showState('drop');
  });

  function showError(title: string, message: string, remainingFiles: FileEntry[], code?: string) {
    $('err-title').textContent = title;
    $('err-message').innerHTML = message;
    const support = $('err-support');
    if (code) {
      $('err-code').textContent = code;
      support.hidden = false;
    } else {
      support.hidden = true;
    }
    const errorList = $('error-list');
    errorList.innerHTML = `
      <div class="filerow" style="border-color:color-mix(in srgb,var(--danger) 35%,var(--border))">
        <span class="file-thumb" style="background:var(--danger-weak);color:var(--danger)">!</span>
        <div class="file-meta">
          <div class="file-name">${title}</div>
          <div class="file-sub" style="color:var(--danger)">${message.replace(/<[^>]+>/g, '')}</div>
        </div>
      </div>
    `;
    widgetTitle.textContent = 'Something went wrong';
    showState('error');

    const handler = () => {
      files = remainingFiles;
      if (files.length === 0) {
        widgetTitle.textContent = 'Convert your images';
        showState('drop');
      } else {
        const label = direction === 'png-to-jpg' ? 'PNG' : 'JPG';
        widgetTitle.textContent = `${files.length} ${label}${files.length !== 1 ? 's' : ''} ready`;
        renderFileList();
        showState('selected');
      }
      removeAndContinueBtn.removeEventListener('click', handler);
    };
    removeAndContinueBtn.addEventListener('click', handler);
  }

  tryAnotherBtn.addEventListener('click', () => {
    files = [];
    results = [];
    setDirection('png-to-jpg');
    widgetTitle.textContent = 'Convert your images';
    showState('drop');
  });
</script>
