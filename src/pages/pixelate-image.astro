---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pixelate Image", "item": "https://latchtools.com/pixelate-image/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Pixelate Image",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Pixelate part of an image to redact names, faces, and sensitive details in screenshots and photos. Runs in your browser — nothing is uploaded.",
      "url": "https://latchtools.com/pixelate-image/"
    },
    {
      "@type": "HowTo",
      "name": "How to pixelate part of an image",
      "step": [
        { "@type": "HowToStep", "name": "Add your image", "text": "Drag your image or screenshot onto the editor, or click Browse to select it." },
        { "@type": "HowToStep", "name": "Draw over what to hide", "text": "Drag a box over each area you want to censor — a name, a face, an address, an account number." },
        { "@type": "HowToStep", "name": "Set the block size", "text": "Raise the strength for larger, more thorough blocks." },
        { "@type": "HowToStep", "name": "Download the result", "text": "Save the image. The pixelation is rendered into the pixels, so the hidden detail cannot be read back." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is my image uploaded to a server?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. The image is processed entirely in your browser with the Canvas API. It is never uploaded, so even screenshots containing private information stay on your device." }
        },
        {
          "@type": "Question",
          "name": "Can pixelated text be recovered?",
          "acceptedAnswer": { "@type": "Answer", "text": "With a coarse enough block size, no. The tool averages each block down and scales it back up, discarding the underlying detail — and it does this on the exported pixels, not as a removable overlay. Use a high strength for text: fine pixelation of short, predictable text can sometimes be reconstructed, so make the blocks large enough that nothing is legible." }
        },
        {
          "@type": "Question",
          "name": "Can I pixelate several areas at once?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Draw a box over each area you want to hide — there is no limit. Every box uses the same effect and strength, and you can move, resize, or delete any of them before exporting." }
        },
        {
          "@type": "Question",
          "name": "What is the difference between pixelate, blur and blackout?",
          "acceptedAnswer": { "@type": "Answer", "text": "Pixelation replaces an area with large solid blocks, which reads clearly as a deliberate redaction. Blur softens an area instead, and a solid black bar removes it outright — for those, use the Blur tool or the Redact tool. Whichever you pick, use enough strength that the detail is completely hidden." }
        },
        {
          "@type": "Question",
          "name": "Does pixelating keep the rest of the image sharp?",
          "acceptedAnswer": { "@type": "Answer", "text": "Yes. Only the areas inside your boxes are changed. The rest of the image is exported untouched at its original resolution." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Pixelate Image — Censor Photos, Screenshots · Latch Tools"
  description="Pixelate part of an image to redact names, faces, and private details in screenshots and photos. Runs in your browser — nothing is uploaded."
  ogImage="/og/pixelate-image.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Pixelate Image</span>
        </nav>
        <h1>Pixelate part of an image</h1>
        <p>Censor a name, a face, an address, or an account number before you share a screenshot or photo. Draw a box over each detail and it's replaced with solid blocks that can't be read back.</p>
        <TrustPill />
        <ul class="tool-features">
          <li>Pixelate as many areas as you like</li>
          <li>Great for screenshots, chats, and documents</li>
          <li>Processed in your browser — never uploaded</li>
        </ul>
      </div>

      <RedactWidget heading="Pixelate an image" defaultEffect="pixelate" applyLabel="Pixelate & download" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to pixelate an image</h2>
          <p class="sec-desc">Four steps, a few seconds, zero uploads.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Add your image</h4>
          <p>Drag your image or screenshot onto the editor, or click Browse. JPEG, PNG, and WebP are accepted.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>Draw over what to hide</h4>
          <p>Drag a box over each name, face, or number you want to censor. Add as many boxes as you need.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Set the block size</h4>
          <p>Raise the strength for larger, more thorough blocks — bigger blocks hide more.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Download</h4>
          <p>Save the result. The pixelation is baked into the pixels, so the hidden detail can't be read back.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY / PRIVACY -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Redact screenshots without uploading them</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        Most images people pixelate are screenshots — an order confirmation, a bank statement, a chat thread, a support ticket — and they're full of exactly the details you don't want on a server. Uploading such an image to a web tool just to hide part of it defeats the purpose. Latch pixelates it on your own device: the file is decoded, redacted, and re-saved in the browser, and nothing is transmitted.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        The redaction is permanent. Each block is averaged down and rescaled so the original detail is discarded, and this is written into the exported pixels rather than layered on top. For text especially, use a coarse block size — very fine pixelation of short, predictable strings can occasionally be reconstructed, so make the blocks large enough that nothing is legible.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">Is my image uploaded to a server?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">No. The image is processed entirely in your browser with the Canvas API. It is never uploaded, so even screenshots containing private information stay on your device.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can pixelated text be recovered?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">With a coarse enough block size, no. The tool averages each block down and scales it back up, discarding the underlying detail — on the exported pixels, not as a removable overlay. Use a high strength for text: fine pixelation of short, predictable strings can sometimes be reconstructed, so make the blocks large enough that nothing is legible.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Can I pixelate several areas at once?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Draw a box over each area you want to hide — there is no limit. Every box uses the same effect and strength, and you can move, resize, or delete any of them before exporting.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">What is the difference between pixelate, blur and blackout?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Pixelation replaces an area with large solid blocks, which reads clearly as a deliberate redaction. Blur softens an area instead, and a solid black bar removes it outright — for those, use the <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">blur</a> or <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">redact</a> tool. Whichever you pick, use enough strength that the detail is completely hidden.</p>
        </details>
        <details class="faq-item">
          <summary class="faq-q">Does pixelating keep the rest of the image sharp?<span class="pm" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg></span></summary>
          <p class="faq-a">Yes. Only the areas inside your boxes are changed. The rest of the image is exported untouched at its original resolution.</p>
        </details>
      </div>

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">Blur part of an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/blur-license-plate/" style="color:var(--accent-text);font-weight:600">Blur a license plate</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
