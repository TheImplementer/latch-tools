---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';
import RedactWidget from '../components/RedactWidget.astro';
import HowToSteps from '../components/HowToSteps.astro';
import FaqList from '../components/FaqList.astro';
import { howToSchema, faqSchema, type Step, type Faq } from '../lib/guide';

// This page's job: screenshots, and the mosaic look. What it says about block
// size follows blockSize() in src/lib/regions.ts: 16, 12, 9, 6 or 4 blocks
// across the shorter side of each box, for strengths 1 to 5.
const steps: Step[] = [
  { name: 'Add the screenshot', text: 'Drag the screenshot or photo onto the editor, or click Browse. JPEG, PNG and WebP are accepted.' },
  { name: 'Box every detail', text: 'Go through the list below: names, avatars, numbers, codes. Draw one box per detail.' },
  { name: 'Size the blocks to the detail', text: 'Blocks are sized from each box\'s shorter side. Over a line of text, use the top strength, or draw the box taller to make the blocks bigger.' },
  { name: 'Download and zoom in', text: 'Open the result at full size. If you can still make out the shape of a word, go stronger or black it out instead.' },
];

const faqs: Faq[] = [
  {
    q: 'Can pixelated text be recovered?',
    a: 'Sometimes, yes. Pixelation keeps the average colour of each block, and with short, predictable text such as a password, a phone number or an account number, someone can pixelate each candidate the same way and compare the blocks. Fine blocks over one line of text are the case where this works. Use the top strength, draw the box well over the line, or for text that matters use a solid bar from <a href="/redact-image/">Redact image</a>. <a href="/unblur-license-plate/">How blurred and pixelated details get recovered</a> explains the method.',
  },
  {
    q: 'Pixelate or blur: which hides more?',
    a: 'About the same. Both keep an average of the pixels underneath, so neither is safe on text that matters. Pixelation reads as deliberate censoring, which is why it is the usual choice for screenshots, while a blur looks softer and blends in. <a href="/blur-image/">Blur image</a> sets out when to use each of the three effects.',
  },
  {
    q: 'Can I pixelate a batch of screenshots?',
    a: 'Yes, up to 30 at once. If they are screenshots of the same screen, such as a run of messages from one app, box the details on one and press <em>Copy boxes to all</em>. Each box lands in the same place on every screenshot, so check them, because the content may have scrolled.',
  },
  {
    q: 'Does the rest of the screenshot stay sharp?',
    a: 'Yes. Only the areas inside your boxes change, and the rest is saved at its original size. A PNG screenshot is saved as a PNG, so the text around the boxes stays crisp instead of picking up JPEG blur.',
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Tools", "item": "https://latchtools.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pixelate Image", "item": "https://latchtools.com/pixelate-image/" }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": "Pixelate Image",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Pixelate names, faces and numbers in screenshots and photos, with block sizes you can set. Runs in your browser, and the image is never uploaded.",
      "url": "https://latchtools.com/pixelate-image/"
    },
    howToSchema('How to pixelate a screenshot', steps),
    faqSchema(faqs),
  ]
};
---
<Layout
  title="Pixelate Image — Censor Photos, Screenshots · Latch Tools"
  description="Pixelate names, faces and numbers in a screenshot, with blocks big enough to hide text, and a list of what to hide first. Runs in your browser."
  ogImage="/og/pixelate-image.png"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Pixelate Image</span>
        </nav>
        <h1>Pixelate part of an image</h1>
        <p>Censor a name, a face, an address or an account number in a screenshot before you share it. Draw a box over each detail and it's replaced with blocks.</p>
        <TrustPill />
      </div>

      <RedactWidget heading="Pixelate an image" defaultEffect="pixelate" applyLabel="Pixelate & download" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to pixelate a screenshot</h2>
        </div>
      </div>
      <HowToSteps steps={steps} />
    </div>
  </section>

  <!-- WHAT TO HIDE -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">What to hide in a screenshot</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        People pixelate the message they are quoting and miss the rest of the screen. Before you share, go over the whole screenshot for these.
      </p>
      <ul class="check-list">
        <li><strong>Names and profile photos</strong> in chat headers, replies and reactions, not only in the message itself.</li>
        <li><strong>Phone numbers and email addresses</strong>, including the ones in a contact card or a "sent to" line.</li>
        <li><strong>Order, booking and tracking numbers.</strong> With a surname, a booking reference is often all an airline or a shop asks for to change a booking.</li>
        <li><strong>Barcodes and QR codes.</strong> A boarding pass barcode holds your name and booking reference. QR codes are designed to scan with part of the code missing, so cover the whole code, not a corner.</li>
        <li><strong>The edges of the screen.</strong> Browser tabs, the address bar (links often carry account or order IDs), and notification banners that arrived while you took the shot.</li>
      </ul>
    </div>
  </section>

  <!-- BLOCK SIZE -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">How big the blocks need to be</h2>
        </div>
      </div>
      <p class="muted" style="font-size:15.5px;line-height:1.65">
        Pixelation replaces each block with its average colour. Whether that hides a word depends on how many blocks each letter covers. Here the block size comes from the shorter side of each box you draw: 16 blocks across it at the lowest strength, down to 4 at the highest.
      </p>
      <p class="muted" style="font-size:15.5px;line-height:1.65;margin-top:14px">
        So a tight box round a single line of text, at strength 1, gives blocks smaller than a letter, and the word's shape shows through. At strength 5 each block is about a quarter of the box's height, which hides the text from a glance but still leaves a few blocks per letter. Because the size follows the box, a box drawn two or three lines tall makes blocks two or three times bigger. For a password, a card number or anything else that must not be recovered, skip pixelation and use a <a class="prose-link" href="/redact-image/">solid black bar</a>.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <FaqList faqs={faqs} />

      <p class="muted" style="font-size:14px;margin-top:30px">
        Related privacy tools: <a href="/blur-image/" style="color:var(--accent-text);font-weight:600">Blur part of an image</a> · <a href="/blur-face/" style="color:var(--accent-text);font-weight:600">Blur a face</a> · <a href="/blur-license-plate/" style="color:var(--accent-text);font-weight:600">Blur a license plate</a> · <a href="/redact-image/" style="color:var(--accent-text);font-weight:600">Redact an image</a> · <a href="/remove-exif/" style="color:var(--accent-text);font-weight:600">Remove photo metadata</a>
      </p>
    </div>
  </section>

  <Footer />
</Layout>
