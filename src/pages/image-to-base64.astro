---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TrustPill from '../components/TrustPill.astro';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Image to Base64 Encoder",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Web Browser",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "description": "Encode any image to a Base64 data URI directly in your browser — copy it as a data URI, raw string, CSS background or HTML img tag. No uploads required — files never leave your device.",
      "url": "https://latchtools.com/image-to-base64/"
    },
    {
      "@type": "HowTo",
      "name": "How to convert an image to Base64",
      "step": [
        { "@type": "HowToStep", "name": "Add your image", "text": "Drag an image onto the drop zone, or click Browse to pick one from your device." },
        { "@type": "HowToStep", "name": "Encode locally", "text": "Latch reads the image in your browser and encodes it to a Base64 string — instantly and offline." },
        { "@type": "HowToStep", "name": "Pick a format", "text": "Choose a data URI, the raw Base64, a CSS background-image rule, or an HTML img tag." },
        { "@type": "HowToStep", "name": "Copy it", "text": "Hit Copy and paste the string straight into your stylesheet, markup or code." }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is my image uploaded anywhere?",
          "acceptedAnswer": { "@type": "Answer", "text": "No. Your browser reads and encodes the image locally. Nothing is sent to a server — the tool even works with Wi-Fi switched off." }
        },
        {
          "@type": "Question",
          "name": "What is a Base64 data URI?",
          "acceptedAnswer": { "@type": "Answer", "text": "A data URI encodes a file's bytes as text, so you can embed an image directly in your HTML, CSS or JavaScript instead of linking to a separate file. It looks like data:image/png;base64, followed by the encoded data." }
        },
        {
          "@type": "Question",
          "name": "Why is the Base64 string bigger than my image?",
          "acceptedAnswer": { "@type": "Answer", "text": "Base64 represents 3 bytes of binary as 4 text characters, so the encoded string is about 33% larger than the original file. That's the trade-off for embedding an image inline. It's best for small images like icons; large photos are usually better left as separate files." }
        },
        {
          "@type": "Question",
          "name": "Which image formats can I encode?",
          "acceptedAnswer": { "@type": "Answer", "text": "Any image your browser can read — PNG, JPG, WebP, GIF, SVG, AVIF, BMP and more. The output keeps the original format's MIME type in the data URI, so an SVG stays image/svg+xml and a PNG stays image/png." }
        },
        {
          "@type": "Question",
          "name": "How do I use the Base64 in CSS or HTML?",
          "acceptedAnswer": { "@type": "Answer", "text": "Switch the format toggle to CSS to get a background-image: url(...) rule, or to HTML to get a ready-made img tag. Both paste straight into your code and render the image with no extra network request." }
        }
      ]
    }
  ]
};
---
<Layout
  title="Convert Image to Base64 — Free, Private, No Upload | Latch"
  description="Encode any image to a Base64 data URI in your browser — copy it as a data URI, raw string, CSS background or HTML img tag. No uploads, no sign-up — files never leave your device."
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </Fragment>

  <Header />

  <!-- TOOL HERO + WIDGET -->
  <section class="tool-section">
    <div class="wrap tool-split">
      <div class="tool-hero">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Tools</a>
          <span aria-hidden="true">/</span>
          <span style="color:var(--text-2)" aria-current="page">Image to Base64</span>
        </nav>
        <h1>Image to Base64 encoder</h1>
        <p>Turn any image into a Base64 data URI — right here in your browser. Copy it as a data URI, raw string, CSS rule or HTML tag.</p>
        <TrustPill />
        <ul class="tool-features">
          <li>Data URI, raw, CSS &amp; HTML output</li>
          <li>Works with PNG, JPG, WebP, GIF, SVG…</li>
          <li>One-click copy to clipboard</li>
        </ul>
      </div>

      <!-- WIDGET -->
      <div class="widget" id="widget" role="region" aria-label="Image to Base64 encoder">
        <div class="widget-head">
          <span class="wt" style="font-family:var(--font-display);font-weight:600;font-size:16px;letter-spacing:-.01em" id="widget-title">
            Encode your image
          </span>
          <span class="fmt-pill" aria-hidden="true">
            <span class="from">Image</span>
            <svg width="15" height="15" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            <span class="to">Base64</span>
          </span>
        </div>

        <!-- STATE: empty / drag -->
        <div id="state-drop" class="widget-state">
          <div
            class="dropzone"
            id="dropzone"
            role="button"
            tabindex="0"
            aria-label="Drop an image here or click to browse"
            aria-describedby="dz-hint"
          >
            <div class="dz-icon" aria-hidden="true">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V5m0 0L8 9m4-4l4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
            </div>
            <p class="dz-title" id="dz-title">Drag &amp; drop an image</p>
            <p class="dz-or" aria-hidden="true">or</p>
            <button class="btn btn-secondary" type="button" id="browse-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Browse files
            </button>
            <p class="dz-hint" id="dz-hint">Any image up to 10 MB · PNG, JPG, WebP, GIF, SVG…</p>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Encoding happens right here in your browser — nothing is uploaded.
          </div>
        </div>

        <!-- STATE: selected -->
        <div id="state-selected" class="widget-state" hidden>
          <div class="filelist" id="filelist" aria-live="polite" aria-label="Selected file"></div>
          <div class="actions">
            <button class="btn btn-primary grow" type="button" id="convert-btn">
              Encode to Base64
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
            </button>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            This image stays on your device the entire time.
          </div>
        </div>

        <!-- STATE: processing -->
        <div id="state-processing" class="widget-state" hidden>
          <div class="proc">
            <div class="proc-row">
              <div class="spinner" role="status" aria-label="Encoding"></div>
              <div>
                <div class="pt">Encoding your image</div>
                <div class="ps" id="proc-status" aria-live="polite"></div>
              </div>
            </div>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Your browser is doing the work — no file has been sent anywhere.
          </div>
        </div>

        <!-- STATE: done -->
        <div id="state-done" class="widget-state" hidden>
          <div class="result-head">
            <span class="result-badge" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <div>
              <div class="rt" id="done-title">Base64 ready</div>
              <div class="rs">Encoded on your device — nothing was uploaded</div>
            </div>
          </div>
          <div class="fmt-toggle" id="fmt-toggle" role="group" aria-label="Output format">
            <button class="fmt-opt is-active" type="button" data-fmt="datauri">Data URI</button>
            <button class="fmt-opt" type="button" data-fmt="raw">Raw base64</button>
            <button class="fmt-opt" type="button" data-fmt="css">CSS</button>
            <button class="fmt-opt" type="button" data-fmt="html">HTML</button>
          </div>
          <div class="b64-size" id="b64-size"></div>
          <textarea class="b64-area" id="b64-output" readonly spellcheck="false" aria-label="Base64 output"></textarea>
          <div class="actions">
            <button class="btn btn-secondary" type="button" id="encode-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8M20 4v4h-4"/></svg>
              Encode another
            </button>
            <button class="btn btn-primary grow" type="button" id="copy-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
              <span id="copy-label">Copy</span>
            </button>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            Close this tab and the image is gone — nothing was kept.
          </div>
        </div>

        <!-- STATE: error -->
        <div id="state-error" class="widget-state" hidden>
          <div class="err-head">
            <span class="err-badge" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v5"/><circle cx="12" cy="16.4" r=".4" fill="currentColor"/><path d="M10.3 4.2L3.4 16a2 2 0 0 0 1.7 3h13.8a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0z"/></svg>
            </span>
            <div>
              <div class="et" id="err-title">We couldn't encode that file</div>
              <div class="es" id="err-message"></div>
            </div>
          </div>
          <div class="actions">
            <button class="btn btn-primary grow" type="button" id="try-another-btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5A1.5 1.5 0 0 1 4.5 6h4l2 2.5h7A1.5 1.5 0 0 1 19 10v7.5A1.5 1.5 0 0 1 17.5 19h-13A1.5 1.5 0 0 1 3 17.5z"/></svg>
              Try another image
            </button>
          </div>
          <div class="widget-foot">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="7" width="10" height="6.5" rx="1.6"/><path d="M5 7V5a3 3 0 0 1 6 0v2"/></svg>
            The file stayed on your device — even when something goes wrong.
          </div>
        </div>
      </div>
      <!-- hidden file input -->
      <input type="file" id="file-input" accept="image/*" hidden aria-hidden="true" />
    </div>
  </section>

  <!-- HOW TO -->
  <section class="section">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">How to convert an image to Base64</h2>
          <p class="sec-desc">Four steps, a couple of seconds, zero uploads.</p>
        </div>
      </div>
      <div class="howto">
        <div class="howto-step">
          <div class="n">1</div>
          <h4>Add your image</h4>
          <p>Drag an image onto the box above, or click Browse to pick one from your device.</p>
        </div>
        <div class="howto-step">
          <div class="n">2</div>
          <h4>We encode locally</h4>
          <p>Latch reads the image in your browser and encodes it to a Base64 string — instantly and offline.</p>
        </div>
        <div class="howto-step">
          <div class="n">3</div>
          <h4>Pick a format</h4>
          <p>Data URI, raw Base64, a CSS <code>background-image</code> rule, or an HTML <code>&lt;img&gt;</code> tag.</p>
        </div>
        <div class="howto-step">
          <div class="n">4</div>
          <h4>Copy it</h4>
          <p>Hit Copy and paste the string straight into your stylesheet, markup or code.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- IMAGE TO BASE64 EXPLAINED -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Image to Base64, explained</h2>
        </div>
      </div>
      <p style="color:var(--text-2);line-height:1.7;margin-bottom:16px">
        A Base64 <em>data URI</em> encodes an image's bytes as plain text, so you can drop the picture straight into your HTML, CSS or JavaScript instead of linking to a separate file. It starts with something like <code>data:image/png;base64,</code> and is followed by the encoded data. Because the image travels inside your code, the browser doesn't make a separate network request for it.
      </p>
      <p style="color:var(--text-2);line-height:1.7;margin-bottom:16px">
        That's ideal for small assets — icons, tiny logos, an inline SVG — where saving a round-trip matters more than bytes. The catch is size: Base64 is about 33% larger than the original file, so large photos are usually better left as separate, cacheable files.
      </p>
      <p style="color:var(--text-2);line-height:1.7">
        Switch the format toggle to grab exactly what you need: a raw string, a ready-made <code>&lt;img&gt;</code> tag, or a CSS <code>background-image</code> rule. Need to go the other way? <a href="/base64-to-image/" style="color:var(--accent)">Base64 to Image</a> decodes a string back into a downloadable picture.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:780px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:26px">Frequently asked</h2>
        </div>
      </div>
      <div class="faq">
        <details class="faq-item" open>
          <summary class="faq-q">
            Is my image uploaded anywhere?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">No. Your browser reads and encodes the image locally. Nothing is sent to a server — the tool even works with Wi-Fi switched off.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            What is a Base64 data URI?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">A data URI encodes a file's bytes as text, so you can embed an image directly in your HTML, CSS or JavaScript instead of linking to a separate file. It looks like <code>data:image/png;base64,</code> followed by the encoded data.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Why is the Base64 string bigger than my image?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Base64 represents 3 bytes of binary as 4 text characters, so the encoded string is about 33% larger than the original file. That's the trade-off for embedding inline — best for small images like icons; large photos are usually better as separate files.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            Which image formats can I encode?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Any image your browser can read — PNG, JPG, WebP, GIF, SVG, AVIF, BMP and more. The output keeps the original MIME type, so an SVG stays <code>image/svg+xml</code> and a PNG stays <code>image/png</code>.</p>
        </details>

        <details class="faq-item">
          <summary class="faq-q">
            How do I use the Base64 in CSS or HTML?
            <span class="pm" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 3v12M3 9h12"/></svg>
            </span>
          </summary>
          <p class="faq-a">Switch the format toggle to CSS for a <code>background-image: url(...)</code> rule, or to HTML for a ready-made <code>&lt;img&gt;</code> tag. Both paste straight into your code and render the image with no extra network request.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- RELATED TOOLS -->
  <section class="section" style="padding-top:0">
    <div class="wrap" style="max-width:980px">
      <div class="sec-head">
        <div>
          <h2 class="sec-title" style="font-size:22px">Related tools</h2>
        </div>
      </div>
      <div class="tool-grid" style="grid-template-columns:repeat(3,1fr)">
        <a href="/base64-to-image/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6l-5 6 5 6M16 6l5 6-5 6"/></svg>
          </div>
          <div class="tool-name">Base64 to Image</div>
          <div class="tool-desc">Going the other way? Decode a Base64 string back into an image.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/resize-image/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 15l6-6M15 9v3M15 9h-3"/></svg>
          </div>
          <div class="tool-name">Resize image</div>
          <div class="tool-desc">Shrink an image first — a smaller image makes a smaller Base64 string.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
        <a href="/png-to-webp/" class="tool-card">
          <div class="tool-ic" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8a8 8 0 0 1 13.5-2.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 16a8 8 0 0 1-13.5 2.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </div>
          <div class="tool-name">PNG to WebP</div>
          <div class="tool-desc">Convert PNG images to smaller WebP files with transparency preserved.</div>
          <svg class="tool-arrow" width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h10M10 5l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>

  .widget-state[hidden] { display: none; }

  details.faq-item .faq-a { display: none; }
  details.faq-item[open] .faq-a { display: block; }
  details.faq-item[open] .pm svg path:last-child { opacity: 0; }

  /* base64 output textarea */
  .b64-area {
    width: 100%;
    min-height: 168px;
    resize: vertical;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-2);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    padding: 12px 14px;
    word-break: break-all;
    margin-bottom: 14px;
  }
  .b64-area:focus { outline: none; border-color: var(--border-strong); box-shadow: var(--ring); }

  /* output-format toggle */
  .fmt-toggle { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
  .fmt-opt {
    font: inherit; font-size: 13px; font-weight: 500;
    padding: 7px 13px; border-radius: var(--r-sm);
    border: 1px solid var(--border); background: var(--surface);
    color: var(--text-2); cursor: pointer;
    transition: background .12s, border-color .12s, color .12s;
  }
  .fmt-opt:hover { border-color: var(--border-strong); color: var(--text); }
  .fmt-opt.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
  .b64-size { font-size: 12.5px; color: var(--text-3); margin-bottom: 10px; }
</style>

<script>
  // -----------------------------------------------------------------------
  // Image to Base64 — client-side encoder. Uses FileReader; no libraries.
  // -----------------------------------------------------------------------

  const MAX_SIZE_MB = 10;
  const MAX_SIZE_BYTES = MAX_SIZE_MB * 1024 * 1024;

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

  const states = {
    drop: $('state-drop'),
    selected: $('state-selected'),
    processing: $('state-processing'),
    done: $('state-done'),
    error: $('state-error'),
  };
  function showState(name: keyof typeof states) {
    for (const [k, el] of Object.entries(states)) (el as HTMLElement).hidden = k !== name;
  }

  let file: File | null = null;
  let dataUri = '';

  const dropzone = $('dropzone');
  const fileInput = $<HTMLInputElement>('file-input');
  const browseBtn = $('browse-btn');
  const fileList = $('filelist');
  const convertBtn = $('convert-btn');
  const widgetTitle = $('widget-title');
  const output = $<HTMLTextAreaElement>('b64-output');
  const sizeEl = $('b64-size');
  const copyBtn = $('copy-btn');
  const copyLabel = $('copy-label');
  const fmtToggle = $('fmt-toggle');

  function formatBytes(b: number): string {
    if (b < 1024) return b + ' B';
    if (b < 1024 * 1024) return (b / 1024).toFixed(1) + ' KB';
    return (b / (1024 * 1024)).toFixed(1) + ' MB';
  }
  function escHtml(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  // ---- Drop zone ----
  dropzone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropzone.classList.add('is-drag');
    $('dz-title').textContent = 'Drop to add your image';
  });
  ['dragleave', 'dragend'].forEach((ev) => {
    dropzone.addEventListener(ev, () => {
      dropzone.classList.remove('is-drag');
      $('dz-title').textContent = 'Drag & drop an image';
    });
  });
  dropzone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropzone.classList.remove('is-drag');
    const de = e as DragEvent;
    addFile(Array.from(de.dataTransfer?.files ?? [])[0]);
  });
  dropzone.addEventListener('click', () => fileInput.click());
  dropzone.addEventListener('keydown', (e) => {
    const ke = e as KeyboardEvent;
    if (ke.key === 'Enter' || ke.key === ' ') { e.preventDefault(); fileInput.click(); }
  });
  browseBtn.addEventListener('click', (e) => { e.stopPropagation(); fileInput.click(); });
  fileInput.addEventListener('change', () => {
    addFile((fileInput.files ?? [])[0]);
    fileInput.value = '';
  });

  const IMG_EXT = /\.(png|jpe?g|webp|gif|svg|avif|bmp|ico|tiff?|heic|heif)$/i;

  function addFile(f: File | undefined) {
    if (!f) return;
    const isImage = f.type.startsWith('image/') || IMG_EXT.test(f.name);
    if (!isImage) {
      showError('Unsupported file type', 'Please choose an image file (PNG, JPG, WebP, GIF, SVG…).');
      return;
    }
    if (f.size > MAX_SIZE_BYTES) {
      showError('File too large', `Images must be under ${MAX_SIZE_MB} MB — Base64 is best for small assets.`);
      return;
    }
    file = f;
    renderFile();
    widgetTitle.textContent = 'Image ready';
    showState('selected');
  }

  function renderFile() {
    if (!file) return;
    fileList.innerHTML = '';
    const row = document.createElement('div');
    row.className = 'filerow';
    row.innerHTML = `
      <span class="file-thumb">IMG</span>
      <div class="file-meta">
        <div class="file-name">${escHtml(file.name)}</div>
        <div class="file-sub">${formatBytes(file.size)}</div>
      </div>
      <button class="icon-btn" aria-label="Remove ${escHtml(file.name)}" type="button">
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M5 5l8 8M13 5l-8 8"/></svg>
      </button>
    `;
    row.querySelector('button')!.addEventListener('click', reset);
    fileList.appendChild(row);
  }

  convertBtn.addEventListener('click', () => {
    if (!file) return;
    widgetTitle.textContent = 'Encoding…';
    $('proc-status').textContent = file.name;
    showState('processing');
    const reader = new FileReader();
    reader.onload = () => {
      dataUri = String(reader.result || '');
      setFormat(activeFmt());
      widgetTitle.textContent = 'Base64 ready';
      showState('done');
    };
    reader.onerror = () => showError("Couldn't read that file", 'The image could not be read. Please try a different file.');
    reader.readAsDataURL(file);
  });

  // ---- Output format toggle ----
  type Fmt = 'datauri' | 'raw' | 'css' | 'html';
  function activeFmt(): Fmt {
    return (fmtToggle.querySelector('.fmt-opt.is-active') as HTMLElement)?.dataset.fmt as Fmt || 'datauri';
  }
  function buildOutput(fmt: Fmt): string {
    const raw = dataUri.includes(',') ? dataUri.slice(dataUri.indexOf(',') + 1) : dataUri;
    switch (fmt) {
      case 'raw': return raw;
      case 'css': return `background-image: url("${dataUri}");`;
      case 'html': return `<img src="${dataUri}" alt="" />`;
      default: return dataUri;
    }
  }
  function setFormat(fmt: Fmt) {
    fmtToggle.querySelectorAll('.fmt-opt').forEach((b) => {
      b.classList.toggle('is-active', (b as HTMLElement).dataset.fmt === fmt);
    });
    const text = buildOutput(fmt);
    output.value = text;
    const chars = text.length;
    sizeEl.textContent = `${chars.toLocaleString()} characters · ~${formatBytes(chars)}`;
  }
  fmtToggle.querySelectorAll('.fmt-opt').forEach((b) => {
    b.addEventListener('click', () => setFormat((b as HTMLElement).dataset.fmt as Fmt));
  });

  // ---- Copy ----
  copyBtn.addEventListener('click', async () => {
    const text = output.value;
    let ok = false;
    try {
      await navigator.clipboard.writeText(text);
      ok = true;
    } catch {
      try {
        output.removeAttribute('readonly');
        output.select();
        ok = document.execCommand('copy');
        output.setAttribute('readonly', '');
      } catch { ok = false; }
    }
    copyLabel.textContent = ok ? 'Copied!' : 'Press Ctrl/Cmd+C';
    setTimeout(() => { copyLabel.textContent = 'Copy'; }, 1600);
  });

  // ---- Reset / errors ----
  function reset() {
    file = null; dataUri = '';
    output.value = '';
    widgetTitle.textContent = 'Encode your image';
    showState('drop');
  }
  $('encode-another-btn').addEventListener('click', reset);
  $('try-another-btn').addEventListener('click', reset);

  function showError(title: string, message: string) {
    $('err-title').textContent = title;
    $('err-message').textContent = message;
    widgetTitle.textContent = 'Something went wrong';
    showState('error');
  }
</script>
