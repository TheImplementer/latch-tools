# Cloudflare Pages response headers.
#
# Everything below is content-addressed: Astro fingerprints everything it emits
# into /_astro/, and the model filenames carry their upstream release date, so a
# new version is always a new URL. Pages otherwise serves these
# `max-age=0, must-revalidate`, which means a revalidation round-trip for every
# lazy WASM codec on every visit.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/models/*
  Cache-Control: public, max-age=31536000, immutable
